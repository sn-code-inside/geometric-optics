Cell[BoxData[{
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell1"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"FindRoot", "::", "lstol"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"Part", "::", "partw"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"RowReduce", "::", "luc"}], "]"}], "\[IndentingNewLine]", 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Tracing", "[", 
   RowBox[{
   "rad_", ",", "thick_", ",", "ind_", ",", "costasf_", ",", "stoprad_", ",", 
    "nstop_", ",", "dis_", ",", "dobject_", ",", "hobject_", ",", "angle_", 
    ",", "waves_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
      "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "stoprad", ",", 
       "nstop", ",", "dis", ",", "dobject", ",", "hobject", ",", "angle", ",",
        "waves", ",", "1"}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"div", "=", "10"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "number", " ", "of", " ", "points", " ", "along", " ", "a", " ", 
       "radius", " ", "of", " ", "the", " ", "entrance", " ", "pupil"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"step", "=", "0.01"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "distance", " ", "between", " ", "two", " ", "chosen", " ", "points", 
       " ", "along", " ", "a", " ", "radius", " ", "of", " ", "the", " ", 
       "entrance", " ", "pupil"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\n", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "waves", "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      StyleBox[
       RowBox[{"Ray", " ", "tracing"}],
       FontSize->18,
       FontColor->RGBColor[0, 0, 1]], " ", "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{"Equations", " ", "of", " ", "the", " ", "surfaces"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"spess", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"thick", "[", 
             RowBox[{"[", "h", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"h", ",", "1", ",", "j"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"costasf", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], "\[Equal]", "2"}], ",", 
         RowBox[{
          RowBox[{"Fu", "[", "j", "]"}], "=", 
          RowBox[{
           RowBox[{"spess", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "+", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"2", " ", 
              RowBox[{"rad", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["x", "2"], "+", 
              SuperscriptBox["y", "2"]}], ")"}]}], " ", "+", 
           RowBox[{
            RowBox[{
             RowBox[{"costasf", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"]}], ")"}], "2"]}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{"costasf", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"]}], ")"}], "3"]}]}]}], ",", "\n", 
         RowBox[{
          RowBox[{"rad", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "===", "Infinity"}], ",", 
         RowBox[{
          RowBox[{"Fu", "[", "j", "]"}], "=", 
          RowBox[{"spess", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", 
         RowBox[{
          RowBox[{"rad", "[", 
           RowBox[{"[", "j", "]"}], "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Fu", "[", "j", "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"costasf", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "\[Equal]", 
             RowBox[{"-", "1"}]}], ",", 
            RowBox[{
             RowBox[{"spess", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "+", 
             FractionBox[
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"]}], 
              RowBox[{"2", 
               RowBox[{"rad", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]]}], ",", 
            RowBox[{
             RowBox[{"spess", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "+", 
             FractionBox[
              RowBox[{
               RowBox[{"rad", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "-", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"rad", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "2"], "-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"]}], ")"}], 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"costasf", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]]}], 
              RowBox[{"1", "+", 
               RowBox[{"costasf", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]]}]}], "]"}]}], ",", "\n", 
         RowBox[{
          RowBox[{"rad", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "<", "0"}], ",", "\n", 
         RowBox[{
          RowBox[{"Fu", "[", "j", "]"}], "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"costasf", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "\[Equal]", 
             RowBox[{"-", "1"}]}], ",", 
            RowBox[{
             RowBox[{"spess", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "+", 
             FractionBox[
              RowBox[{
               SuperscriptBox["x", "2"], "+", 
               SuperscriptBox["y", "2"]}], 
              RowBox[{"2", 
               RowBox[{"rad", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]]}], ",", 
            RowBox[{
             RowBox[{"spess", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "+", 
             FractionBox[
              RowBox[{
               RowBox[{"rad", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "+", 
               SqrtBox[
                RowBox[{
                 SuperscriptBox[
                  RowBox[{"rad", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], "2"], "-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    SuperscriptBox["y", "2"]}], ")"}], 
                  RowBox[{"(", 
                   RowBox[{"1", "+", 
                    RowBox[{"costasf", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}]]}], 
              RowBox[{"1", "+", 
               RowBox[{"costasf", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}]]}]}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"derx", "[", "j", "]"}], "=", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Fu", "[", "j", "]"}], ",", "x"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"dery", "[", "j", "]"}], "=", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"Fu", "[", "j", "]"}], ",", "y"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       StyleBox[
