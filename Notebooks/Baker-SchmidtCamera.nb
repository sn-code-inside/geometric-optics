         RowBox[{"1.2`", " ", 
          RowBox[{"(", 
           RowBox[{"12", "-", 
            RowBox[{"8", " ", "\[Gamma]"}], "+", 
            SuperscriptBox["\[Gamma]", "2"]}], ")"}]}]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rad", "=", 
      RowBox[{"{", 
