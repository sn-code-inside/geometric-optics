Cell[CellGroupData[{

Cell["BakerSchmidt program (spherical mirrors)", "Title",
 CellChangeTimes->{{3.4260797181875*^9, 3.426079764109375*^9}, {
  3.426389025828125*^9, 3.4263890353125*^9}, {3.426389108765625*^9, 
  3.42638911734375*^9}},
 Background->RGBColor[
  0.7803921568627451, 0.984313725490196, 
   0.996078431372549],ExpressionUUID->"ae6c0dae-a882-2844-ade9-19b78baaf2e0"],

Cell["\<\
f1 = primary focal;
ind = list of refractive indices corresponding to to the wave-lenghts waves;
obstr = obstruction factor;
\[CapitalDelta] = thickness of corrector;
diam = corrector diameter;
angle= field angle;
\
\>", "Text",
 CellChangeTimes->{{3.469188887132989*^9, 3.469189059851739*^9}, {
  3.469199596554863*^9, 3.469199597711113*^9}, {3.469199967523613*^9, 
  3.4691999893829885`*^9}},
 FontSize->16,ExpressionUUID->"ceb64e6b-c223-6a48-9a73-f4d763fcfb39"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BSspheA", "[", 
   RowBox[{
   "f1_", ",", "ind_", ",", "obstr_", ",", "\[CapitalDelta]_", ",", "diam_", 
    ",", "angle_", ",", "waves_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"\[Gamma]1", ",", "\[Delta]", ",", "ft", ",", "a4"}], "*)"}], 
     "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"1", "-", "obstr"}]}], ";", "\n", 
     RowBox[{"em", "=", 
      FractionBox[
       RowBox[{"f1", " ", 
        RowBox[{"(", 
         RowBox[{"2", "-", 
          RowBox[{"2", " ", "\[Beta]"}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["\[Beta]", "2"]}]}], ")"}]}], 
       RowBox[{"2", " ", "\[Beta]"}]]}], ";", "\n", 
     RowBox[{"a40", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[Beta]", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           SuperscriptBox["\[Beta]", "2"]}], ")"}]}], 
        RowBox[{"32", " ", 
         SuperscriptBox["f1", "3"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "Ni"}], ")"}]}]]}]}], ";", "\n", 
     RowBox[{"\[Delta]0", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"-", "1"}], "-", 
        RowBox[{"3", " ", "\[Beta]"}], "+", 
        SuperscriptBox["\[Beta]", "2"], "+", 
        SuperscriptBox["\[Beta]", "3"]}], 
       RowBox[{"\[Beta]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "2"}], "+", 
          SuperscriptBox["\[Beta]", "2"]}], ")"}]}]]}], ";", "\n", 
     RowBox[{"\[Gamma]1", "=", "2"}], ";", "\n", "\n", 
     RowBox[{"rad", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"10", "^", "11"}], ",", 
        RowBox[{"10", "^", "11"}], ",", 
        RowBox[{
         RowBox[{"-", "2"}], "f1"}], ",", 
        RowBox[{
         RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "}"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "radii", " ", "list"}], " ", "*)"}], "\n", 
     RowBox[{"thick", "=", 
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]", ",", 
        RowBox[{"\[Delta]0", " ", "f1"}], ",", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}]}], ";", 
     "                           ", 
     RowBox[{"(*", " ", 
      RowBox[{"initial", " ", "thicknesses", " ", "list"}], " ", "*)"}], "\n", 
     RowBox[{"costasf", "=", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"a40", ",", "as"}], "}"}], ",", "0", ",", "0"}], "}"}]}], 
     ";", "\n", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{"rad", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]0", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       "costasf", ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}],
       "]"}], ";", "\n", 
     RowBox[{"sf51", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co51", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{"rad", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]0", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       "costasf", ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}],
       "]"}], ";", "\n", 
     RowBox[{"margcr", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"1", "/", "c"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"a4", ",", "as"}], "}"}], ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", "1.2"}], "sf51"}]}], ",", " ", 
          RowBox[{
           RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", 
           RowBox[{"-", "co51"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"zog1", "[", 
             RowBox[{"2", ",", "n"}], "]"}], "-", 
            RowBox[{"zog1", "[", 
             RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", "0.9"}], "margcr"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"a4", ",", "a40"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Delta]", ",", "\[Delta]0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c", ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}]}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
         "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"asf3", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"co3", "=", 
      RowBox[{"Comatot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"ast3", "=", 
      RowBox[{"Asttot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"cur3", "=", 
      RowBox[{"Curvtot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"axcr", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
         "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}],
       "]"}], ";", "\n", 
     RowBox[{"sf53", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co53", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{
          RowBox[{"sol", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sol", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
         "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}],
       "]"}], ";", "\n", 
     RowBox[{"margcr2", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of corrector = \>\"", ",", 
       RowBox[{"1", "/", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Aspheric constant of corrector = \>\"", ",", 
       RowBox[{"sol", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of primary mirror = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "f1"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of secondary mirror = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"-", "\[Gamma]1"}], " ", "f1"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance of primary mirror from corrector = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], " ", "f1"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Distance between mirrors = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<**********\>\"", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total focal = \>\"", ",", " ", 
       RowBox[{"foc", "[", "1", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Emersion distance = \>\"", ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"zog1", "[", 
          RowBox[{"1", ",", "n"}], "]"}], "-", 
         RowBox[{"\[Beta]", " ", "f1"}]}], ")"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Height of image = \>\"", ",", " ", 
       RowBox[{"hobj1", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", "\"\<Aberrations\>\"", "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order spherical aberration = \>\"", " ", ",", " ", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order coma = \>\"", " ", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order astigmatism = \>\"", " ", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order curvature = \>\"", " ", ",", 
       RowBox[{"Curvtot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Fifth-order spherical aberration = \>\"", " ", ",", "sf53"}], 
      "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fifth-order coma = \>\"", " ", ",", "co53"}], "]"}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Axial chromatism = \>\"", " ", ",", "axcr"}], "]"}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Marginal chromatism = \>\"", " ", ",", "margcr2"}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
