Cell["BakerSchmidt camera with a conic secondary mirror(II caso)", "Title",
 CellChangeTimes->{{3.4260797181875*^9, 3.426079764109375*^9}, {
  3.426389025828125*^9, 3.4263890353125*^9}, {3.432380874359375*^9, 
