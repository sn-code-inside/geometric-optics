           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
