         RowBox[{"-", "\[Gamma]"}], " ", "f1"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]0", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"a40", ",", "as"}], "}"}], ",", "0", ",", "K20"}], "}"}], 
       ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{"rad", ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]0", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"a40", ",", "as"}], "}"}], ",", "0", ",", "K20"}], "}"}], 
       ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}]}],
       "]"}], ";", "\n", 
     RowBox[{"margcr", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"1", "/", "c"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Gamma]"}], " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", 
         RowBox[{"\[Delta]0", " ", "f1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"a4", ",", "as"}], "}"}], ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"FindRoot", "[", 
