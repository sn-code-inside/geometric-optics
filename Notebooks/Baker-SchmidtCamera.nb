Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"-", "\[Gamma]f"}], " ", "is", " ", "the", " ", "curvature", " ", 
    "radius", " ", "of", " ", "secondary", " ", "mirror"}], ",", " ", 
   RowBox[{"obst", "=", 
    RowBox[{"1", "-", 
     RowBox[{"\[Beta]", " ", "the", " ", "obstruction", " ", "factor"}]}]}], 
   ",", " ", 
   RowBox[{
    RowBox[{
    "\[CapitalDelta]", " ", "is", " ", "the", " ", "thickness", " ", "of", 
     " ", 
     RowBox[{"corrector", ".", " ", "In"}], " ", "order", " ", "to", " ", 
     "have", " ", "a", " ", "positive", " ", "emersion", " ", "distance", " ",
      "1"}], "<", "\[Gamma]", "<", 
    RowBox[{"2.4", "."}]}]}], "  ", "*)"}]], "Input",
 CellChangeTimes->{{3.453639177296875*^9, 3.4536392609375*^9}, {
  3.45368643115625*^9, 3.45368643590625*^9}, {3.469187672984375*^9, 
  3.4691877005625*^9}, {3.469199623367363*^9, 3.4691996591642385`*^9}, {
  3.469200014429863*^9, 3.4692000221954885`*^9}, {3.469202345164238*^9, 
  3.469202386242363*^9}, {3.469202418570488*^9, 
  3.469202424773613*^9}},ExpressionUUID->"6b7c7417-dbbf-0e41-9675-\
97a38624ec4a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BSchmidtConic", "[", 
   RowBox[{
   "f1_", ",", "ind_", ",", "\[Gamma]_", ",", "obst_", ",", "diam_", ",", 
    "angle_", ",", "\[CapitalDelta]_", ",", "\[Mu]sf_", ",", "\[Mu]co_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"ftot", ",", "bf", ",", "a40", ",", "K20"}], "*)"}], "}"}], ",",
     "\n", 
    RowBox[{
     RowBox[{"\[Beta]", "=", 
      RowBox[{"1", "-", "obst"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Total", " ", "focal", " ", "length"}], ",", " ", 
       RowBox[{
       "back", " ", "focal", " ", "and", " ", "distance", " ", "between", " ",
         "the", " ", "corrector", " ", "and", " ", "the", " ", "primary", " ",
         "mirror"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ftot", "=", 
      RowBox[{
       FractionBox["\[Gamma]", 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "f1"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "total", " ", "focal", " ", "length"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"bf", "=", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", 
          SuperscriptBox["\[Beta]", "2"]}], "-", 
         RowBox[{"2", " ", "\[Beta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}]}], "+", "\[Gamma]"}], 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "f1"}]}], ";", 
     " ", 
     RowBox[{"(*", 
      RowBox[{"the", " ", "emersion", " ", "distance"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Delta]0", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}], 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "the", " ", "condition", " ", "to", " ", "have", " ", "flat", " ", 
       "field"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Spherical", " ", "aberration", " ", "and", " ", "coma", " ", 
       "coefficients"}], " ", "*)"}], "\n", 
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a40", "=", 
      RowBox[{"-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"32", " ", 
          SuperscriptBox["f1", "3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
          SuperscriptBox["\[Gamma]", "3"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"16", " ", 
           SuperscriptBox["\[Beta]", "4"]}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox[
