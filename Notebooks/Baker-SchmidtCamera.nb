Cell[CellGroupData[{

Cell["\<\
A third-order analysis of the Baker-Schmidt camera with a conic primary and a \
spherical secondary mirror\
\>", "Title",
 CellChangeTimes->{{3.42552662778125*^9, 3.425526630484375*^9}, {
   3.42552674925*^9, 3.42552676553125*^9}, {3.42572902409375*^9, 
   3.4257290340625*^9}, {3.425729067671875*^9, 3.425729074640625*^9}, {
   3.4259645994375*^9, 3.42596460678125*^9}, 3.426058454390625*^9, {
   3.426129124015625*^9, 3.42612914425*^9}, {3.426389135921875*^9, 
   3.426389143703125*^9}, {3.43238027928125*^9, 3.43238027959375*^9}, {
   3.432380999375*^9, 3.432381008625*^9}},
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"92ca10cc-cd43-694f-be8c-1d784bf5bf5e"],

Cell[TextData[{
 "We start with a Schmidt-Cassegrain combination, in which the secondary is \
conic.  The distance between the primary and secondary mirror is \[Dash] \
\[Beta]f, \[Beta] > 0. Consequently, (1\[Dash] \[Beta]) denotes the \
obstruction factor of primary, which should be less or equal to 0.4, if the \
combination is used for photographic applications; then, 0 \[LessEqual] \
\[Beta] \[LessEqual] 0.6. The curvature radius of the secondary mirror is \
\[Dash] \[Gamma] f, where \[Gamma] > 0 could be chosen in such a way that the \
focal plane is located outside the combination, behind the primary. ",
 StyleBox["Finally, \[Dash] \[Delta] f, \[Delta] > 0, is the distance of the \
aperture stop from the primary mirror. We have to determine the constants \
\[Beta], \[Gamma], \[Delta], K2, where K2 is the conic constant of the \
secondary mirror, and the aspheric coefficients a4 of the Schmidt corrector.  \
The radius Rc of the second surface of the corrector controls the residual \
chromatic aberration. The main requests are: flat field and anastigmatism. We \
assume that the aperture stop is at the corrector.",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.426069078078125*^9, 3.426069097546875*^9}, {
   3.4261281309375*^9, 3.426128141875*^9}, {3.426611940828125*^9, 
   3.426611986703125*^9}, 3.432384424921875*^9, {3.432384546625*^9, 
   3.43238486159375*^9}, {3.43238491928125*^9, 3.432384936484375*^9}, {
   3.43238568025*^9, 3.43238573584375*^9}, {3.432385800703125*^9, 
   3.43238590096875*^9}, {3.43238602534375*^9, 3.43238606934375*^9}, {
   3.432386602703125*^9, 3.432386604875*^9}, {3.43239325715625*^9, 
   3.43239334565625*^9}, {3.432433165640625*^9, 3.43243326421875*^9}, {
   3.432437959515625*^9, 3.432437988921875*^9}, {3.43243947740625*^9, 
   3.432439477609375*^9}, {3.432448610234375*^9, 3.43244876553125*^9}, {
   3.453639036328125*^9, 3.45363906259375*^9}},
 FontSize->18,ExpressionUUID->"805020f2-cc4a-534a-b496-91430e94b95d"],

Cell[CellGroupData[{

Cell["\<\
First case: the primary mirror is spherical and the secondary is conic 
\
\>", "Section",
 CellChangeTimes->{{3.432439412359375*^9, 
  3.432439465453125*^9}},ExpressionUUID->"f0f13885-e6f9-634b-8706-\
c3fb38e8902f"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rad", "=", 
     RowBox[{"{", 
      RowBox[{"Infinity", ",", "Infinity", ",", 
       RowBox[{
        RowBox[{"-", "2"}], "f1"}], ",", 
       RowBox[{
        RowBox[{"-", "\[Gamma]"}], " ", "f1"}]}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"thick", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"\[Delta]", " ", "f1"}], ",", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "Ni", ",", "1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "Nb", ",", "1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "Nr", ",", "1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"costasf", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"{", 
        RowBox[{"a4", ",", "as"}], "}"}], ",", "0", ",", "K2"}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{"TotalAberrations", "[", 
    RowBox[{
    "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
     "0", ",", 
     RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
     ",", "2"}], "]"}]}]}]], "Input",
