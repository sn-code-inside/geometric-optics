Cell[BoxData[
 RowBox[{
  RowBox[{"BSchmidtConic", "[", 
   RowBox[{
   "f1_", ",", "ind_", ",", "\[Gamma]_", ",", "obst_", ",", "diam_", ",", 
    "angle_", ",", "\[CapitalDelta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"ftot", ",", "bf", ",", "a40", ",", "K20"}], "*)"}], "}"}], ",",
     "\n", 
    RowBox[{
     RowBox[{"\[Beta]", "=", 
      RowBox[{"1", "-", "obst"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Total", " ", "focal", " ", "length"}], ",", " ", 
       RowBox[{
       "back", " ", "focal", " ", "and", " ", "distance", " ", "between", " ",
         "the", " ", "corrector", " ", "and", " ", "the", " ", "primary", " ",
         "mirror"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ftot", "=", 
      RowBox[{
       FractionBox["\[Gamma]", 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "f1"}]}], ";", 
     " ", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "total", " ", "focal", " ", "length"}], " ", "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"bf", "=", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            SuperscriptBox["\[Beta]", "2"]}], "-", 
           RowBox[{"2", " ", "\[Beta]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Gamma]"}], ")"}]}], "+", 
           "\[Gamma]"}], 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]], "f1"}]}], ";"}],
       " ", 
      RowBox[{"(*", 
       RowBox[{"the", " ", "emersion", " ", "distance"}], " ", "*)"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"\[Delta]0", "=", 
      FractionBox[
       RowBox[{
        RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}], 
       RowBox[{
        RowBox[{"-", "2"}], "+", 
        RowBox[{"2", " ", "\[Beta]"}], "+", "\[Gamma]"}]]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "the", " ", "condition", " ", "to", " ", "have", " ", "flat", " ", 
       "field"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Spherical", " ", "aberration", " ", "and", " ", "coma", " ", 
       "coefficients"}], " ", "*)"}], "\n", 
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a40", "=", 
      RowBox[{"-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"32", " ", 
          SuperscriptBox["f1", "3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
          SuperscriptBox["\[Gamma]", "3"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"16", " ", 
           SuperscriptBox["\[Beta]", "4"]}], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "+", "\[Gamma]"}], ")"}], "3"]}], "+", 
          RowBox[{"8", " ", 
           SuperscriptBox["\[Beta]", "3"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "8"}], "+", 
             RowBox[{"3", " ", "\[Gamma]"}]}], ")"}]}], "+", 
          RowBox[{"2", " ", 
           SuperscriptBox["\[Beta]", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"48", "-", 
             RowBox[{"36", " ", "\[Gamma]"}], "+", 
             RowBox[{"5", " ", 
              SuperscriptBox["\[Gamma]", "2"]}]}], ")"}]}], "+", 
          RowBox[{"\[Beta]", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "64"}], "+", 
             RowBox[{"72", " ", "\[Gamma]"}], "-", 
             RowBox[{"22", " ", 
              SuperscriptBox["\[Gamma]", "2"]}], "+", 
             SuperscriptBox["\[Gamma]", "3"]}], ")"}]}]}], ")"}]}]}]}], ";", 
     RowBox[{"K20", "=", 
      RowBox[{
       RowBox[{"-", "1.953125"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "6.272`"}], "+", 
         RowBox[{"2.88`", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "3"}], "+", "\[Gamma]"}], ")"}]}], "+", 
         RowBox[{"8", " ", "\[Gamma]"}], "-", 
         RowBox[{"4", " ", 
          SuperscriptBox["\[Gamma]", "2"]}], "+", 
