Cell[CellGroupData[{
Cell[TextData[StyleBox["Input data",
 FontFamily->"Times New Roman",
 FontSize->36]], "Title",
 CellChangeTimes->{{3.3954035388125*^9, 3.395403545078125*^9}, 
   3.395453747421875*^9, {3.413775772326984*^9, 3.413775772514484*^9}, {
   3.426330629203125*^9, 3.42633063321875*^9}},
 TextAlignment->Center,
 FontFamily->"Times New Roman",
 Background->RGBColor[
  0.8117647058823529, 0.8117647058823529, 
   0.8117647058823529],ExpressionUUID->"ff227e29-b45e-a04e-83c1-b54ea72de924"],

Cell["\<\
The input data of this program are:
rad  = list of the radii of the surfaces;
thick = list of the distances between the surfaces;
ind = list of the refractive indices;
costasf = list of the constant which characterize the nature of any surface \
(0 for a sphere, K for a conic, {a4,as} for an  aspheric surface)
stoprad = radius of the aperture stop;
nstop = number of the surfaces before the stop;
dis = if nstop=0, then it is the distance of the aperture stop from the first \
surface; if nstop>0, then dis is the positive distance from the last surface \
before the stop.
dobject = negative distance of the object from the first surface;
hobject = height of the object (only if it is at a finite distance );
angle = view angle in degrees (if the object is at infinity);
waves = the wave-length corresponding to the chosen refractive indices;
option1 = 0, 1, 2. If option1 =0, then the program gives the aberration \
coefficients; if option = 1, then the program gives the total third-order \
aberrations, if option = 2, the program evaluates all the data but does not \
give output;
\
\>", "Text",
 CellChangeTimes->{{3.426330650796875*^9, 3.4263310476875*^9}, {
   3.426331088984375*^9, 3.426331212078125*^9}, {3.426483483296875*^9, 
   3.4264834881875*^9}, {3.42717974878125*^9, 3.427179816125*^9}, 
   3.427180945671875*^9, {3.43720314203125*^9, 3.437203252015625*^9}, {
   3.437360491921875*^9, 3.437360518328125*^9}, {3.43736055596875*^9, 
   3.437360582359375*^9}, {3.437450521421875*^9, 3.43745052940625*^9}, {
   3.456060770625*^9, 3.456060794328125*^9}, {3.456060825140625*^9, 
   3.45606083778125*^9}},
 FontFamily->"Times New Roman",
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"e4fa7537-50b9-2848-b2b2-4d3de5f8248c"]
}, Open  ]],

