Cell[TextData[StyleBox["Total Aberrations",
 FontFamily->"Times New Roman",
 FontSize->36]], "Title",
 CellChangeTimes->{{3.3954035388125*^9, 3.395403545078125*^9}, 
   3.395453747421875*^9, {3.413775772326984*^9, 3.413775772514484*^9}, {
   3.427167864859375*^9, 3.42716786665625*^9}, {3.4271898801875*^9, 
   3.427189882828125*^9}, 3.431768757421875*^9},
 TextAlignment->Center,
