   0.7333333333333333],ExpressionUUID->"3af24b07-89fa-b745-b635-41501fc7429c"],

Cell[BoxData[{
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell1"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"\[Infinity]", "::", "indet"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"Power", "::", "infy"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"Simplify", "::", "infd"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TotalAberrations", "[", 
   RowBox[{
   "rad_", ",", "thick_", ",", "ind_", ",", "costasf_", ",", "stoprad_", ",", 
    "nstop_", ",", "dis_", ",", "dobject_", ",", "hobject_", ",", "angle_", 
    ",", "waves_", ",", "option1_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "number", " ", "of", " ", "surfaces", " ", "and", " ", "wave", " ", 
      "lengths"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\n", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "waves", "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Distances", " ", "among", " ", "the", " ", "surfaces"}], " ", 
      "*)"}], "\n", 
     RowBox[{"thicke", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"thick", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"nstop", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"thicke1", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"thicke", ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"rade", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"rad", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "nstop"}], "}"}]}], "]"}], "]"}]}], "//", 
       "Flatten"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Images", " ", "of", " ", "the", " ", "aperture", " ", "stop", " ", 
       "supplied", " ", "by", " ", "the", " ", "surfaces", " ", "preceeding", 
       " ", "the", " ", 
       RowBox[{"stop", ":", "\n", 
        RowBox[{
        "the", " ", "last", " ", "one", " ", "is", " ", "the", " ", 
         "entrance", " ", 
         RowBox[{"pupil", "."}]}]}]}], " ", "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"inde", "[", "h", "]"}], "=", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Take", "[", 
          RowBox[{
           RowBox[{"ind", "[", 
            RowBox[{"[", "h", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"nstop", "+", "1"}]}], "}"}]}], "]"}], "]"}]}], ",", 
       "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", "\n", 
     "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"ze", "[", 
         RowBox[{"h", ",", "1"}], "]"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nstop", "===", "0"}], ",", "dis", ",", 
          RowBox[{"-", "dis"}]}], "]"}]}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{"Do", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Qe", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], 
             RowBox[{"ze", "[", 
              RowBox[{"h", ",", "i"}], "]"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], 
             RowBox[{"rade", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], 
             RowBox[{"w1", "[", 
              RowBox[{"h", ",", "i"}], "]"}]], "+", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], 
             RowBox[{"rade", "[", 
              RowBox[{"[", "i", "]"}], "]"}]]}]}], ";", "\n", 
          RowBox[{
           RowBox[{"ze1", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ze", "[", 
               RowBox[{"h", ",", "i"}], "]"}], "===", "0"}], ",", 
             RowBox[{"ze", "[", 
              RowBox[{"h", ",", "i"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "===", 
               RowBox[{"-", "Infinity"}]}], "&&", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"rad", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "]"}], "===", "Infinity"}]}],
              ",", 
             RowBox[{"-", "Infinity"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", 
               RowBox[{"-", "Infinity"}]}], "&&", 
              RowBox[{
               RowBox[{"Simplify", "[", 
                RowBox[{"Numerator", "[", 
                 RowBox[{"Together", "[", 
                  RowBox[{
                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"ze", "[", 
                    RowBox[{"h", ",", "i"}], "]"}]], "-", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "+", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], 
                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]]}], "]"}], "]"}], "]"}], "===",
                "0"}]}], ",", 
             RowBox[{"-", "Infinity"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", 
               RowBox[{"-", "Infinity"}]}], "||", 
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "===", 
               RowBox[{"-", "Infinity"}]}]}], ",", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Qe", "[", 
                  RowBox[{"h", ",", "i"}], "]"}], "\[Equal]", "0"}], ",", 
                RowBox[{"w1", "[", 
                 RowBox[{"h", ",", "i"}], "]"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], 
          ";", " ", 
          RowBox[{
           RowBox[{"ze", "[", 
            RowBox[{"h", ",", 
             RowBox[{"i", "+", "1"}]}], "]"}], "=", 
           RowBox[{
            RowBox[{"ze1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "-", 
            RowBox[{"thicke1", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}]}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nstop"}], "}"}]}], "]"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"de", "[", "h", "]"}], "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"nstop", "===", "0"}], ",", "dis", ",", 
          RowBox[{"nstop", "=!=", "0"}], ",", 
          RowBox[{"-", 
           RowBox[{"ze1", "[", 
            RowBox[{"h", ",", "nstop"}], "]"}]}]}], "]"}]}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Distance of entrance pupil from the first surface for \[Lambda] \
= \>\"", ",", 
         RowBox[{"waves", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(w\), \(e\)]\) = \>\"", ",", " ", 
         RowBox[{"de", "[", "1", "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"//", "Simplify"}], "*)"}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ye", "[", 
          RowBox[{"h", ",", "1"}], "]"}], "=", "stoprad"}], ";", "\n", 
        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ye1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", "0"}], ",", 
              RowBox[{
               FractionBox[
                RowBox[{
                 RowBox[{
                  RowBox[{"inde", "[", "h", "]"}], "[", 
                  RowBox[{"[", "i", "]"}], "]"}], " ", 
                 RowBox[{"ze1", "[", 
                  RowBox[{"h", ",", "i"}], "]"}]}], 
                RowBox[{
                 RowBox[{
                  RowBox[{"inde", "[", "h", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], " ", 
                 RowBox[{"ze", "[", 
                  RowBox[{"h", ",", "i"}], "]"}]}]], 
               RowBox[{"ye", "[", 
                RowBox[{"h", ",", "i"}], "]"}]}], ",", 
              RowBox[{"ye", "[", 
               RowBox[{"h", ",", "i"}], "]"}]}], "]"}]}], ";", "\n", 
           RowBox[{
            RowBox[{"ye", "[", 
             RowBox[{"h", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "=", 
            RowBox[{"ye1", "[", 
             RowBox[{"h", ",", "i"}], "]"}]}]}], ",", "\n", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "nstop"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{
         RowBox[{"diame", "[", "h", "]"}], "=", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"nstop", "===", "0"}], ",", "stoprad", ",", 
           RowBox[{"nstop", "=!=", "0"}], ",", 
           RowBox[{"ye1", "[", 
            RowBox[{"h", ",", "nstop"}], "]"}]}], "]"}]}]}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Radius of entrance pupil for \[Lambda] = \>\"", ",", 
         RowBox[{"waves", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(r\), \(en\)]\) = \>\"", ",", 
         RowBox[{"diame", "[", "1", "]"}]}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Evaluation", " ", "of", " ", "exit", " ", "pupil"}], " ", 
      "*)"}], "\n", 
     RowBox[{"thick2", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"thick", ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"zee", "[", 
          RowBox[{"h", ",", "1"}], "]"}], "=", 
         RowBox[{"de", "[", "h", "]"}]}], ";", "\n", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"zee1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "=", 
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"zee", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "===", "0"}], ",", "0", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"zee", "[", 
                 RowBox[{"h", ",", "i"}], "]"}], "===", 
                RowBox[{"-", "Infinity"}]}], "&&", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"rad", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}], "===", 
                "Infinity"}]}], ",", 
              RowBox[{"-", "Infinity"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"zee", "[", 
                 RowBox[{"h", ",", "i"}], "]"}], "=!=", 
                RowBox[{"-", "Infinity"}]}], "&&", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"ind", "[", 
                   RowBox[{"[", 
                    RowBox[{"h", ",", "i"}], "]"}], "]"}], 
                  RowBox[{"zee", "[", 
                   RowBox[{"h", ",", "i"}], "]"}]], "-", 
                 FractionBox[
                  RowBox[{"ind", "[", 
                   RowBox[{"[", 
                    RowBox[{"h", ",", "i"}], "]"}], "]"}], 
                  RowBox[{"rad", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]], "+", 
                 FractionBox[
                  RowBox[{"ind", "[", 
                   RowBox[{"[", 
                    RowBox[{"h", ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], "]"}], 
                  RowBox[{"rad", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]]}], "===", "0"}]}], ",", 
              RowBox[{"-", "Infinity"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"zee", "[", 
                 RowBox[{"h", ",", "i"}], "]"}], "=!=", 
                RowBox[{"-", "Infinity"}]}], "||", 
               RowBox[{
                RowBox[{"zee", "[", 
                 RowBox[{"h", ",", "i"}], "]"}], "===", 
                RowBox[{"-", "Infinity"}]}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Solve", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Numerator", "[", 
                    RowBox[{"Together", "[", 
                    RowBox[{
                    FractionBox[
                    RowBox[{"ind", "[", 
                    RowBox[{"[", 
                    RowBox[{"h", ",", "i"}], "]"}], "]"}], 
                    RowBox[{"zee", "[", 
                    RowBox[{"h", ",", "i"}], "]"}]], "-", 
                    FractionBox[
                    RowBox[{"ind", "[", 
                    RowBox[{"[", 
                    RowBox[{"h", ",", "i"}], "]"}], "]"}], 
                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "-", 
                    FractionBox[
                    RowBox[{"ind", "[", 
                    RowBox[{"[", 
                    RowBox[{"h", ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], "]"}], 
                    RowBox[{"fe1", "[", 
                    RowBox[{"h", ",", "i"}], "]"}]], "+", 
                    FractionBox[
                    RowBox[{"ind", "[", 
                    RowBox[{"[", 
                    RowBox[{"h", ",", 
                    RowBox[{"i", "+", "1"}]}], "]"}], "]"}], 
                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]]}], "]"}], "]"}], 
                   "\[Equal]", "0"}], ",", 
                  RowBox[{"fe1", "[", 
                   RowBox[{"h", ",", "i"}], "]"}]}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}]}], ";", 
           RowBox[{
            RowBox[{"zee", "[", 
             RowBox[{"h", ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "=", 
            RowBox[{
             RowBox[{"zee1", "[", 
              RowBox[{"h", ",", "i"}], "]"}], "-", 
             RowBox[{"thick2", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}]}], ",", "\n", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Distance of the exit pupil from the last surface for \[Lambda] = \
\>\"", ",", 
         RowBox[{"waves", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(w\), \(e, n\)]\) = \>\"", ",", 
         RowBox[{"zee1", "[", 
          RowBox[{"1", ",", "n"}], "]"}]}], 
        RowBox[{"(*", 
         RowBox[{"//", "Simplify"}], "*)"}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"yee", "[", 
          RowBox[{"h", ",", "1"}], "]"}], "=", 
         RowBox[{"diame", "[", "h", "]"}]}], ";", "\n", 
        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"yee1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "=", 
            RowBox[{"Which", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"zee", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", "0"}], ",", 
              RowBox[{
               FractionBox[
                RowBox[{
