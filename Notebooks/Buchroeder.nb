Cell[CellGroupData[{

Cell["The program BCamera (Buchroeder) ", "Title",
 CellChangeTimes->{{3.42552662778125*^9, 3.425526630484375*^9}},
 TextAlignment->Center,
 FontFamily->"Times New Roman",
 Background->GrayLevel[
  0.752941],ExpressionUUID->"4e293b0f-3ea1-9249-a319-4cd9893b3bb7"],

Cell["\<\
In this design the corrector is formed by three thin lenses placed at the \
center of curvature of the primary mirror. Consequently, the camera is as \
long as the corresponding Schmidt's camera. The three lenses are made with \
the same glass, for instance, with BK7. Moreover, the radii of curvature of \
the surfaces of the lenses verify the conditions:
R2 = Infinity, R3 = \[Dash] R1, R4 = R1, R5 = Infinity, R6 = \[Dash] R1. \
Consequently, only the curvature radius R1 is free and it is chosen to \
eliminate the spherical aberration. The corrector is afocal and the \
astigmatism and coma vanish when the lenses have no thickness. \
\>", "Text",
 CellChangeTimes->{{3.425523537234375*^9, 3.425523576859375*^9}, {
   3.437483082546875*^9, 3.437483104140625*^9}, 3.4374831393125*^9, {
   3.43865891740625*^9, 3.43865901709375*^9}, {3.4386595325625*^9, 
   3.438659554125*^9}, {3.43865960203125*^9, 3.438659610765625*^9}, {
   3.43892839534375*^9, 3.438928408390625*^9}, {3.45628481878125*^9, 
   3.456284819703125*^9}},
 FontSize->18,
 Background->RGBColor[
  0.768627, 0.976471, 
   1],ExpressionUUID->"c05eba97-1595-d747-acbf-ecf4de9b600f"],

Cell[TextData[StyleBox["In order to find the aberration coefficients of the \
corrector, which is afocal, we evaluate its spherical aberration coefficient. \
",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.4255237369375*^9, 3.4255237823125*^9}, {3.4374836805*^9,
    3.43748376421875*^9}, {3.437483936140625*^9, 3.437483973453125*^9}, {
   3.4386598150625*^9, 3.43865985728125*^9}, {3.438659902953125*^9, 
   3.438659947296875*^9}, 3.438747722921875*^9, 
   3.456060937984375*^9},ExpressionUUID->"29bc5ebd-ecc0-e943-bb84-\
f8f8f1c4288f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rad", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "c1"}], ",", "Infinity", ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "c1"}], ",", 
      RowBox[{"1", "/", "c1"}], ",", "Infinity", ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "c1"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ind", "=", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
      "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1"}], 
      "}"}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
   "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
   RowBox[{"{", "\[Lambda]", "}"}], ",", "0"}], "]"}]}], "Input",
 CellChangeTimes->{{3.42552361134375*^9, 3.425523633953125*^9}, {
   3.425523670265625*^9, 3.425523712671875*^9}, 3.425524065125*^9, 
   3.43748320403125*^9, 
   3.438659758078125*^9},ExpressionUUID->"b43c340e-55e5-ab4d-9214-\
e7a70b9a5f6c"],

Cell[TextData[StyleBox["Then, the spherical coefficient of the corrector is",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.4255237369375*^9, 3.4255237823125*^9}, {3.4374836805*^9,
   3.43748376421875*^9}, {3.437483936140625*^9, 
  3.43748402825*^9}},ExpressionUUID->"4cce918a-2bec-2347-bc41-d2cbaaebaa20"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DS1", "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["c1", "3"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "Ni"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "Ni"}], ")"}]}], 
     RowBox[{"2", " ", "Ni"}]]}], ";"}], "\n"}]], "Input",
 CellChangeTimes->{{3.425524284828125*^9, 
  3.4255242925*^9}},ExpressionUUID->"2a554a33-9106-1346-8bbf-e6c640840833"],

Cell[TextData[StyleBox["To balance the spherical aberration of the corrector \
with the spherical aberration of the primary mirror, we must solve the \
equation",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.4255237369375*^9, 3.4255237823125*^9}, {
  3.4255243268125*^9, 3.425524350390625*^9}, {3.43748350165625*^9, 
  3.437483517328125*^9}, {3.437484045484375*^9, 3.437484053953125*^9}, {
  3.438661021453125*^9, 
  3.43866104559375*^9}},ExpressionUUID->"bf05e925-2415-5845-9064-\
3559965655db"],

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"DS1", "-", 
      FractionBox["1", 
       RowBox[{"32", 
        SuperscriptBox["f", "3"]}]]}], "\[Equal]", "0"}], ",", "c1"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.43866076815625*^9, 
  3.43866076990625*^9}},ExpressionUUID->"41518a3a-dede-f24b-9822-\
6d0fc9892465"],

Cell[TextData[StyleBox["Only the second root is real .",
 FontSize->18]], "Text",
 CellChangeTimes->{{3.4255237369375*^9, 3.4255237823125*^9}, {
   3.4255243268125*^9, 3.425524350390625*^9}, {3.425524453796875*^9, 
   3.425524460109375*^9}, {3.43748355309375*^9, 3.4374835885625*^9}, 
   3.438660954609375*^9, 
   3.43866114578125*^9},ExpressionUUID->"f43d8f90-ca9f-194a-89e0-\
79a6931397cb"],

Cell["\<\
The program requires the following input data:
f = focal length of the primary mirror;
spes = list of thicknesses of the lenses;
diam = diameter of primary mirror;
\[Theta] = field angle in degrees.\
\>", "Text",
 CellChangeTimes->{{3.425523537234375*^9, 3.425523576859375*^9}, {
   3.437483082546875*^9, 3.437483104140625*^9}, 3.4374831393125*^9, {
   3.43865891740625*^9, 3.43865901709375*^9}, {3.4386595325625*^9, 
   3.438659554125*^9}, {3.43865960203125*^9, 3.438659610765625*^9}, {
   3.43866118284375*^9, 3.438661286359375*^9}, 3.438747741*^9},
 FontSize->18,
 Background->RGBColor[
  0.768627, 0.976471, 
   1],ExpressionUUID->"3bd5964d-f2e3-f54f-96ba-0383c22a16c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BCamera", "[", 
   RowBox[{"f_", ",", "spes_", ",", "diam_", ",", "Ni_", ",", "\[Theta]_"}], 
   "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Primary radius = \>\"", ",", " ", 
       RowBox[{
        RowBox[{"-", "2"}], "f"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Distance between primary and corrector = \>\"", ",", 
       RowBox[{"2", " ", "f"}]}], " ", "]"}], ";", "\n", 
     RowBox[{"DS1", "=", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"32", " ", 
         SuperscriptBox["f", "3"], " "}]]}]}], ";", "\n", 
     RowBox[{"R10", "=", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["2", 
         RowBox[{"1", "/", "3"}]], " ", "f", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "Ni"}], ")"}], 
         RowBox[{"2", "/", "3"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "Ni"}], ")"}], 
         RowBox[{"1", "/", "3"}]]}], 
       SuperscriptBox["Ni", 
        RowBox[{"1", "/", "3"}]]]}], ";", "\n", "\n", 
     RowBox[{"thick1", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"spes", ",", 
        RowBox[{"{", 
         RowBox[{"2", " ", "f"}], "}"}]}], "]"}]}], ";", "\n", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Elimination", " ", "of", " ", "spherical", " ", "aberrations", " ", 
       "for", " ", "thick", " ", "lenses"}], " ", "*)"}], "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R1", ",", "Infinity", ",", 
         RowBox[{"-", "R1"}], ",", "R1", ",", "Infinity", ",", 
         RowBox[{"-", "R1"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick1", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
         "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1", 
          ",", 
          RowBox[{"-", "1"}]}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
       RowBox[{"{", "\[Lambda]", "}"}], ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"sol", "=", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
         RowBox[{"{", 
          RowBox[{"R1", ",", "R10"}], "}"}], ",", 
         RowBox[{"AccuracyGoal", "\[Rule]", "4"}]}], "]"}], "//", 
       "Flatten"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "\"\<The radii of the triplet are:\>\"", "]"}], 
     ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r1 = \>\"", ",", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r2 = \>\"", ",", " ", "\"\<\[Infinity]\>\""}], "]"}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r3 = \>\"", ",", 
       RowBox[{"-", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r4 = \>\"", ",", 
       RowBox[{"sol", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r5 = \>\"", ",", " ", "\"\<\[Infinity] \>\""}], "]"}], ";",
      "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r6 = \>\"", ",", 
       RowBox[{"-", 
        RowBox[{"sol", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", "\n", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Height of the object = \>\"", ",", 
       RowBox[{
        RowBox[{"hobj1", "[", 
         RowBox[{"1", ",", "n"}], "]"}], "/.", "sol"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Focal length = \>\"", ",", 
       RowBox[{
        RowBox[{"foc", "[", "1", "]"}], "/.", "sol"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total spherical aberration = \>\"", ",", 
       RowBox[{
        RowBox[{"Absftot", "[", "1", "]"}], "/.", "sol"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total sagittal Coma = \>\"", ",", 
       RowBox[{
        RowBox[{"Comatot", "[", "1", "]"}], "/.", "sol"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total astigmatism = \>\"", ",", 
       RowBox[{
        RowBox[{"Asttot", "[", "1", "]"}], "/.", "sol"}]}], "]"}], ";"}]}], 
   "\n", "\[IndentingNewLine]", "\n", "]"}]}]], "Input",
 CellChangeTimes->{{3.394619929140625*^9, 3.394619930921875*^9}, {
   3.42552450859375*^9, 3.425524626234375*^9}, {3.425524699484375*^9, 
   3.425524826921875*^9}, {3.425524868453125*^9, 3.425524887421875*^9}, 
   3.425524971390625*^9, 3.425525013625*^9, 3.42552509953125*^9, {
   3.425525387921875*^9, 3.425525404453125*^9}, 3.425525568359375*^9, {
   3.425525638375*^9, 3.4255256445625*^9}, {3.43748363171875*^9, 
   3.43748367046875*^9}, 3.437891132484375*^9},
 Background->RGBColor[1, 0.980392, 0.717647],
 CellLabel->"In[84]:=",ExpressionUUID->"1c4ebaca-e520-4c4c-be06-ae44599fa82e"],

Cell["Camera with primary mirror F/3.", "Text",
 CellChangeTimes->{{3.425523537234375*^9, 3.425523576859375*^9}, {
   3.437483082546875*^9, 3.437483104140625*^9}, 3.4374831393125*^9, {
   3.43865891740625*^9, 3.43865901709375*^9}, {3.4386595325625*^9, 
   3.438659554125*^9}, {3.43865960203125*^9, 3.438659610765625*^9}, {
   3.43866118284375*^9, 3.438661286359375*^9}, {3.438661317*^9, 
   3.4386613296875*^9}},
 FontSize->18,
 Background->RGBColor[
  0.768627, 0.976471, 
   1],ExpressionUUID->"108d0ab8-f337-ce44-85ea-8f246a1627c0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "=", "600."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spes", "=", 
   RowBox[{"{", 
    RowBox[{"10", ",", "6", ",", "6", ",", "6", ",", "10"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diam", "=", "200."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ni", "=", "1.5168"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Theta]", "=", "1.5"}], ";"}], "\n", 
 RowBox[{"BCamera", "[", 
  RowBox[{"f", ",", "spes", ",", "diam", ",", "Ni", ",", "\[Theta]"}], 
