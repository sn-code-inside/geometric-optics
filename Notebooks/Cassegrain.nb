Cell[CellGroupData[{

Cell["\<\
 Starting from these formulae, the following combinations can be analyzed \
\>", "Title",
 CellChangeTimes->{{3.39451426840625*^9, 3.394514268890625*^9}},
 FontSize->14,ExpressionUUID->"c73b0ccb-4ccd-5340-87ed-c4395f72b895"],

Cell["\<\
Dall-Kirkam combination: conic primary mirror and spherical secondary one (K2 \
= 0).\
\>", "Title",
 FontSize->18,
 Background->RGBColor[
  0.839857, 0.996109, 
   0.992203],ExpressionUUID->"65569dcd-b743-2843-ba41-855abfad9e4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq1", " ", "=", " ", 
   RowBox[{
    RowBox[{"D10", " ", "+", " ", 
     RowBox[{"D11", " ", "K1"}]}], " ", "==", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K1", " ", "->", " ", 
   RowBox[{
    RowBox[{"-", "D10"}], "/", "D11"}]}], ";"}], "\n"}], "Input",ExpressionUUI\
D->"a13b8dd1-9c48-4c4f-8f81-24190c8838e4"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Pressman-Camichel combination: spherical primary (K1 = 0) and conic \
secondary. \
\>", "Title",
 FontSize->18,
 Background->RGBColor[
  0.839857, 0.996109, 
   0.992203],ExpressionUUID->"ed9621e3-d6d2-4c47-9146-4d994a87ec9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq2", " ", "=", " ", 
   RowBox[{
    RowBox[{"D10", " ", "+", " ", 
     RowBox[{"D12", " ", "K2"}]}], " ", "==", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K2", " ", "->", " ", 
   RowBox[{
    RowBox[{"-", "D10"}], "/", "D12"}]}], ";"}]}], "Input",ExpressionUUID->\
"cb2b7871-8a7b-1545-826f-1756cc750111"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
Classical Cassegrain: parabolic primary (K1 = -1) and hyperbolic secondary.\
\>", "Title",
 FontSize->18,
 Background->RGBColor[
  0.839857, 0.996109, 
   0.992203],ExpressionUUID->"aa495c11-f726-5946-98ac-841e5b2c7086"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq3", "=", 
   RowBox[{
    RowBox[{"D10", "+", "1", "+", 
     RowBox[{"D12", " ", "K2"}]}], "\[Equal]", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"K2", "->", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"1", "+", "D10"}], "D12"]}]}], ";"}]}], "Input",ExpressionUUID->\
"50934031-d3d6-2845-936f-9ea8479ad3d4"]
}, Closed]],

Cell[CellGroupData[{

Cell["Ritchey-Cretien combination: both the mirrors are conic.", "Title",
 FontSize->18,
 Background->RGBColor[
  0.839857, 0.996109, 
   0.992203],ExpressionUUID->"eabe44da-2aef-f345-b671-be0395d2b670"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Ritchey", "-", 
    RowBox[{"Cretien", ":", " ", 
     RowBox[{
     "parabolic", " ", "primary", " ", "and", " ", "hyperbolic", " ", 
      "secondary"}]}]}], "*)"}], "\n", 
  RowBox[{"solrc", " ", "=", " ", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"D10", " ", "+", " ", 
          RowBox[{"D11", " ", "K1"}], " ", "+", " ", 
          RowBox[{"D12", " ", "K2"}]}], " ", "==", " ", "0"}], ",", " ", 
        RowBox[{
         RowBox[{"D20", " ", "+", " ", 
          RowBox[{"D22", " ", "K2"}]}], " ", "==", " ", "0"}]}], "}"}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"K1", ",", " ", "K2"}], "}"}]}], "]"}], " ", "//", " ", 
    "Simplify"}]}]}]], "Input",ExpressionUUID->"d223ddb7-5834-554e-84bd-\
bf088960f87e"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The following program allows us to project a Cassegrain \
combination for given \ntotal focal length ft;",
  FontSize->18],
 "\n",
 StyleBox["primary focal length f1;\nback distance em;\nprimary diameter \
diam1;\nfield angle \[Theta].",
  FontSize->18]
}], "Title",
 CellChangeTimes->{{3.3945155175625*^9, 
  3.3945156190625*^9}},ExpressionUUID->"f6ecb09c-10a7-0644-a0ee-8ab34494711d"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Summary",
 FontSize->24,
 FontWeight->"Bold"]], "Section",
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"616ef1d1-1806-5640-9df9-60ff7482e81c"],

Cell[TextData[{
 StyleBox["f1 = primary focal lenght; \nft = total focal length;\nem =back \
distance;\nM = ft/f1.\n\nAuxiliary constants:",
  FontSize->18],
 "\n\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{"\[Beta]", "=", 
    StyleBox[
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]],
     FontSize->18]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Gamma]", "=", 
    StyleBox[
     FractionBox[
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
      RowBox[{"1", "-", 
       SuperscriptBox["M", "2"]}]],
     FontSize->18]}], ";"}]}],
  FontSize->18,ExpressionUUID->"5e2b06e1-bad3-0940-81d1-c47f58cb6d77"],
 "\n\n",
 StyleBox["Spherical aberration coefficient:",
  FontSize->18],
 "\n\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"32", 
    SuperscriptBox["f1", "3"], "D1"}], "=", 
   RowBox[{"D10", "+", 
    RowBox[{"D11", " ", "K1"}], "+", 
    RowBox[{"D12", " ", "K2"}]}]}]],ExpressionUUID->
  "a44a2f59-f4de-794b-baff-6d51e920cc39"],
 "\n\n",
 StyleBox["where",
  FontSize->18],
 "\n",
 Cell[BoxData[
  RowBox[{"D10", " ", "=", 
   RowBox[{
    StyleBox["-",
     FontSize->18], 
    StyleBox[
     FractionBox[
      RowBox[{"1", "+", 
       SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
       RowBox[{
        SuperscriptBox["M", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], 
      SuperscriptBox["M", "3"]],
     FontSize->24]}]}]],ExpressionUUID->
  "6d899caa-16a5-804d-8d08-fcac7ce365f7"],
 ";\nD11 =  -1;\nD12 = ",
 Cell[BoxData[
  FractionBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
   RowBox[{
    SuperscriptBox["M", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "M"}], ")"}]}]]],
  FontSize->24,ExpressionUUID->"ba00eb7c-765b-df4b-98a2-e48704c7bfb2"],
 ";\n\n\n",
 Cell[BoxData[{
  RowBox[{
   StyleBox[
    RowBox[{"Coma", " ", "coefficient"}],
    FontFamily->"Times New Roman",
    FontSize->18], "\n"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"8", 
     SuperscriptBox["f1", "2"], "D2"}], "=", 
    RowBox[{"D20", "+", 
     RowBox[{"D22", " ", "K2"}]}]}], "\n"}], "\n", 
  RowBox[{
   StyleBox["where",
    FontFamily->"Times New Roman",
    FontSize->18], "\n"}], "\n", 
  RowBox[{
   RowBox[{"D20", " ", "=", 
    StyleBox[
     FractionBox[
      RowBox[{"M", "+", 
       SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
       RowBox[{
        SuperscriptBox["M", "2"], " ", "\[Alpha]"}]}], 
      SuperscriptBox["M", "3"]],
     FontSize->24]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"D22", " ", "=", " ", 
    FractionBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
      RowBox[{"(", 
       RowBox[{"M", "-", "\[Alpha]"}], ")"}]}], 
     RowBox[{
      SuperscriptBox["M", "3"], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "M"}], ")"}]}]]}], ";"}], "\[IndentingNewLine]"}],
  ExpressionUUID->"a3ad25a2-77a6-a744-a93b-49302ff6970a"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.39451588890625*^9, 3.39451588890625*^9}},
 FontSize->16,
 Background->RGBColor[
  0.701961, 1, 1],ExpressionUUID->"e51bee10-ed5d-c34e-9960-ccbfd9110588"]
}, Closed]],

Cell["", "Section",
 CellChangeTimes->{{3.39554378990625*^9, 3.395543792203125*^9}},
 Background->RGBColor[
  1, 0, 0],ExpressionUUID->"e847c009-fb0a-f949-9f0c-31b03851704f"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["The program Cassegrain",
  FontSize->36],
 "\n"
}], "Section",
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"c551cccc-dc4e-724a-ac31-6522832ad5aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Cassegrain", "[", 
   RowBox[{"ft_", ",", "f1_", ",", "em_", ",", "diam_", ",", "angle_"}], 
   "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"em", "/", "f1"}]}], ";", "\n", 
     RowBox[{"M", "=", 
      RowBox[{"ft", "/", "f1"}]}], ";", "\n", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"M", "-", "\[Alpha]"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"M", "+", "1"}], ")"}]}]}], ";", "\n", 
     RowBox[{"s12", "=", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], ";", "\n", 
     RowBox[{"co", "=", 
      RowBox[{"1", "-", "\[Beta]"}]}], ";", "\n", 
     RowBox[{"\[Gamma]", "=", 
      FractionBox[
       RowBox[{"2", " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]]}], ";", "\n", 
     RowBox[{"R2", "=", 
      RowBox[{"\[Gamma]", " ", "f1"}]}], ";", "\n", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"Cell", "[", 
       RowBox[{"\"\<General Data\>\"", ",", "\"\<Section\>\""}], "]"}], "]"}],
      ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Primary radius = \>\"", ",", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "f1"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Secondary radius = \>\"", ",", "R2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Secondary diameter = \>\"", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "\[Beta]"}], ")"}], " ", "diam"}]}], "]"}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance between primary and secondary = \>\"", ",", "s12"}], 
      "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Obstruction coefficient = \>\"", ",", "co"}], "]"}], ";", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{"Aberrazioni", " ", "totali"}], "*)"}], "\n", 
     RowBox[{"r", "=", 
      RowBox[{"diam1", "/", "2"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Spherical", " ", "and", " ", "coma", " ", "aberration", " ", 
       "coefficients"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"D10", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"1", "+", 
         SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
         RowBox[{
          SuperscriptBox["M", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], 
        RowBox[{" ", 
         SuperscriptBox["M", "3"]}]]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D11", "=", 
      RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D12", "=", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{
        SuperscriptBox["M", "3"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "M"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D20", "=", 
      FractionBox[
       RowBox[{"M", "+", 
        SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
        RowBox[{
         SuperscriptBox["M", "2"], " ", "\[Alpha]"}]}], 
       RowBox[{"8", " ", 
        SuperscriptBox["f1", "2"], " ", 
        SuperscriptBox["M", "3"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"D22", "=", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
        RowBox[{"(", 
         RowBox[{"M", "-", "\[Alpha]"}], ")"}]}], 
       RowBox[{"8", " ", 
        SuperscriptBox["f1", "2"], " ", 
        SuperscriptBox["M", "3"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "M"}], ")"}]}]]}], ";", "\[IndentingNewLine]", 
     "\n", 
     RowBox[{"(*", 
      RowBox[{"Total", " ", "aberrations"}], " ", "*)"}], "\n", 
     RowBox[{"Print", "[", "\"\<********\>\"", "]"}], ";", "\n", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"Cell", "[", 
       RowBox[{
       "\"\<Conic primary and spherical secondary\>\"", ",", 
        "\"\<Section\>\""}], "]"}], "]"}], ";", "\n", 
     RowBox[{"K11", "=", "D10"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K1 = \>\"", ",", "K11"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"K11", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Transversal spherical Aberration = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total sagittal coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total Astigmatism = \>\"", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", "\"\<********\>\"", "]"}], ";", "\n", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"Cell", "[", 
       RowBox[{
       "\"\<Spherical primary and conic secondary\>\"", ",", 
        "\"\<Section\>\""}], "]"}], "]"}], ";", "\n", 
     RowBox[{"K12", "=", 
      RowBox[{"-", 
       FractionBox["D10", "D12"]}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K2 = \>\"", ",", "K12"}], "]"}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "K12"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Transversal spherical Aberration = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total sagittal coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total astigmatism = \>\"", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", "\"\<********\>\"", "]"}], ";", "\n", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"Cell", "[", 
       RowBox[{
       "\"\<Parabolic primary and hyperbolic secondary\>\"", ",", 
        "\"\<Section\>\""}], "]"}], "]"}], ";", "\n", 
     RowBox[{"K22", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"1", "+", "D10"}], "D12"]}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K1 = \>\"", ",", 
       RowBox[{"-", "1"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K2 = \>\"", ",", "K22"}], "]"}], ";", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "K22"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Transversal spherical Aberration = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total sagittal coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total astigmatism = \>\"", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", "\"\<********\>\"", "]"}], ";", "\n", 
     RowBox[{"CellPrint", "[", 
      RowBox[{"Cell", "[", 
       RowBox[{
       "\"\<Ritchey-Cretien combination\>\"", ",", "\"\<Section\>\""}], "]"}],
       "]"}], ";", "\n", 
     RowBox[{"K13", "=", 
      RowBox[{"D10", "-", 
       FractionBox[
        RowBox[{"D12", " ", "D20"}], "D22"]}]}], ";", "\n", 
     RowBox[{"K23", "=", 
      RowBox[{"-", 
       FractionBox["D20", "D22"]}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K1 =\>\"", ",", "K13"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<K2 = \>\"", ",", "K23"}], "]"}], ";", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"K13", ",", "K23"}], "}"}], ",", 
       RowBox[{"diam1", "/", "2"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Transversal spherical Aberration = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total sagittal coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Total astigmatism = \>\"", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";"}]}], "\n", "\n", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.432191275012861*^9, 3.432191444382061*^9}, {
   3.4321914975468607`*^9, 3.432191641410061*^9}, 3.432997787796875*^9},
 Background->RGBColor[1, 1, 0.615686],
 CellLabel->"In[14]:=",ExpressionUUID->"9b67fa32-5c8a-9844-aae5-44551577695b"]
}, Open  ]],

