Cell[CellGroupData[{

Cell[TextData[StyleBox["CASSEGRAIN COMBINATIONS",
 FontSize->24,
 FontWeight->"Bold"]], "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"d696dcc3-289e-0543-a4c6-e17bf837c482"],

Cell[TextData[{
 "This notebook  designs a Cassegrain telescope in one of its possible \
configurations.\nIn the first part, the theoretical bases of this \
configuration are discussed whereas, in the second part, the program and its \
applications are contained.\nA Cassegrain combination is formed by two \
mirrors, with the aperture stop at the primary. At least one of the mirrors \
is conic.\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{
    "The", " ", "Gaussian", " ", "project", " ", "starts", " ", "from", " ", 
     "the", " ", "following", " ", 
     RowBox[{"data", ":", "\[IndentingNewLine]", "\n", "f1"}]}], " ", "=", 
    " ", 
    RowBox[{"primary", " ", "focal", " ", "lenght"}]}], ";"}], "\n", 
  RowBox[{" ", 
   RowBox[{
    RowBox[{"ft", " ", "=", " ", 
     RowBox[{"total", " ", "focal", " ", "length"}]}], ";"}]}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"em", " ", "=", 
     RowBox[{"back", " ", "distance"}]}], ";"}], 
   "\n"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "to", " ", "determine", " ", "the", " ", "following", " ", "quantities", 
      " ", 
      RowBox[{"(", 
       RowBox[{"see", " ", "Chapter", " ", "4"}], ")"}]}], ":", 
     "\[IndentingNewLine]", "\n", "\[Alpha]"}], "=", 
    RowBox[{"em", "/", "f1"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{"ft", "/", "f1"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Beta]", 
    StyleBox["=",
     FontSize->18], 
    StyleBox[
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]],
     FontSize->24]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"co", "=", 
    RowBox[{"1", "-", "\[Beta]"}]}], ";"}], "\n", 
  RowBox[{"\[Gamma]", 
   StyleBox["=",
    FontSize->18], 
   RowBox[{
    StyleBox[
     FractionBox[
      RowBox[{"2", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
      RowBox[{"1", "-", 
       SuperscriptBox["M", "2"]}]],
     FontSize->24], 
    StyleBox[".",
     FontSize->18]}]}]}],
  PageWidth->WindowWidth,
  CellChangeTimes->{{3.394514098609375*^9, 3.394514099859375*^9}, {
    3.394514162796875*^9, 3.394514185484375*^9}, 3.394515218953125*^9, {
    3.39451530553125*^9, 3.394515313*^9}},
  TextAlignment->Left,
  TextJustification->1.,
  FontFamily->"Times New Roman",
  FontSize->18,
  FontVariations->{"CompatibilityType"->0},ExpressionUUID->
  "061baf15-e5d3-2446-9723-037205ae8b11"],
 "\n\nThen, \[Alpha]  and M are taken as the fundamental  variables and the \
following quantities are introduced :\n    \nR1 = -2 f1 = primary radius;\nR2 \
= \[Gamma] f1 = secondary radius (\[Gamma] < 0);\ns12 = -\[Beta] f1 = \
distance of the secondary from primary (\[Beta] > 0);\nK1 = conic constant of \
primary;\nK2  = conic constant of secondary.\n\nInserting these quantities as \
input data of the program NTAberrations, all the characteristics of the \
combination can be derived."
}], "Title",
 CellChangeTimes->{
  3.394515079375*^9, {3.394515129484375*^9, 3.39451513765625*^9}, {
   3.394515174828125*^9, 3.39451519775*^9}, {3.394515230296875*^9, 
   3.394515300625*^9}, {3.39451533153125*^9, 3.39451533334375*^9}, {
   3.394515392453125*^9, 3.394515405640625*^9}, {3.39451545175*^9, 
   3.394515456578125*^9}, {3.39451564453125*^9, 3.394515667453125*^9}, 
   3.394515720578125*^9, {3.4321905640116606`*^9, 3.4321905888936605`*^9}},
 FontSize->18,ExpressionUUID->"a605cf89-f524-3649-867c-3a1f924316e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Beta]", "=", 
   FractionBox[
    RowBox[{"M", "-", "\[Alpha]"}], 
    RowBox[{"M", "+", "1"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", 
   FractionBox[
    RowBox[{"2", " ", "M", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
    RowBox[{"1", "-", 
     SuperscriptBox["M", "2"]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rad", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "f1"}], ",", 
     RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ind", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"K1", ",", "K2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"stoprad", "=", "r"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"angle", "=", "\[Alpha]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"waves", "=", 
   RowBox[{"{", "\[Lambda]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "stoprad", ",", "0", 
   ",", "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", ",", 
   "2"}], "]"}]}], "Input",
 CellChangeTimes->{{3.432190681978861*^9, 3.432190778620861*^9}, {
  3.4321909085844607`*^9, 3.432190931126461*^9}, {3.432191087329261*^9, 
  3.432191124160861*^9}},
 FontSize->12,
 CellLabel->"In[7]:=",ExpressionUUID->"a26ff4c0-146c-b246-b446-a9c5b46bbb49"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"D1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Seidsphe", "[", "1", "]"}], "]"}]}], "\n", 
 RowBox[{"D2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Seidcoma", "[", "1", "]"}], "]"}]}], "\[LineSeparator]"}], "Input",
 CellChangeTimes->{{3.432190663461661*^9, 3.432190673632861*^9}, 
   3.4321907946576605`*^9, {3.432190968238861*^9, 3.432190980157261*^9}, {
   3.432191198229661*^9, 3.432191204266861*^9}},
 FontSize->12,
 CellLabel->"In[19]:=",ExpressionUUID->"97f8271c-426c-224c-9dfe-5bd76d85438d"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"K2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "M"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "K1"}], ")"}], " ", 
       SuperscriptBox["M", "3"]}], "+", "\[Alpha]", "-", 
      RowBox[{
       SuperscriptBox["M", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], ")"}]}]}], 
  RowBox[{"32", " ", 
   SuperscriptBox["f1", "3"], " ", 
   SuperscriptBox["M", "3"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "M"}], ")"}]}]]], "Output",
 CellChangeTimes->{3.4321908440628605`*^9, 3.4321910338056602`*^9, 
  3.432191129823661*^9, 3.432191206794061*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"397487a7-3040-de43-82c9-e3b36c41d5e9"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "K2"}], ")"}], " ", 
    SuperscriptBox["M", "4"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", "K2"}], ")"}], " ", "\[Alpha]"}], "+", 
   RowBox[{
    SuperscriptBox["M", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "\[Alpha]", "+", 
      RowBox[{"3", " ", "K2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], ")"}]}], "-", 
   RowBox[{
    SuperscriptBox["M", "3"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "\[Alpha]", "+", 
      RowBox[{"K2", " ", 
       RowBox[{"(", 
        RowBox[{"3", "+", "\[Alpha]"}], ")"}]}]}], ")"}]}], "+", 
   RowBox[{"M", " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Alpha]", "-", 
      RowBox[{"K2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"3", " ", "\[Alpha]"}]}], ")"}]}]}], ")"}]}]}], 
  RowBox[{"8", " ", 
   SuperscriptBox["f1", "2"], " ", 
   SuperscriptBox["M", "3"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "M"}], ")"}]}]]], "Output",
 CellChangeTimes->{3.4321908440628605`*^9, 3.4321910338056602`*^9, 
  3.432191129823661*^9, 3.432191206794061*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"168a0790-74e4-8c49-b3a0-6c19d506c56b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
These formulae can be simplified by evaluating the coefficients of K1 and K2 \
in each of them \
\>", "Title",
 CellChangeTimes->{3.39451422678125*^9},
 FontSize->18,ExpressionUUID->"f80f60ad-a30b-964b-851e-9896c2288c40"],

Cell[BoxData[
 RowBox[{"D10", "=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"32", 
        SuperscriptBox["f1", "3"], "D1"}], ",", "K1", ",", "0"}], "]"}], ",", 
     "K2", ",", "0"}], "]"}], "//", "Simplify"}]}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"07b10418-fef5-cb4d-896a-18bb686621d0"],

Cell[BoxData[
 RowBox[{"D11", "=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"32", 
      SuperscriptBox["f1", "3"], "D1"}], ",", "K1"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"8766082f-6996-3348-93ae-a3806ea74456"],

Cell[BoxData[
 RowBox[{"D12", "=", 
  RowBox[{
   RowBox[{"Coefficient", "[", 
    RowBox[{
     RowBox[{"32", 
      SuperscriptBox["f1", "3"], "D1"}], ",", "K2"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"9d8c6937-740e-224f-b394-a739196b05df"],

Cell[TextData[{
 StyleBox["In concluding, the spherical aberration coefficient writes;\n",
  FontFamily->"Times New Roman"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"32", 
     SuperscriptBox[
      SubscriptBox["f", "1"], "2"], 
     SubscriptBox["D", "1"]}], "=", 
    RowBox[{
     SubscriptBox["D", "10"], "+", 
     RowBox[{
      SubscriptBox["D", "11"], 
      SubscriptBox["K", "1"]}], "+", 
     RowBox[{
      SubscriptBox["D", "12"], 
      RowBox[{
       SubscriptBox["K", "2"], "."}]}]}]}], TraditionalForm]],ExpressionUUID->
  "f380d13d-3e4c-9a43-9e70-82ba046dfcf0"],
 StyleBox[" \n",
  FontFamily->"Times New Roman",
  FontSize->16],
 StyleBox["Proceeding in the same way for coma, one has",
  FontFamily->"Times New Roman"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.432284034734375*^9, 3.432284037984375*^9}},
 FontSize->14,ExpressionUUID->"eea5b453-373c-764e-94d7-130dfe38428d"],

