       RowBox[{"8", 
        SuperscriptBox["f1", "2"], "D2"}], ",", "K1", ",", "0"}], "]"}], ",", 
     "K2", ",", "0"}], "]"}], "//", "Simplify"}]}]], "Input",ExpressionUUID->\
"072dea1d-54d4-8a48-ba06-4f3e86c7ac93"],

Cell[BoxData[
