Cell[CellGroupData[{

Cell["\<\
Analisi grafica per determinare valori approssimati delle curvature c1, c3, \
c5. Si osservi che le curve di colore grigio si riferiscono all'astigmatismo, \
quelle azzurre all'aberrazione sferica e quella viola al coma. I grafici sono \
ottenuti fissando il valore di c5. E' facile verificare che le tre curve non \
si incontrano in uno stesso punto al variare di c5. Inoltre, riducendo il \
valore di c5 aumentano quelli di c1 e c3. Pertanto si fissa un valore c5=0.02.\
\>", "Subsection",
 CellChangeTimes->{{3.3950373203125*^9, 3.395037511875*^9}, {
   3.3950375715625*^9, 3.395037626359375*^9}, {3.3950376680625*^9, 
   3.3950377055625*^9}, 
   3.3951412075*^9},ExpressionUUID->"2d8d7b52-41c0-ae44-af07-da2744c309da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s1", "=", 
   RowBox[{"{", 
    RowBox[{"c5", "\[Rule]", "0.002"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Absftot", "[", "1", "]"}], "/.", "s1"}], ")"}], "\[Equal]", 
      RowBox[{"-", "0.02"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Comatot", "[", "1", "]"}], "/.", "s1"}], ")"}], "\[Equal]", 
      "0.002"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Asttot", "[", "1", "]"}], "/.", "s1"}], ")"}], "\[Equal]", 
      "0.02"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c1", ",", "0.01", ",", "0.07"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"c3", ",", 
     RowBox[{"-", "0.05"}], ",", 
     RowBox[{"-", "0.01"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.394261708515625*^9, 3.39426175221875*^9}, {
  3.394261798546875*^9, 3.394261809515625*^9}, {3.3942868230625*^9, 
