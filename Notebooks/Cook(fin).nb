     RowBox[{
      RowBox[{"hobj1", "[", 
       RowBox[{"2", ",", "n"}], "]"}], "-", 
      RowBox[{"hobj1", "[", 
       RowBox[{"3", ",", "n"}], "]"}]}], "]"}], "]"}]}], 
