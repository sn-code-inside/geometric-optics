Cell[CellGroupData[{

Cell["\<\
Si introducono gli spessori delle lenti lasciando invariati i valori di \
\[Phi]1, \[Phi]2, \[Phi]3 trovati in sol1. Quindi si determinano c1, c2, c3 \
imponendo la conservazione della focale e richiedendo l'eliminazione \
dell'aberrazione sferica e del coma.
\
\>", "Subsection",
 CellChangeTimes->{{3.39428669903125*^9, 3.39428675225*^9}, {
   3.394286786953125*^9, 3.394286794359375*^9}, {3.39503684065625*^9, 
