 RowBox[{"sol1", "=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"eqf1", "\[Equal]", "0"}], ",", 
      RowBox[{"eqz1", "\[Equal]", 
