         "1.783314", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"TotalAberrations", "[", 
    RowBox[{"rad", ",", "thick", ",", "ind", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], 
     ",", "5", ",", "4", ",", "2", ",", 
