Cell[CellGroupData[{

Cell[TextData[{
 "\n",
 StyleBox["Si suppone inizialmente il sistema simmetrico rispetto al \
diaframma ed r2=r3=r4=r5=Infinity, r1, r6. In tal modo restano due gradi di \
libert\[AGrave]: i raggi r1ed r6. Inizialmente si suppone che sia nullo lo \
spessore delle lenti del tripletto, che sia assegnata la distanza d tra le \
lenti e che il diaframma disti 1mm dalla superficie posteriore della seconda \
lente.",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{
  3.39428641890625*^9, {3.3950359628125*^9, 3.395035989265625*^9}, {
