Cell[CellGroupData[{

Cell["\<\
Individuati graficamente dei valori approssimati di c1, c3, c5, si prova a \
determinare quelli esatti con il comando FindRoot imponendo l'eliminazione \
dell'aberrazione sferica, del coma ed il mantenimento della focale.
\
\>", "Subsection",
 CellChangeTimes->{{3.395037784515625*^9, 
  3.395037925953125*^9}},ExpressionUUID->"51a1740e-2a1f-8244-b8c6-\
49bf18b9bea5"],

Cell[BoxData[
 RowBox[{"solp", "=", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", 
       RowBox[{"-", "0.02"}]}], ",", 
      RowBox[{
       RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", "0.002"}], ",", 
      RowBox[{
       RowBox[{"foc", "[", "1", "]"}], "\[Equal]", "52"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c1", ",", "0.02"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c3", ",", 
