Cell[CellGroupData[{

Cell[TextData[{
 "\n",
 StyleBox["Si suppone inizialmente il sistema simmetrico rispetto al \
diaframma. In tal modo restano quattro gradi di libert\[AGrave]: i raggi r1, \
r2, r3 e lo spessore tra le lenti estreme e quella centrale",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{
