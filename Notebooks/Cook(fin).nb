Cell[CellGroupData[{

Cell["\<\
Si introducono gli spessori delle lenti lasciando invariati i valori di \
\[Phi]1, \[Phi]2, \[Phi]3 trovati in sol1. Quindi si determinano c1, c2, c3 \
imponendo la conservazione della focale e richiedendo l'eliminazione \
dell'aberrazione sferica e del coma.
\
\>", "Subsection",
 CellChangeTimes->{{3.39428669903125*^9, 3.39428675225*^9}, {
   3.394286786953125*^9, 3.394286794359375*^9}, {3.39503684065625*^9, 
   3.3950370235*^9}, 3.39559717190625*^9},
 FontSize->16,ExpressionUUID->"ec6b3182-699a-6a4a-83c2-461811f7844a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"tripletto", " ", "con", " ", "vetri", " ", "LaFN21"}], ",", " ", 
    "SF53", ",", " ", "LaFN21"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rad", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "c1"}], ",", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"c1", "-", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{"1", "/", "c3"}], ",", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"c3", "-", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}]}], ",", 
       RowBox[{"1", "/", "c5"}], ",", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"c5", "-", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ")"}]}]}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thick", "=", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "2", ",", "7.2", ",", "3"}], "}"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "1", ",", "1.792537", ",", "1", ",", "1.734722", ",", "1", ",", 
         "1.792537", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "1", ",", "1.79992", ",", "1", ",", "1.746348", ",", "1", ",", 
         "1.79992", ",", "1"}], "}"}], ",", 
