Cell[TextData[{
 "\n",
 StyleBox["Si determina la ",
  FontWeight->"Bold"],
 StyleBox["forma",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["  ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["\[Phi]", "i"], " ", "=", 
     RowBox[{
      SubscriptBox["c", "i"], "-", 
      SubscriptBox["c", 
       RowBox[{"i", "+", "1"}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "56777e48-1fc4-6543-9a43-96c008c41f58"],
 ") ",
 StyleBox["delle tre lenti imponendo la focale, il cromatismo assiale e \
quello di ingrandimento per ",
  FontWeight->"Bold"],
 StyleBox["spessori nulli",
  FontWeight->"Bold",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox[".  Quest'ultima ipotesi \[EGrave] necessaria per avere relazioni \
gaussiane in cui intervengono soltanto le ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Phi]", "i"], " ", "e", " ", "non", " ", "le", " ", 
    RowBox[{
     SubscriptBox["c", "i"], "."}]}], TraditionalForm]],ExpressionUUID->
  "11bd9770-7d2f-7d44-8879-9db83261334f"]
}], "Subsection",
