  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"HOrdAberrations", "[", 
    RowBox[{
    "rad_", ",", "thick_", ",", "ind_", ",", "costasf_", ",", "stoprad_", ",",
      "nstop_", ",", "dis_", ",", "dobject_", ",", "hobject_", ",", "angle_", 
     ",", "waves_", ",", "opt_"}], "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\n", 
