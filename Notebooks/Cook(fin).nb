      RowBox[{
       RowBox[{"Do", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Qe", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"inde1", "[", "h", "]"}], "[", 
