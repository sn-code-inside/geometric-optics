     RowBox[{"zog1", "[", 
      RowBox[{"2", ",", "n"}], "]"}], "-", 
     RowBox[{"zog1", "[", 
      RowBox[{"3", ",", "n"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqla1", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{
     RowBox[{"hobj1", "[", 
      RowBox[{"2", ",", "n"}], "]"}], "-", 
     RowBox[{"hobj1", "[", 
      RowBox[{"3", ",", "n"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.395141295171875*^9, 3.395141356046875*^9}, {
