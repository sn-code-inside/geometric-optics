                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]]}], "]"}], "]"}], "]"}], "===",
                "0"}]}], ",", 
             RowBox[{"-", "Infinity"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", 
