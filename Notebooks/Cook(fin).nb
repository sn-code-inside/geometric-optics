        RowBox[{"Reverse", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"rad", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "nstop"}], "}"}]}], "]"}], "]"}]}], "//", 
       "Flatten"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Evaluation", " ", "of", " ", "the", " ", "aperture", " ", "stop", " ", 
       "images", " ", "supplied", " ", "by", " ", "the", " ", "surfaces", " ",
        "preceeding", " ", "the", " ", 
       RowBox[{"stop", ":", "\n", 
        RowBox[{
        "the", " ", "last", " ", "one", " ", "is", " ", "the", " ", 
         "entrance", " ", 
         RowBox[{"pupil", "."}]}]}]}], " ", "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"inde", "[", "h", "]"}], "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Take", "[", 
           RowBox[{
            RowBox[{"ind", "[", 
             RowBox[{"[", "h", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "nstop"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
        RowBox[{
         RowBox[{"inde1", "[", "h", "]"}], "=", 
