     RowBox[{"1", "/", 
      RowBox[{"foc", "[", "1", "]"}]}], "-", 
     RowBox[{"(", 
      RowBox[{"1", "/", "80"}], ")"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqz1", "=", 
