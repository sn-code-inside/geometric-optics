    "nstop_", ",", "dis_", ",", "dobject_", ",", "hobject_", ",", "angle_", 
    ",", "waves_", ",", "option1_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "number", " ", "of", " ", "surfaces", " ", "and", " ", "wave", " ", 
      "lengths"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\n", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "waves", "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Distances", " ", "among", " ", "the", " ", "surfaces"}], " ", 
      "*)"}], "\n", 
     RowBox[{"thicke", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"thick", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"nstop", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"thicke1", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"thicke", ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"rade", "=", 
      RowBox[{
