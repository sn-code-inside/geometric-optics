             RowBox[{"rade", "[", 
              RowBox[{"[", "i", "]"}], "]"}]]}]}], ";", "\n", 
          RowBox[{
           RowBox[{"ze1", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"ze", "[", 
               RowBox[{"h", ",", "i"}], "]"}], "===", "0"}], ",", 
