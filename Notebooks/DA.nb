           RowBox[{"{", 
            RowBox[{"1", ",", "nstop"}], "}"}]}], "]"}], "]"}]}], "//", 
       "Flatten"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Evaluation", " ", "of", " ", "the", " ", "aperture", " ", "stop", " ", 
       "images", " ", "supplied", " ", "by", " ", "the", " ", "surfaces", " ",
        "preceeding", " ", "the", " ", 
       RowBox[{"stop", ":", "\n", 
        RowBox[{
        "the", " ", "last", " ", "one", " ", "is", " ", "the", " ", 
         "entrance", " ", 
         RowBox[{"pupil", "."}]}]}]}], " ", "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"inde", "[", "h", "]"}], "=", 
