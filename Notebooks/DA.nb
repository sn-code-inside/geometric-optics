       RowBox[{"option1", "\[Equal]", "1"}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<\!\(\*SubscriptBox[\(w\), \(e\)]\) = \>\"", ",", " ", 
         RowBox[{"de", "[", "1", "]"}]}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ye", "[", 
          RowBox[{"h", ",", "1"}], "]"}], "=", "stoprad"}], ";", "\n", 
        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"ye1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "=", 
            RowBox[{"If", "[", 
             RowBox[{
