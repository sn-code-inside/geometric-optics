\",FontSize->18]\)\!\(\*StyleBox[\"Data\",FontSize->18]\)\!\(\*StyleBox[\" \
\",FontSize->18]\)\>\"", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\n", 
     RowBox[{"m", "=", 
      RowBox[{"Length", "[", "waves", "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Distances", " ", "among", " ", "the", " ", "surfaces"}], " ", 
      "*)"}], "\n", 
     RowBox[{"thicke", "=", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"thick", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"nstop", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"thicke1", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"thicke", ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"rade", "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Reverse", "[", 
