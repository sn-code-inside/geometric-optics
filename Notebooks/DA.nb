              RowBox[{"h", ",", "i"}], "]"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}], 
             RowBox[{"rade", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], "-", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], 
             RowBox[{"w1", "[", 
              RowBox[{"h", ",", "i"}], "]"}]], "+", 
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"i", "+", "1"}], "]"}], "]"}], 
             RowBox[{"rade", "[", 
              RowBox[{"[", "i", "]"}], "]"}]]}]}], ";", "\n", 
          RowBox[{
           RowBox[{"ze1", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
