       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "3"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{"Do", "[", "\n", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Qe", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{
              RowBox[{"inde", "[", "h", "]"}], "[", 
