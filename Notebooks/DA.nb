           RowBox[{
            RowBox[{"ze1", "[", 
             RowBox[{"h", ",", "i"}], "]"}], "-", 
            RowBox[{"thicke1", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}]}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "nstop"}], "}"}]}], "]"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"de", "[", "h", "]"}], "=", 
