                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
                    RowBox[{"[", "i", "]"}], "]"}], 
                    RowBox[{"ze", "[", 
                    RowBox[{"h", ",", "i"}], "]"}]], "-", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
