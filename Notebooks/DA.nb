                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]], "+", 
                   FractionBox[
                    RowBox[{
                    RowBox[{"inde", "[", "h", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], 
                    RowBox[{"rad", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]]}], "]"}], "]"}], "]"}], "===",
                "0"}]}], ",", 
             RowBox[{"-", "Infinity"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "=!=", 
               RowBox[{"-", "Infinity"}]}], "||", 
              RowBox[{
               RowBox[{"ze", "[", 
                RowBox[{"h", ",", "i"}], "]"}], "===", 
               RowBox[{"-", "Infinity"}]}]}], ",", 
             RowBox[{
              RowBox[{"Solve", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Qe", "[", 
                  RowBox[{"h", ",", "i"}], "]"}], "\[Equal]", "0"}], ",", 
                RowBox[{"w1", "[", 
                 RowBox[{"h", ",", "i"}], "]"}]}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], "]"}]}], 
          ";", " ", 
          RowBox[{
           RowBox[{"ze", "[", 
            RowBox[{"h", ",", 
