  3.969839071839073*^9}, {3.992417040200601*^9, 3.99241716147814*^9}, {
  3.992417198523807*^9, 3.992417780703123*^9}, {3.992417815242632*^9, 
  3.9924178154809437`*^9}, {3.992418087783016*^9, 3.992418165590395*^9}, {
