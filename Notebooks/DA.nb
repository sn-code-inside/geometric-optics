Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "spell"}], "]"}], "\n", 
    RowBox[{"Off", "[", 
     RowBox[{"General", "::", "spell1"}], "]"}], "\n", 
    RowBox[{"Off", "[", 
     RowBox[{"FindRoot", "::", "lstol"}], "]"}], "\n", 
    RowBox[{"Off", "[", 
     RowBox[{"Part", "::", "partw"}], "]"}], "\n", 
    RowBox[{"Off", "[", 
     RowBox[{"Solve", "::", "inex"}], "]"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"DA", "[", 
     RowBox[{
     "rad_", ",", "thick_", ",", "ind_", ",", "costasf_", ",", "stoprad_", 
      ",", "nstop_", ",", "dis_", ",", "dobject_", ",", "hobject_", ",", 
      "waves_", ",", "order_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"TotalAberrations", "[", 
        RowBox[{
        "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "stoprad", ",", 
         "nstop", ",", "dis", ",", "dobject", ",", "hobject", ",", "angle", 
         ",", "waves", ",", "1"}], "]"}], ";", "\n", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "rad", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\n", 
       RowBox[{"(*", " ", 
        StyleBox[
         RowBox[{"Ray", " ", "tracing"}],
         FontSize->18,
         FontColor->RGBColor[0, 0, 1]], " ", "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        StyleBox[
         RowBox[{"Equations", " ", "of", " ", "the", " ", "surfaces"}],
         FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"spess", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "0", "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
