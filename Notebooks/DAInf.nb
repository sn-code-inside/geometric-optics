     "}"}], ",", 
    RowBox[{
     RowBox[{"n1", "=", 
      RowBox[{"Length", "[", "inc", "]"}]}], ";", "\n", 
     RowBox[{"n2", "=", 
      RowBox[{"Length", "[", "var", "]"}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "Calcolo", " ", "della", " ", "matrice", " ", "jacobiana", " ", "nel", 
       " ", "punto", " ", "iniziale"}], "*)"}], "\n", 
     RowBox[{"pininc", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"inc", "[", 
          RowBox[{"[", "h", "]"}], "]"}], "\[Rule]", 
         RowBox[{"inc0", "[", 
          RowBox[{"[", "h", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "1", ",", "n1"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"pinvar", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"var", "[", 
          RowBox[{"[", "h", "]"}], "]"}], "\[Rule]", 
         RowBox[{"var0", "[", 
          RowBox[{"[", "h", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "1", ",", "n2"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"pin", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"pininc", ",", "pinvar"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"coeff", "[", 
       RowBox[{"h_", ",", "k_"}], "]"}], ":=", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"sys", "[", 
         RowBox[{"[", "h", "]"}], "]"}], ",", 
        RowBox[{"inc", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Jac", "=", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"coeff", "[", 
            RowBox[{"h", ",", "k"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"h", ",", "1", ",", "n1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "n1"}], "}"}]}], "]"}], "/.", "pin"}],
         "]"}], "//", "Simplify"}]}], ";", "\n", "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
        RowBox[{
        "The", " ", "unknowns", " ", "are", " ", "defined", " ", "as", " ", 
         "functions", " ", "u"}], "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"fu", "[", "var", "]"}], "]"}], " ", "of", " ", "variables",
          " ", "var"}]}], ";", 
       RowBox[{
       "u0", " ", "is", " ", "the", " ", "table", " ", "of", " ", "these", 
        " ", "functions", " ", "in", " ", "var0"}], ";", 
       RowBox[{
       "sist", " ", "is", " ", "the", " ", "system", " ", "of", " ", "these", 
        " ", "functions"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{
      RowBox[{"ap", "[", 
       RowBox[{"fu_", ",", 
        RowBox[{"{", "q__", "}"}]}], "]"}], ":=", 
