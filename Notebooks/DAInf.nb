          RowBox[{"derinc", "[", "j", "]"}], "/.", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"var", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "\[Rule]", 
