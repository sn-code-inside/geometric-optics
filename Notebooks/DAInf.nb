 Background->RGBColor[
  0.8392156862745098, 0.8392156862745098, 
   0.8392156862745098],ExpressionUUID->"0cf1fe24-6765-8749-bd8e-5c3febfd3df0"],

Cell[BoxData[{
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell1"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"FindRoot", "::", "lstol"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"Part", "::", "partw"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"Solve", "::", "inex"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"DAInf", "[", 
   RowBox[{
   "rad_", ",", "thick_", ",", "ind_", ",", "costasf_", ",", "stoprad_", ",", 
    "nstop_", ",", "dis_", ",", "angle_", ",", "waves_", ",", "order_", ",", 
    "fact_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
      "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "stoprad", ",", 
       "nstop", ",", "dis", ",", 
       RowBox[{"-", "Infinity"}], ",", "xx", ",", "angle", ",", "waves", ",", 
       "1"}], "]"}], ";", "\n", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      StyleBox[
       RowBox[{"Ray", " ", "tracing"}],
       FontSize->18,
       FontColor->RGBColor[0, 0, 1]], " ", "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{"Equations", " ", "of", " ", "the", " ", "surfaces"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"spess", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"thick", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"costasf", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], ">", "1"}], ",", 
         RowBox[{
          RowBox[{"Fu", "[", "j", "]"}], "=", 
          RowBox[{
           RowBox[{"spess", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "+", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"2", " ", 
              RowBox[{"rad", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["X", "2"], "+", 
              SuperscriptBox["Y", "2"]}], ")"}]}], " ", "+", 
           RowBox[{
            RowBox[{
             RowBox[{"costasf", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               SuperscriptBox["X", "2"], "+", 
               SuperscriptBox["Y", "2"]}], ")"}], "2"]}], "+", 
           RowBox[{
            RowBox[{
