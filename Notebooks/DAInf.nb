       "variables", " ", "var"}], "*)"}], "\n", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"derinc", "[", "0", "]"}], "=", "u"}], ";", "\n", 
        RowBox[{
         RowBox[{"derinc", "[", "j", "]"}], "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"derinc", "[", 
               RowBox[{"j", "-", "1"}], "]"}], ",", 
