           RowBox[{"sol", "[", "j", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"sol", "[", "j", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"solrid", "[", 
       RowBox[{"h_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"t1", "[", "j", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"co0", "[", "h", "]"}], ",", "x_"}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"solrid1", "[", 
       RowBox[{"h_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"solrid", "[", 
          RowBox[{"h", ",", "j"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"solrid", "[", 
            RowBox[{"h", ",", "j"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"solrid2", "[", 
       RowBox[{"h_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"solrid", "[", 
          RowBox[{"h", ",", "j"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"solrid", "[", 
            RowBox[{"h", ",", "j"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"pot", "[", 
       RowBox[{"h_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Cases", "[", 
       RowBox[{
        RowBox[{"solrid1", "[", 
         RowBox[{"h", ",", "j"}], "]"}], ",", 
        RowBox[{
         RowBox[{"co0", "[", "h", "]"}], "\[Rule]", "prn"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"esp", "[", 
       RowBox[{"h_", ",", "j_", ",", "k_", ",", "i_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"pot", "[", 
        RowBox[{"h", ",", "j"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"k", ",", "i"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{
      "Taylor", " ", "expansion", " ", "of", " ", "unknown", " ", 
       "functions"}], "*)"}], 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"h_", ",", "j_"}], "]"}], ":=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"solrid2", "[", 
           RowBox[{"h", ",", "j"}], "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}], "*", 
         RowBox[{"Product", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{
               RowBox[{"esp", "[", 
                RowBox[{"h", ",", "j", ",", "k", ",", "i"}], "]"}], "!"}]}], 
             ")"}], "*", 
            RowBox[{
             RowBox[{"var", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "^", 
             RowBox[{"esp", "[", 
              RowBox[{"h", ",", "j", ",", "k", ",", "i"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n2"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"solrid", "[", 
            RowBox[{"h", ",", "j"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"tayl", "[", "h_", "]"}], ":=", 
      RowBox[{
       RowBox[{"inc0", "[", 
        RowBox[{"[", "h", "]"}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"s", "[", 
          RowBox[{"h", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "r"}], "}"}]}], "]"}]}]}], ";"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"inc", "[", 
         RowBox[{"[", "h", "]"}], "]"}], ",", "\"\< = \>\"", ",", 
        RowBox[{"tayl", "[", "h", "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"h", ",", "1", ",", "n1"}], "}"}]}], "]"}], "*)"}], "\n", 
   "]"}]}]}], "Input",
