 RowBox[{
  RowBox[{
   RowBox[{"Taylor", "[", 
    RowBox[{"f_", ",", "x_", ",", "x0_", ",", "r_"}], "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "mp", ",", "v1", ",", "vu", ",", "c", ",", "g", ",", "hg", 
       ",", "l", ",", "fac", ",", "pr", ",", "dein", ",", "ap", ",", "de", 
       ",", "sostfi"}], 
      RowBox[{"(*", 
       RowBox[{",", "tay"}], "*)"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "x", "]"}]}], ";", "\n", 
      RowBox[{"mp", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"in", "[", "i", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"v1", "=", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"mp", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "-", 
            RowBox[{"mp", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], "//", 
        "Flatten"}]}], ";", "\n", 
      RowBox[{"vu", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"mp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "0", ",", 
           RowBox[{"c", "[", "i", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"c", "[", "1", "]"}], "=", "r"}], ";", "\n", 
      RowBox[{
       RowBox[{"c", "[", "i_", "]"}], ":=", 
       RowBox[{
        RowBox[{"mp", "[", 
         RowBox[{"[", 
          RowBox[{"i", "-", "1"}], "]"}], "]"}], "/;", 
        RowBox[{"i", ">", "1"}]}]}], ";", "\n", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"w1_", ",", 
         RowBox[{"{", "z1__", "}"}]}], "]"}], ":=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"w1", ",", "z1"}], "]"}], ",", 
         RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\n", 
      RowBox[{"hg", "=", 
       RowBox[{"g", "[", 
        RowBox[{"v1", ",", "vu"}], "]"}]}], ";", "\n", 
      RowBox[{"l", "=", 
       RowBox[{"Length", "[", "hg", "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"fac", "[", "i_", "]"}], ":=", 
       RowBox[{"Product", "[", "\n", 
        RowBox[{
         RowBox[{"Factorial", "[", 
          RowBox[{"hg", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], ",", "\n", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"hg", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\n", 
      RowBox[{
       RowBox[{"pr", "[", "i_", "]"}], ":=", 
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "-", 
            RowBox[{"x0", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", 
          RowBox[{"hg", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"dein", "[", "i_", "]"}], ":=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"hg", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{
       RowBox[{"ap", "[", 
        RowBox[{"{", "q__", "}"}], "]"}], ":=", "q"}], ";", "\n", 
      RowBox[{
       RowBox[{"de", "[", "i_", "]"}], ":=", 
       RowBox[{"D", "[", 
        RowBox[{"f", ",", 
         RowBox[{"ap", "[", 
          RowBox[{"dein", "[", "i", "]"}], "]"}]}], "]"}]}], ";", "\n", 
      RowBox[{"sostfi", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "->", 
          RowBox[{"x0", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"tay", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", 
            RowBox[{"fac", "[", "i", "]"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"de", "[", "i", "]"}], "/.", "sostfi"}], ")"}], "*", 
          RowBox[{"pr", "[", "i", "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "l"}], "}"}]}], "]"}]}]}]}], "\n", "\n",
     "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Off", "[", 
