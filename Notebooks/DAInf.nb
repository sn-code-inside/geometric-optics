       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sys", "[", 
           RowBox[{"[", "h", "]"}], "]"}], "/.", "in"}], ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "1", ",", "n1"}], "}"}]}], "]"}], "]"}]}], ";", 
