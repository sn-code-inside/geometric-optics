 CellLabel->"In[14]:=",ExpressionUUID->"f5899ed7-71c8-0b44-b375-a8550f25c7be"],

Cell["\<\
If  Vi = (Ni-1)/(Nib-Nir) and \[Alpha]i = Nib-Nir, the above system becomes\
\>", "Text",
 CellChangeTimes->{{3.415509791023302*^9, 3.415509809867052*^9}, {
   3.415509854226427*^9, 3.415509947132677*^9}, 3.424965866171875*^9, {
