   3.425092313421875*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"1ac204e7-ddd6-b34c-860c-3e061667aa6e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"s1", "=", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eq11", ",", "eq12"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Xi]1", ",", "\[Xi]2"}], "}"}]}], "]"}], "]"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.415510266288927*^9, 3.415510290570177*^9}, {
  3.42496596815625*^9, 3.4249659711875*^9}, {3.424966638390625*^9, 
