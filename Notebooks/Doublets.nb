          "2"}], "]"}], ";", "\n", 
       RowBox[{"sf51", "=", "sfer5"}], ";", "\n", 
       RowBox[{"co51", "=", "coma5"}], ";", "\n", "\n", "\n", 
       RowBox[{"MarginalRayTracing", "[", 
