Cell[BoxData[
 RowBox[{"eqco", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Together", "[", 
     RowBox[{
      RowBox[{"Seidcoma", "[", "1", "]"}], "/.", "sost"}], "]"}], "//", 
