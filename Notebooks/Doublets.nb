Cell["Third-order project of a doublet", "Title",
 CellChangeTimes->{
  3.415509626632677*^9, {3.415509686304552*^9, 3.415509701210802*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.7803921568627451, 0.7803921568627451, 
   0.7803921568627451],ExpressionUUID->"e53cd7f5-61aa-994d-be39-009d8b8aec0a"],

Cell["\<\
First, we consider  a doublet of thin lenses and evaluate its focal length \
and the condition of axial chromatism\
\>", "Text",
 CellChangeTimes->{{3.415509791023302*^9, 3.415509809867052*^9}, {
   3.415509854226427*^9, 3.415509947132677*^9}, 3.424965866171875*^9, {
   3.42496614171875*^9, 3.424966174296875*^9}},
 FontFamily->"Times New Roman",
 FontSize->18,ExpressionUUID->"37caca9b-291a-cd4d-87d8-e0baaba78e0e"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "N1", ",", "1", ",", "N2", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "N1b", ",", "1", ",", "N2b", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "N1r", ",", "1", ",", "N2r", ",", "1"}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"waves", "=", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]", ",", "\[Lambda]b", ",", "\[Lambda]r"}], "}"}]}], 
    ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"TotalAberrations", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "c1"}], ",", " ", 
        RowBox[{"1", "/", "c2"}], ",", " ", 
        RowBox[{"1", "/", "c3"}], ",", " ", 
        RowBox[{"1", "/", "c4"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", "ind", 
      ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], ",",
       " ", "r", ",", " ", "0", ",", " ", "0", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "y1", ",", "\[Theta]", ",", " ", 
      "waves", ",", " ", "2"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.415509986835802*^9, 3.415510105648302*^9}, {
  3.424966202640625*^9, 3.424966214109375*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"86b7ce38-30c7-1e49-9678-cad05ad57c8e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"eq1", "=", 
  RowBox[{
   RowBox[{"Numerator", "[", 
    RowBox[{"Together", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"foc", "[", "1", "]"}]], "-", 
      FractionBox["1", "f"]}], "]"}], "]"}], "//", "Simplify"}]}], "\n", 
 RowBox[{"eq2", "=", 
  RowBox[{
   RowBox[{"Numerator", "[", 
    RowBox[{"Together", "[", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}]], "-", 
      FractionBox["1", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]]}], "]"}], "]"}], "//", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.415510112554552*^9, 3.415510257945177*^9}, {
  3.42496595096875*^9, 3.424965960265625*^9}, {3.42496601328125*^9, 
  3.4249660159375*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"ad41e100-e31d-7d42-af78-c4ecb7aa0620"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "1"}], "-", 
  RowBox[{"c3", " ", "f"}], "+", 
  RowBox[{"c4", " ", "f"}], "+", 
  RowBox[{"c1", " ", "f", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "N1"}], ")"}]}], "+", 
  RowBox[{"c2", " ", 
   RowBox[{"(", 
    RowBox[{"f", "-", 
     RowBox[{"f", " ", "N1"}]}], ")"}]}], "+", 
  RowBox[{"c3", " ", "f", " ", "N2"}], "-", 
  RowBox[{"c4", " ", "f", " ", "N2"}]}]], "Output",
 CellChangeTimes->{3.980478018320783*^9, 3.9962809107641144`*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"633c0e9a-c884-fd44-a24e-25bf4679f3a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"c1", " ", 
   RowBox[{"(", 
    RowBox[{"N1b", "-", "N1r"}], ")"}]}], "+", 
  RowBox[{"c2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "N1b"}], "+", "N1r"}], ")"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"c3", "-", "c4"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"N2b", "-", "N2r"}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.980478018320783*^9, 3.996280910787113*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"e917be4e-1442-cb48-9b88-e2347f1275bc"]
}, Open  ]],

Cell["\<\
By introducing the new variables \[Xi]1=(c1-c2)f, \[Xi]2=(c3-c4)f, the above \
equations become\
\>", "Text",
 CellChangeTimes->{{3.415509791023302*^9, 3.415509809867052*^9}, {
   3.415509854226427*^9, 3.415509947132677*^9}, 3.424965866171875*^9, {
