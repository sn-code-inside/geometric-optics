         RowBox[{"-", "Infinity"}], ",", " ", "y1", ",", " ", "angle", ",", 
         " ", "waves", ",", " ", "2"}], "]"}], ";", "\n", 
       RowBox[{"axcr1", "=", 
        RowBox[{
         RowBox[{"zog1", "[", 
