  3.4250094385*^9, 3.4250094454375*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"8343be1b-c5d1-3241-9ee3-1f9d983f8b1c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[Xi]1", "\[Rule]", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["V", "1"], "-", 
        SubscriptBox["V", "2"]}], ")"}], " ", 
      SubscriptBox["\[Alpha]", "1"]}]]}], ",", 
   RowBox[{"\[Xi]2", "\[Rule]", 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["V", "1"], "-", 
         SubscriptBox["V", "2"]}], ")"}], " ", 
