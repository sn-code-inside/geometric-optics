Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"Solve", "::", "ratnz"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Doublet", "[", 
     RowBox[{
     "thick_", ",", " ", "ind_", ",", " ", "diam_", ",", " ", "angle_", ",", 
      " ", "waves_", ",", " ", "focal_", ",", "sf_", ",", "co_", ",", "cr_"}],
      "]"}], " ", ":=", "\n", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"(*", 
        RowBox[{"e0", ",", "sol0", ",", "sol1", ",", "sol2", ",", "sol3"}], 
        "*)"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"TotalAberrations", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "c1"}], ",", " ", 
           RowBox[{"1", "/", "c2"}], ",", " ", 
           RowBox[{"1", "/", "c3"}], ",", " ", 
           RowBox[{"1", "/", "c4"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", "ind",
          ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], 
         ",", " ", 
         RowBox[{"diam", "/", "2"}], ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{"-", "Infinity"}], ",", " ", "y1", ",", " ", "angle", ",", 
         " ", "waves", ",", " ", "2"}], "]"}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Focal", " ", "length", " ", "in", " ", "the", " ", "variables", " ",
           "c1"}], ",", "c2", ",", "c3", ",", "c4"}], "*)"}], "\n", " ", "\n",
        "  ", 
       RowBox[{
        RowBox[{"e0", "[", "1", "]"}], " ", "=", " ", 
        RowBox[{
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"foc", "[", "1", "]"}]}], ")"}], " ", "-", " ", 
           RowBox[{"(", 
            RowBox[{"1", "/", "focal"}], ")"}]}], "]"}], " ", "//", " ", 
         "Numerator"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"(*", 
        RowBox[{
        "Back", " ", "focals", " ", "with", " ", "respect", " ", "to"}], " ", 
        "*)"}], "\n", "    ", 
       RowBox[{
        RowBox[{"e0", "[", "2", "]"}], " ", "=", 
        RowBox[{
         RowBox[{"Numerator", "[", 
          RowBox[{"Together", "[", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"zog1", "[", 
              RowBox[{"2", ",", "n"}], "]"}]], "-", 
            FractionBox["1", 
             RowBox[{"zog1", "[", 
              RowBox[{"3", ",", "n"}], "]"}]]}], "]"}], "]"}], "//", 
         "Simplify"}]}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"sol0", " ", "=", " ", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"e0", "[", "1", "]"}], " ", "==", " ", "0"}], ",", " ", 
             RowBox[{
              RowBox[{"e0", "[", "2", "]"}], " ", "==", " ", "0"}]}], "}"}], 
           ",", " ", 
           RowBox[{"{", 
            RowBox[{"c2", ",", "c4"}], "}"}]}], "]"}], " ", "//", " ", 
         "Flatten"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"(*", 
        RowBox[{"Spherical", " ", "aberration", " ", "and", " ", "coma"}], 
        "*)"}], "\n", "  ", 
       RowBox[{
        RowBox[{"e0", "[", "3", "]"}], " ", "=", 
        RowBox[{"Expand", "[", " ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"Seidsphe", "[", "1", "]"}], "]"}], "/.", "sol0"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"e0", "[", "4", "]"}], " ", "=", 
        RowBox[{"Expand", "[", " ", 
         RowBox[{
          RowBox[{"Simplify", "[", 
           RowBox[{"Seidcoma", "[", "1", "]"}], "]"}], "/.", "sol0"}], 
         "]"}]}], ";", "\n", "\[IndentingNewLine]", 
       RowBox[{"s1", "=", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"e0", "[", "3", "]"}], "\[Equal]", "0"}], ",", 
            RowBox[{
             RowBox[{"e0", "[", "4", "]"}], "\[Equal]", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c1", ",", "c3"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"tab", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"s1", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"s1", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "s1", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tab0", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{"tab", ",", 
          RowBox[{"{", 
           RowBox[{"_Real", ",", "_Real"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tab1", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"tab0", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"tab0", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "2"}], "]"}], "]"}], "^", "2"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "tab0", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"po", "=", 
        RowBox[{"Position", "[", 
         RowBox[{"tab1", ",", 
          RowBox[{"Min", "[", "tab1", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol2", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c1", "->", 
           RowBox[{
            RowBox[{"tab0", "[", 
             RowBox[{"[", 
              RowBox[{"po", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"c3", "\[Rule]", 
           RowBox[{
            RowBox[{"tab0", "[", 
             RowBox[{"[", 
              RowBox[{"po", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ";", "\n", 
       RowBox[{"sol1", "=", 
        RowBox[{"sol0", "/.", "sol2"}]}], ";", "\n", 
       RowBox[{"sol3", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"sol1", ",", "sol2"}], "]"}], "]"}]}], ";", "\n", "\n", 
       "\n", "  ", 
       RowBox[{"(*", 
        RowBox[{
        "Evaluation", " ", "of", " ", "the", " ", "radii", " ", "for", " ", 
         "not", " ", "vanishing", " ", "thickness"}], "*)"}], "\n", "  ", 
       RowBox[{"TotalAberrations", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "c11"}], ",", " ", 
           RowBox[{"1", "/", "c12"}], ",", " ", 
           RowBox[{"1", "/", "c13"}], ",", " ", 
           RowBox[{"1", "/", "c14"}]}], "}"}], ",", " ", "thick", ",", " ", 
         "ind", ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
         RowBox[{"diam", "/", "2"}], ",", " ", "0", ",", " ", "0", ",", " ", 
         RowBox[{"-", "Infinity"}], ",", " ", "y1", ",", " ", "angle", ",", 
         " ", "waves", ",", " ", "2"}], "]"}], ";", "\n", 
       RowBox[{"sol4", "=", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
            RowBox[{
             RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"zog1", "[", 
               RowBox[{"2", ",", "n"}], "]"}], "-", 
              RowBox[{"zog1", "[", 
               RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", "0"}], ",", 
            RowBox[{
             RowBox[{"foc", "[", "1", "]"}], "\[Equal]", "focal"}]}], "}"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"c11", ",", 
            RowBox[{"sol3", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c12", ",", 
            RowBox[{"sol3", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c13", ",", 
            RowBox[{"sol3", "[", 
             RowBox[{"[", 
              RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c14", ",", 
            RowBox[{"sol3", "[", 
             RowBox[{"[", 
              RowBox[{"4", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", "\n", " ", 
       RowBox[{"TotalAberrations", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", 
            RowBox[{"sol4", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"1", "/", 
            RowBox[{"sol4", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", " ", 
           RowBox[{"1", "/", 
            RowBox[{"sol4", "[", 
             RowBox[{"[", 
