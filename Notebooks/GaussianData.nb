          FractionBox[
           RowBox[{
            RowBox[{"ind", "[", 
             RowBox[{"[", "1", "]"}], "]"}], 
            RowBox[{"zo1", "[", "1", "]"}]}], 
           RowBox[{
            RowBox[{"ind", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "dobject"}]], "hobject"}]}]}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "1"}], ",", 
       RowBox[{"Goto", "[", "5", "]"}], ",", 
       RowBox[{"Goto", "[", "4", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Label", "[", "4", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"zo", "[", "2", "]"}], "=", 
      RowBox[{
       RowBox[{"zo1", "[", "1", "]"}], "-", 
       RowBox[{"thick", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yo", "[", "2", "]"}], "=", 
      RowBox[{"yo1", "[", "1", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"zo1", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"rad", "[", 
                RowBox[{"[", "i", "]"}], "]"}]], "-", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "i", "]"}], "]"}], 
               RowBox[{"zo", "[", "i", "]"}]]}], "==", 
             RowBox[{
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], 
               RowBox[{"rad", "[", 
                RowBox[{"[", "i", "]"}], "]"}]], "-", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"i", "+", "1"}], "]"}], "]"}], "inc"]}]}], ",", 
            "inc"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"yo1", "[", "i", "]"}], "=", 
