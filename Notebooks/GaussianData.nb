            RowBox[{"ind", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}], 
            RowBox[{"zo", "[", "i", "]"}]}]], 
          RowBox[{"yo", "[", "i", "]"}]}]}], ";", 
        RowBox[{
         RowBox[{"yo", "[", 
          RowBox[{"i", "+", "1"}], "]"}], "=", 
         RowBox[{"yo1", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"zo", "[", 
          RowBox[{"i", "+", "1"}], "]"}], "=", 
         RowBox[{
          RowBox[{"zo1", "[", "i", "]"}], "-", 
          RowBox[{"spe", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}]}], " ", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Label", "[", "5", "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Gaussian image height = \>\"", ",", 
       RowBox[{"yo1", "[", "n", "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Petzval", "'"}], "s", " ", "curvature"}], " ", "*)"}], "\n", 
     RowBox[{"cpz", "=", 
      RowBox[{
       RowBox[{"ind", "[", 
        RowBox[{"[", 
         RowBox[{"n", "+", "1"}], "]"}], "]"}], 
       RowBox[{"(", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"rad", "[", 
