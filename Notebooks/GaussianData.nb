Notebook[{

Cell[CellGroupData[{
Cell["Gaussian Data of a Centered Optical System", "Title",
 CellChangeTimes->{{3.41015063340625*^9, 3.41015065996875*^9}, 
   3.413807277671875*^9},
 Background->GrayLevel[0.871107]],

Cell["\<\
The program gives:
- the positions of the principal planes;
- the positions of the entrance and exit pupils;
- the focal length;
- the distance of the object plane from the last surface;
- the linear magnification, if the object is at a finite distance from the \
first  surface;
- the angular amplification, if the object is at infinity;
- the Petzval radius.



The input data are:
- rad = the list of the radii of the surfaces constituting the system;
- thick = the list of the distances between one surface and the next one (the \

              distance is positive if the light goes from the left hand side \
to the right hand side 
              and negative in the opposite case;
              
  - ind = the list of refractive indices for green light;
  - stopradius = radius of the aperture stop;
  - nstop= number of the surfaces before the aperture stop;
  -dis = distance of the aperture stop from the last surface before it;
-  dobject = distance of the object from the first surface;
- hobject = height of the object if it is at a finite distance;
- angle = the field angle, if the object is at infinity.

\
\>", "Section",
 CellChangeTimes->{{3.4101506855*^9, 3.41015072871875*^9}, {3.412779139*^9, 
  3.412779216375*^9}, {3.412779297109375*^9, 3.412779315453125*^9}, {
  3.412779373640625*^9, 3.41277945396875*^9}, {3.412781901421875*^9, 
  3.4127819985625*^9}, {3.412782043875*^9, 3.412782158546875*^9}},
 Background->RGBColor[1, 1, 0]],

Cell[CellGroupData[{

Cell["\<\
The program GlobalGaussianData
\
\>", "Section",
 CellChangeTimes->{{3.410150745515625*^9, 3.410150759203125*^9}},
 Background->RGBColor[0, 1, 0]],

Cell[BoxData[{
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell"}], "]"}], "\n", 
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "spell1"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"FindRoot", "::", "lstol"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GaussianData", "[", 
   RowBox[{
   "rad_", ",", "thick_", ",", "ind_", ",", "stopradius_", ",", "nstop_", ",",
     "dis_", ",", "dobject_", ",", "hobject_", ",", "angle_"}], "]"}], ":=", 
  "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"h", ",", "i", ",", "j", ",", "k"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     StyleBox[
      RowBox[{"Gaussian", " ", "analysis"}],
      FontFamily->"Times New Roman",
      FontSize->24,
      FontColor->RGBColor[0, 0, 1]], 
     StyleBox[" ",
      FontColor->RGBColor[0, 1, 0]], "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rad", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ku", "=", "nstop"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
       "Power", " ", "of", " ", "the", " ", "surfaces", " ", "and", " ", 
        "rotation", " ", "matrices"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"P", "[", "i", "]"}], "=", 
         FractionBox[
          RowBox[{
           RowBox[{"ind", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
           RowBox[{"ind", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], 
          RowBox[{"rad", "[", 
           RowBox[{"[", "i", "]"}], "]"}]]}], ";", "\n", 
        RowBox[{
         RowBox[{"R0", "[", "i", "]"}], "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             FractionBox[
              RowBox[{"-", 
               RowBox[{"P", "[", "i", "]"}]}], 
              RowBox[{"ind", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]], ",", 
             FractionBox[
              RowBox[{"ind", "[", 
               RowBox[{"[", "i", "]"}], "]"}], 
              RowBox[{"ind", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]]}], "}"}]}], "}"}]}]}], 
       ",", "\n", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", "\n", 
     "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "1"}], ",", 
       RowBox[{"Goto", "[", "1", "]"}], ",", 
       RowBox[{"Goto", "[", "2", "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Label", "[", "1", "]"}], ";", "\n", 
     RowBox[{"Mt", "=", 
      RowBox[{"R0", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"Men", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"R0", "[", "1", "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Mex", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", 
        RowBox[{"R0", "[", "1", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Goto", "[", "3", "]"}], ";", "\n", "\n", 
     RowBox[{"Label", "[", "2", "]"}], ";", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
        RowBox[{"Total", " ", "matrix", " ", "of", " ", "the", " ", "i"}], 
        "-", 
        RowBox[{"th", " ", "surface"}]}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D0", "[", "i", "]"}], "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"thick", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"B0", "[", "i", "]"}], "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", "<", "n"}], ",", 
          RowBox[{
           RowBox[{"D0", "[", "i", "]"}], ".", 
           RowBox[{"R0", "[", "i", "]"}]}], ",", 
          RowBox[{"R0", "[", "n", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
        RowBox[{"Matrices", " ", "of", " ", "the", " ", "sub"}], "-", 
        "systems"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"b", "[", "1", "]"}], "=", 
         RowBox[{"B0", "[", "1", "]"}]}], ";", "\n", 
        RowBox[{
         RowBox[{"b", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"B0", "[", "i", "]"}], ".", 
          RowBox[{"b", "[", 
           RowBox[{"i", "-", "1"}], "]"}]}]}]}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{"Total", " ", "matrix", " ", "of", " ", "the", " ", "system"}],
       
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\n", 
     RowBox[{"Mt", "=", 
      RowBox[{"b", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
       "Matrix", " ", "of", " ", "the", " ", "ku", " ", "surfaces", " ", 
        "before", " ", "the", " ", "stop"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\n", 
     RowBox[{"Men", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"R0", "[", "ku", "]"}], ".", 
         RowBox[{"b", "[", 
          RowBox[{"ku", "-", "1"}], "]"}]}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
       "Matrix", " ", "of", " ", "the", " ", "surfaces", " ", "following", 
        " ", "the", " ", "stop"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"bex", "[", 
          RowBox[{"ku", "+", "1"}], "]"}], "=", 
         RowBox[{
          RowBox[{"D0", "[", 
           RowBox[{"ku", "+", "1"}], "]"}], ".", 
          RowBox[{"R0", "[", 
           RowBox[{"ku", "+", "1"}], "]"}]}]}], ";", "\n", 
        RowBox[{
         RowBox[{"bex", "[", "i", "]"}], "=", 
         RowBox[{
          RowBox[{"B0", "[", "i", "]"}], ".", 
          RowBox[{"bex", "[", 
           RowBox[{"i", "-", "1"}], "]"}]}]}]}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"ku", "+", "2"}], ",", "n"}], "}"}]}], "]"}], ";", "\n", 
     RowBox[{"Mex", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "n"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ku", "\[Equal]", "0"}], "&&", 
           RowBox[{"n", "\[Equal]", "1"}]}], ",", 
          RowBox[{"R0", "[", "1", "]"}], ",", 
          RowBox[{"bex", "[", "n", "]"}]}], "]"}]}], "]"}]}], ";", "\n", "\n",
      "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
        RowBox[{
        "Distances", " ", "of", " ", "the", " ", "principal", " ", "planes", 
         " ", "from", " ", "the", " ", "first", " ", "and", " ", "last", " ", 
         "surface"}], ",", " ", "respectively"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"Label", "[", "3", "]"}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"zp", "=", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"Mt", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], 
         RowBox[{"Mt", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "+", 
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{
         RowBox[{"Mt", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], 
         RowBox[{"Mt", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], 
       RowBox[{"Mt", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]]}], ";", "\n", 
     RowBox[{"z1p", "=", 
      FractionBox[
       RowBox[{"1", "-", 
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}]}], 
       RowBox[{"Mt", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance of the first principal plane from the first surface = \
\>\"", ",", 
       RowBox[{"zp", "//", "N"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance of the second principal plane from the last surface = \
\>\"", ",", 
       RowBox[{"z1p", "//", "N"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
        RowBox[{
        "Distances", " ", "of", " ", "the", " ", "pupil", " ", "planes", " ", 
         "from", " ", "the", " ", "first", " ", "and", " ", "last", " ", 
         "surface"}], ",", " ", "respectively"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"we", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", "dis", ",", 
        FractionBox[
         RowBox[{
          RowBox[{
           RowBox[{"Men", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "dis"}], "+", 
          RowBox[{"Men", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], 
         RowBox[{
          RowBox[{
           RowBox[{"Men", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}], "dis"}], "+", 
          RowBox[{"Men", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}]]}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance of the entrance pupil from the first surface = \>\"", ",",
        
       RowBox[{"we", "//", "N"}]}], "]"}], ";", "\n", 
     RowBox[{"dex", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", "dis", ",", 
        RowBox[{"dis", "-", 
         RowBox[{"thick", "[", 
          RowBox[{"[", "ku", "]"}], "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{"we1", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "n"}], ",", "dis", ",", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Mex", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "dex"}], "-", 
           RowBox[{"Mex", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], 
          RowBox[{
           RowBox[{
            RowBox[{"Mex", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], "dex"}], "-", 
           RowBox[{"Mex", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}]]}]}], "]"}]}], ";", "\n",
      
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance of the exit pupil from the last surface = \>\"", ",", 
       RowBox[{"we1", "//", "N"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
       "Magnification", " ", "relative", " ", "to", " ", "the", " ", 
        "pupils"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"me", "=", 
      RowBox[{
       RowBox[{"Mt", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "we1"}]}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Magnification between the pupils = \>\"", ",", 
       RowBox[{"me", "//", "N"}]}], "]"}], ";", "\n", 
     RowBox[{"yen", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ku", "\[Equal]", "0"}], ",", "stopradius", ",", 
        FractionBox["stopradius", 
         RowBox[{
          RowBox[{"Men", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"Men", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}], "dis"}]}]]}], "]"}]}], 
     ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of the entrance pupil = \>\"", ",", "yen"}], "]"}], 
     ";", "\n", 
     RowBox[{"mex", "=", 
      RowBox[{
       RowBox[{"Mex", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"Mex", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "we1"}]}]}], ";", "\n", 
     RowBox[{"yex", "=", 
      RowBox[{"mex", " ", "stopradius"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of exit pupil = \>\"", ",", "yex"}], "]"}], ";", 
     "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{"Focal", " ", "length"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"foc", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], 
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}]]}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Back focal = \>\"", ",", 
       RowBox[{"foc", "//", "N"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Focal length = \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"foc", "-", "z1p"}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", 
      StyleBox[
       RowBox[{
       "Distance", " ", "of", " ", "the", " ", "image", " ", "from", " ", 
        "the", " ", "last", " ", "surface"}],
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"z1n", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dobject", "===", 
         RowBox[{"-", "Infinity"}]}], ",", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"Mt", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], 
          RowBox[{"Mt", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "1"}], "]"}], "]"}]]}], ",", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{
            RowBox[{"Mt", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], "dobject"}], "-", 
           RowBox[{"Mt", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], 
          RowBox[{
           RowBox[{
            RowBox[{"Mt", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1"}], "]"}], "]"}], " ", "dobject"}], "-", 
           RowBox[{"Mt", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}]]}]}], "]"}]}], ";", "\n",
      
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Distance of the image from the last surface = \>\"", ",", 
       RowBox[{"z1n", "//", "N"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Mag", "=", 
      RowBox[{
       RowBox[{"Mt", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{
        RowBox[{"Mt", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "z1n"}]}]}], ";", "\n", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dobject", "=!=", 
        RowBox[{"-", "Infinity"}]}], ",", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Paraxial magnification = \>\"", ",", "Mag"}], "]"}]}], 
      "]"}], ";", "\n", "\n", "\n", "\n", 
     RowBox[{"(*", " ", 
      StyleBox[
       RowBox[{"Gaussian", " ", "data"}],
       FontColor->RGBColor[0, 0, 1]], 
      StyleBox[" ",
       FontColor->RGBColor[0, 0, 1]], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"spe", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"thick", ",", 
        RowBox[{"{", "0", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dobject", "===", 
        RowBox[{"-", "Infinity"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"zo1", "[", "1", "]"}], "=", 
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             FractionBox[
              RowBox[{"ind", "[", 
               RowBox[{"[", "1", "]"}], "]"}], 
              RowBox[{"rad", "[", 
               RowBox[{"[", "1", "]"}], "]"}]], "==", 
             RowBox[{
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "2", "]"}], "]"}], 
               RowBox[{"rad", "[", 
                RowBox[{"[", "1", "]"}], "]"}]], "-", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "inc"]}]}], ",", "inc"}], 
           "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1", ",", "2"}], "]"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"yo1", "[", "1", "]"}], "=", 
         RowBox[{
          RowBox[{"ind", "[", 
           RowBox[{"[", "1", "]"}], "]"}], 
          RowBox[{"zo1", "[", "1", "]"}], "*", "angle", "*", 
          FractionBox["\[Pi]", "180"]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"zo1", "[", "1", "]"}], "=", 
         RowBox[{
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "1", "]"}], "]"}], 
               RowBox[{"rad", "[", 
                RowBox[{"[", "1", "]"}], "]"}]], "-", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "dobject"]}], "==", 
             RowBox[{
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "2", "]"}], "]"}], 
               RowBox[{"rad", "[", 
                RowBox[{"[", "1", "]"}], "]"}]], "-", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "inc"]}]}], ",", "inc"}], 
