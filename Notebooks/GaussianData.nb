            RowBox[{
             FractionBox["1", 
              RowBox[{"ind", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}]], "-", 
             FractionBox["1", 
              RowBox[{"ind", "[", 
               RowBox[{"[", "i", "]"}], "]"}]]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ")"}]}]}], ";", 
     "\n", 
     RowBox[{"rpz", "=", 
      RowBox[{"1", "/", "cpz"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Petval radius = \>\"", ",", "rpz"}], "]"}], ";"}]}], "\n", 
   "\[IndentingNewLine]", "\n", "\n", "]"}]}], "\n"}], "Input",
