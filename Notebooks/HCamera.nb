Cell[CellGroupData[{

Cell["Houghton's Camera", "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.750011],ExpressionUUID->"7a86119d-226b-af42-a3ca-cfead6a28edf"],

Cell[TextData[{
 "The Houghton Camera is formed by an afocal doublet ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "c2f604e2-456c-494b-8b1f-f805a8d72c75"],
 " of two thin lenses of the same glass, having the task to eliminate the \
spherical aberration and coma of the primary mirror ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "965d1ff5-d787-3b48-acad-52783044d131"],
 ". Since ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "ed8687be-3dc3-284a-a111-5b85e10af36f"],
 " does not introduce astigmatism, there is no possibility to control the \
astigmatism due to the primary mirror. Therefore, this aberration depends \
only on the distance \[Delta]",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "35a7777a-4aa6-d547-a430-32f3753ea148"],
 " of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "1955140d-fa3c-c84c-9867-e5ace0d3e7e0"],
 " from ",
 Cell[BoxData[
  FormBox["S", TraditionalForm]],ExpressionUUID->
  "56d07323-df65-8145-8a48-627b28be5357"],
 " (see Figure). \n\n\n\n",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
1:eJzt201qk2EUhuH4M3DoCgQFN+DIqUOnFRfQYi1OKrSCuAc3VTemCVKStu+X
