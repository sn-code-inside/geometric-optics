Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Input", " ", 
    RowBox[{"data", ":", "\n", "f"}]}], "         ", "=", " ", 
   RowBox[{"focal", " ", "of", " ", "the", " ", "mirror"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spes", " ", "=", " ", 
   RowBox[{"thickness", " ", "list"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diam", " ", "=", " ", 
   RowBox[{"diameter", " ", "of", " ", "corrector"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Delta]", "         ", "=", " ", 
   RowBox[{
   "distance", " ", "between", " ", "the", " ", "corrector", " ", "and", " ", 
    "the", " ", "mirror"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Ni", "       ", "=", " ", 
   RowBox[{"refractive", " ", "index", " ", "of", " ", "corrector"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Theta]", "         ", "=", " ", 
   RowBox[{"field", " ", "angle"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sf", "       ", "=", " ", 
   RowBox[{"balance", " ", "spherical", " ", "aberration"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"co", "       ", "=", " ", 
   RowBox[{"balance", " ", "coma"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cr", "        ", "=", " ", 
   RowBox[{"balance", " ", "chromatism"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9800664918179646`*^9, 3.980066521048233*^9}, {
   3.980066605769039*^9, 3.9800666064085617`*^9}, {3.980126621129299*^9, 
   3.98012664634845*^9}, 3.9807377579003468`*^9},
 FontSize->16,ExpressionUUID->"dd4a1292-ebfc-b04d-a07d-c4110755ca9c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HCamera3", "[", 
   RowBox[{
   "f_", ",", "thick_", ",", "ind_", ",", "diam_", ",", "\[Alpha]_", ",", 
    "waves_", ",", "sf_", ",", "co_", ",", "cr_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "K", ",", "A1", ",", "A2", ",", "r11", ",", "r12", ",", "sol3", ",", 
      "ra1", ",", "pl"}], "}"}], ",", "\n", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Delta]", "=", 
      RowBox[{
       RowBox[{"thick", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "/", "f"}]}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"K", "=", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", "\[Delta]"}], ")"}], "2"], 
        SuperscriptBox["\[Delta]", "2"]]}]}], ";", "\n", 
     RowBox[{"A1", "=", 
      FractionBox[
       RowBox[{"1", "-", "\[Delta]"}], 
       RowBox[{"8", " ", 
        SuperscriptBox["f", "3"], " ", 
        SuperscriptBox["\[Delta]", "2"]}]]}], ";", "\n", 
     RowBox[{"A2", "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "2"}], "+", "\[Delta]"}], 
        RowBox[{"4", " ", 
         SuperscriptBox["f", "2"], " ", "\[Delta]"}]]}]}], ";", "\n", 
     RowBox[{"r11", "=", 
      FractionBox[
       RowBox[{"2", " ", "A1", " ", "A2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["Ni", "2"]}], ")"}]}], 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", 
         SuperscriptBox["A1", "2"]}], "-", 
        RowBox[{"2", " ", 
         SuperscriptBox["A1", "2"], " ", "Ni"}], "+", 
        RowBox[{
         SuperscriptBox["A2", "3"], " ", "Ni"}], "-", 
        RowBox[{
         SuperscriptBox["A2", "3"], " ", 
         SuperscriptBox["Ni", "2"]}]}]]}], ";", "\n", 
     RowBox[{"r12", "=", 
      FractionBox[
       RowBox[{"2", " ", "A1", " ", "A2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["Ni", "2"]}], ")"}]}], 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["A1", "2"]}], "+", 
        RowBox[{"2", " ", 
         SuperscriptBox["A1", "2"], " ", "Ni"}], "+", 
        RowBox[{
         SuperscriptBox["A2", "3"], " ", "Ni"}], "-", 
        RowBox[{
         SuperscriptBox["A2", "3"], " ", 
         SuperscriptBox["Ni", "2"]}]}]]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r11", ",", "r12", ",", 
         RowBox[{"-", "r11"}], ",", 
         RowBox[{"-", "r12"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "K"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"sf31", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"co31", "=", 
      RowBox[{"Comatot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"aa1", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\[IndentingNewLine]", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r11", ",", "r12", ",", 
         RowBox[{"-", "r11"}], ",", 
         RowBox[{"-", "r12"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "K"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"sf51", "=", "sfer5"}], ";", "\n", 
