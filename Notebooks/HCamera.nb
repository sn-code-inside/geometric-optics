Cell[CellGroupData[{

Cell["The program Buchroeder ", "Title",
 CellChangeTimes->{{3.43228489409375*^9, 3.43228490090625*^9}},
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"58450024-618e-514f-b066-02cd9a58a808"],

Cell["\<\
In this design the corrector is formed by trhee thin lenses located at the \
center of  curvature of the primary mirror. Consequently, the camera is as \
long as a Schmidt's camera. The three lenses are made by BK7. Moreover, tha \
rays verify the conditions:
R2=Infinity, R3= - R1, R4 = R1, R5 = Infinity, R6 = - R1 so that just one \
curvature ray is free and it is chosen to eliminate the spherical aberration. \
The corrector is afocal and the astigmatism and coma vanish when the lenses \
have no thickness. The chromatism is controlled when the thickness of the \
lenses is introduced.\
\>", "Text",
 CellChangeTimes->{{3.43228457121875*^9, 3.432284608625*^9}, {
  3.43228464803125*^9, 3.432284670828125*^9}},
 FontSize->18,
 Background->RGBColor[
  0.768627, 0.976471, 
   1],ExpressionUUID->"dc3af10b-efc0-9c4d-a469-cf2241b08e76"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{"The", " ", "corrector"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"rad", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "c1"}], ",", "Infinity", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "c1"}], ",", 
       RowBox[{"1", "/", "c1"}], ",", "Infinity", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "c1"}]}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"thick", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
       "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1", ",", "Ni", ",", "1"}], 
       "}"}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"costasf", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stoprad", " ", "=", "r"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"waves", "=", 
     RowBox[{"{", "\[Lambda]", "}"}]}], ";"}], "\n", 
   RowBox[{"TotalAberrations", "[", 
    RowBox[{
    "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
     "0", ",", 
     RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", ",", 
     "0"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.43228469265625*^9, 3.432284841546875*^9}, {
  3.432284872828125*^9, 
  3.43228488165625*^9}},ExpressionUUID->"9cbf69bc-25a8-d14d-8aff-\
9cc1c4bd3869"],

Cell[BoxData[
 RowBox[{"foc", "[", "1", "]"}]], "Input",
 CellChangeTimes->{{3.43228486225*^9, 
  3.432284862875*^9}},ExpressionUUID->"3e615c00-6aea-b143-a368-d328c04014a0"],

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Seidsphe", "[", "1", "]"}], "-", 
     FractionBox["1", 
      RowBox[{"32", 
       SuperscriptBox["f", "3"]}]]}], "\[Equal]", "0"}], ",", "c1"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.43228496934375*^9, 
  3.432285005625*^9}},ExpressionUUID->"58b27854-78ad-1b45-a934-5e8f65a4c0c4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"RowReduce", "::", "luc"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Buchroeder", "[", 
   RowBox[{
   "f_", ",", "thick_", ",", "ind_", ",", "diam_", ",", "\[Alpha]_", ",", 
    "waves_", ",", "sf_", ",", "co_", ",", "cr_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", 
    RowBox[{
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "/", "diam"}], "\[GreaterEqual]", "3"}], ",", "0.8", 
        ",", 
        RowBox[{"3", ">", 
         RowBox[{"f", "/", "diam"}], ">=", "2.5"}], ",", "0.6", ",", 
        RowBox[{
         RowBox[{"f", "/", "diam"}], "<", "2.5"}], ",", "0.8"}], "]"}]}], ";",
      "\n", 
     RowBox[{"DS1", "=", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"32", " ", 
         SuperscriptBox["f", "3"], " "}]]}]}], ";", "\n", 
     RowBox[{"R10", "=", 
      FractionBox[
       RowBox[{"2", " ", 
        SuperscriptBox["2", 
         RowBox[{"1", "/", "3"}]], " ", "f", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "Ni"}], ")"}], 
         RowBox[{"2", "/", "3"}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "Ni"}], ")"}], 
         RowBox[{"1", "/", "3"}]]}], 
       SuperscriptBox["Ni", 
        RowBox[{"1", "/", "3"}]]]}], ";", "\n", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", "R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"sf31", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"co31", "=", 
      RowBox[{"Comatot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"ast31", "=", 
      RowBox[{"Asttot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"aa1", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", "R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"sf51", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co51", "=", "coma5"}], ";", "\n", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", "R10", ",", "Infinity", ",", 
         RowBox[{"-", "R10"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"margcr", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Final", " ", "calculations"}], " ", "*)"}], "\n", 
     RowBox[{"thick1", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"thick", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "5", "]"}], "]"}], ",", "\[Delta]a"}], "}"}]}], ";", 
     "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "cu1"}], ",", "Infinity", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "cu1"}], ",", 
         RowBox[{"1", "/", "cu1"}], ",", "Infinity", ",", 
         RowBox[{"1", "/", "cu2"}], ",", 
         RowBox[{"1", "/", "cu3"}]}], "}"}], ",", "thick1", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"sol2", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", "sf"}], "  ", "sf51"}]}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"zog1", "[", 
              RowBox[{"2", ",", "n"}], "]"}], "-", 
             RowBox[{"zog1", "[", 
              RowBox[{"3", ",", "n"}], "]"}]}], ")"}], "\[Equal]", 
           RowBox[{"aa1", "-", 
            RowBox[{"cr", " ", "margcr"}]}]}], ",", 
          RowBox[{
           RowBox[{"foc", "[", "1", "]"}], "\[Equal]", 
           RowBox[{"-", "f"}]}], ",", 
          RowBox[{
           RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", "co"}], " ", "co51"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cu1", ",", 
          RowBox[{"1", "/", "R10"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cu2", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "R10"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cu3", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "f"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Delta]a", ",", 
          RowBox[{"2", "f"}]}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{"thick2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"thick", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", 
        RowBox[{"thick", "[", 
         RowBox[{"[", "5", "]"}], "]"}], ",", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "2"}], "]"}], "]"}]}], "}"}]}], ";", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "Infinity", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "Infinity", ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", "thick2", 
       ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"sf52", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co52", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "Infinity", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", "Infinity", ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", "thick2", 
       ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"margcrf", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"znu", "[", "2", "]"}], "-", 
        RowBox[{"znu", "[", "3", "]"}]}], ")"}]}], ";", "\n", 
     RowBox[{
     "Print", "[", "\"\<The radii of Buchroeder doublet are:\>\"", "]"}], ";",
      "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r1 = \>\"", ",", 
       RowBox[{"1", "/", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r2 = \>\"", ",", "\[Infinity]"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r3 = \>\"", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r4 = \>\"", ",", 
       RowBox[{"1", "/", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r5 = \>\"", ",", "\[Infinity]"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<r6 = \>\"", ",", 
       RowBox[{"1", "/", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<The radius of mirror = \>\"", ",", 
       RowBox[{"1", "/", 
        RowBox[{"sol2", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Distance between corrector and mirror = \>\"", ",", 
       RowBox[{"sol2", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", "2"}], "]"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<3rd-order sph. aberr. = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<5th-ord sph. aberr. = \>\"", ",", "sf52"}], "]"}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<3rd-order coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
