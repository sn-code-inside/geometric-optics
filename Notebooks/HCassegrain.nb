Cell[TextData[{
 "Spherical aberration and coma coefficients of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "984e8ead-73fd-a540-9c87-8abe74ebd94e"],
 " write:\n\nDC1 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Ni", "+", "1"}], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}], "2"]}], 
      RowBox[{"4", "Ni"}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["c", "1"], "-", 
        SubscriptBox["c", "2"]}], ")"}], "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "1"], "+", 
       SubscriptBox["c", "2"]}], ")"}]}], ","}], TraditionalForm]],
  ExpressionUUID->"867aa742-f9b0-de4c-909f-5da37307d595"],
 "\n\nDC2 = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["Ni", "2"], "-", "1"}], 
      RowBox[{"2", "Ni"}]]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        SubscriptBox["c", "1"], "2"], "-", 
       SuperscriptBox[
        SubscriptBox["c", "2"], "2"]}], ")"}], "."}]}], TraditionalForm]],
  ExpressionUUID->"2d0e8b77-4cb0-934d-a1be-c73daebadcae"],
 "\n\nIn Chapter 5 it is proved that the curvature radii ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "1"], ",", " ", 
    SubscriptBox["R", "2"], ",", " ", 
    RowBox[{"-", 
     SubscriptBox["R", "1"]}], ",", " ", 
    RowBox[{"-", 
     SubscriptBox["R", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "63f62d54-832b-af47-a6a3-03fbdbd17fd8"],
 " of the two lenses of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "81000656-c05f-9d41-b466-bd8764bda510"],
 ", which eliminate spherical aberration and coma\n\nDS1 + DC1 = 0,\nDS2 + \
DC2 = 0,\n\nsatisfy an equivalent first degree system\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], "-", 
      SubscriptBox["c", "2"]}], "=", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "DS1"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}], "DS2"}]]}]}], ",", "\n", 
    RowBox[{
     RowBox[{
      SubscriptBox["c", "1"], "+", 
      SubscriptBox["c", "2"]}], "=", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Ni", " ", 
        SuperscriptBox["DS2", "2"]}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Ni", "+", "1"}], ")"}], "DS1"}]]}]}], ","}], 
   TraditionalForm]],ExpressionUUID->"d6d81559-5cab-c740-b6b0-ac1867f5ce60"],
 "\n\nwhose solutions, in terms of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "b6727f7c-ab16-c64e-9239-c42e21c1e34d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "ffb60425-3917-d047-8303-11053c98a192"],
 ", are\n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["R", "1"], "=", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
        RowBox[{
         RowBox[{"2", 
          SuperscriptBox["DS1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"Ni", "+", "1"}], ")"}]}], " ", "+", " ", 
         RowBox[{
          SuperscriptBox["DS2", "3"], " ", 
          RowBox[{"Ni", "(", 
           RowBox[{"Ni", "-", "1"}], ")"}]}]}]]}]}], ",", 
     "                                     ", 
     RowBox[{"(", "1", ")"}]}], "     "}], TraditionalForm], "\n", 
  FormBox[
   RowBox[{
    SubscriptBox["R", "2"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["DS1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{"Ni", "+", "1"}], ")"}]}], " ", "-", " ", 
       RowBox[{
        SuperscriptBox["DS2", "3"], " ", 
        RowBox[{"Ni", "(", 
         RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "."}]}], TraditionalForm]}],
  ExpressionUUID->"5ba96c5e-0640-9b41-88d3-751d4fdc0d78"],
 "\n\nWhen expressions  relative to DS1 and DS2 are taken into account, the \
following relations are derived:"
}], "Text",
 CellChangeTimes->{3.414238530953125*^9},
 FontSize->18,ExpressionUUID->"d3b455bf-aec8-424f-b90f-cd2aef35b5a7"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"R1", "=", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
        RowBox[{
         RowBox[{"2", 
          SuperscriptBox["DS1", "2"], 
          RowBox[{"(", 
           RowBox[{"Ni", "+", "1"}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["DS2", "3"], "Ni", 
          RowBox[{"(", 
           RowBox[{"Ni", "-", "1"}], ")"}]}]}]]}], "//", "Simplify"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"R2", "=", 
     RowBox[{
      FractionBox[
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["DS1", "2"], 
         RowBox[{"(", 
          RowBox[{"Ni", "+", "1"}], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox["DS2", "3"], "Ni", 
         RowBox[{"(", 
          RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "//", "Simplify"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"e73209e3-66b3-a440-99c0-7103942a8f4e"],

Cell[TextData[{
 "In order to understand the behavior of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "991d18ec-59ad-3947-810f-6f2dd647930d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "bcec9e7d-6d58-e344-b406-32d6dd2ac721"],
 " with respect to \[Delta], the plots of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "1"], "=", 
    RowBox[{
     SubscriptBox["R", "1"], "/", 
     SubscriptBox["f", "1"]}]}], TraditionalForm]],ExpressionUUID->
  "678feeaa-7e05-4840-b227-522e040d1d04"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "2"], "="}], TraditionalForm]],ExpressionUUID->
  "306fc2c8-c92d-4d43-9015-a3768338cf9e"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["R", "2"], "/", 
    SubscriptBox["f", "1"]}], TraditionalForm]],ExpressionUUID->
  "90cb4d08-0069-7c40-8943-f41eba576423"],
 " versus \[Delta] is considered for BK7 (Ni = 1.5187228), ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "3"}], TraditionalForm]],ExpressionUUID->
  "296d5ca5-7a89-8b40-96f7-75998a550235"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "=", "4"}], TraditionalForm]],ExpressionUUID->
  "d50dec34-e12a-464b-99dd-2783e4224792"],
 "  (the blue line refers to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "0977f7b5-2d66-9643-9003-543cb020e103"],
 "):"
}], "Text",
 CellChangeTimes->{{3.414240345828125*^9, 3.414240346765625*^9}},
 FontSize->18,ExpressionUUID->"b0afa13e-3962-fa47-ae3f-647bee086b06"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r1", "=", 
   RowBox[{"-", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", "f1"], 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
        RowBox[{
         RowBox[{"2", 
          SuperscriptBox["DS1", "2"], 
          RowBox[{"(", 
           RowBox[{"Ni", "+", "1"}], ")"}]}], "+", 
         RowBox[{
          SuperscriptBox["DS2", "3"], "Ni", 
          RowBox[{"(", 
           RowBox[{"Ni", "-", "1"}], ")"}]}]}]]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", "\[Rule]", "0.3"}], ",", 
        RowBox[{"Ni", "->", "1.5187228"}], ",", 
        RowBox[{"M", "\[Rule]", "3"}]}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"r2", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      FractionBox["1", "f1"], 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1", " ", "DS2"}], 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["DS1", "2"], 
         RowBox[{"(", 
          RowBox[{"Ni", "+", "1"}], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox["DS2", "3"], "Ni", 
         RowBox[{"(", 
          RowBox[{"Ni", "-", "1"}], ")"}]}]}]]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Alpha]", "\[Rule]", "0.3"}], ",", 
       RowBox[{"Ni", "->", "1.5187228"}], ",", 
       RowBox[{"M", "\[Rule]", "3"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r1", ",", "r2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "0.7", ",", "1.5"}], "}"}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Green", ",", " ", "Blue"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\[Delta]\>\"", ",", 
      "\"\<\!\(\*SubscriptBox[\(r\), \(1\)]\), \!\(\*SubscriptBox[\(r\), \
\(2\)]\)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "3"}], ",", "3"}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.41423890578125*^9, 3.414238907828125*^9}, {
   3.414239110328125*^9, 3.414239119359375*^9}, {3.414239160875*^9, 
   3.4142391851875*^9}, {3.4142392611875*^9, 3.414239273640625*^9}, {
   3.414240031328125*^9, 3.414240051640625*^9}, 3.414511347921875*^9, {
   3.42476010715625*^9, 3.424760115765625*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"834f8b6d-082b-0b4d-954b-e845dd80beb8"],

