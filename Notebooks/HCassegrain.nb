Cell[CellGroupData[{

Cell["HCassegrain2", "Title",
 TextAlignment->Center,
 Background->RGBColor[
  0.718761, 0.980484, 
   0.992203],ExpressionUUID->"f7b785d5-67f9-544a-a117-20f8be2b9c82"],

Cell["\<\
Input data:
f1     = primary focal;
ft     = total focal;
spes = thickness list of corrector and its distance from primary mirror;
em   = back focal;
diam = diameter of corrector;
ind    = list of refractive indices;
angle = field angle;
waves = wave lengths considered;
sf = to balance spherical aberration
co = to balance coma
cr = to balance chromatism;\
\>", "Text",
 CellChangeTimes->{{3.432982134734375*^9, 3.43298213940625*^9}, {
  3.4329821734375*^9, 3.43298223959375*^9}, {3.980210882085846*^9, 
  3.9802108828347816`*^9}},
 FontSize->18,ExpressionUUID->"10840eed-52f8-204b-bc5b-886118feec33"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{"HCassegrain2", "[", 
    RowBox[{
    "f1_", ",", "ft_", ",", "em_", ",", "spes_", ",", "diam_", ",", "ind_", 
     ",", "angle_", ",", "waves_", ",", "sf_", ",", "co_", ",", "cr_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"(*", 
       RowBox[{
       "\[Alpha]", ",", "M", ",", "\[Beta]", ",", "\[Gamma]", ",", "A", ",", 
        "B", ",", "AS", ",", "a1", ",", "a2", ",", "D1", ",", "D2", ",", "r1",
         ",", "r2", ",", "r3", ",", "r4", ",", "r3d", ",", "ra11", ",", 
        "pl"}], "*)"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"Ni", "=", 
       RowBox[{"ind", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"em", "/", "f1"}]}], ";", "\n", 
      RowBox[{"\[Delta]", "=", 
       RowBox[{
        RowBox[{"spes", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "/", "f1"}]}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"M", "=", 
       RowBox[{"ft", "/", " ", "f1"}]}], ";", "\n", 
      RowBox[{"\[Beta]", "=", 
       FractionBox[
        RowBox[{"M", "-", "\[Alpha]"}], 
        RowBox[{"M", "+", "1"}]]}], ";", "\n", 
      RowBox[{"\[Gamma]", "=", 
       FractionBox[
        RowBox[{"2", "M", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
        RowBox[{"1", "-", 
         SuperscriptBox["M", "2"]}]]}], ";", "\n", 
      RowBox[{"A", "=", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"32", " ", 
           SuperscriptBox["f1", "3"]}]]}], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["M", "2"]}], ")"}]}], 
         RowBox[{"32", " ", 
          SuperscriptBox["f1", "3"], " ", 
          SuperscriptBox["M", "3"]}]]}]}], ";", "\n", 
      RowBox[{"B", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"\[Alpha]", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["M", "2"]}], ")"}]}], "+", 
          RowBox[{"M", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["M", "2"]}], ")"}]}]}], 
         RowBox[{"8", " ", 
          SuperscriptBox["f1", "2"], " ", 
          SuperscriptBox["M", "3"]}]], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["M", "2"], "+", 
            SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
            RowBox[{
             SuperscriptBox["M", "2"], " ", "\[Alpha]"}]}], ")"}], " ", 
          "\[Delta]"}], 
         RowBox[{"8", " ", 
          SuperscriptBox["f1", "2"], " ", 
          SuperscriptBox["M", "3"]}]]}]}], ";", "\n", 
      RowBox[{"AS", "=", 
       RowBox[{
        FractionBox[
         RowBox[{
          SuperscriptBox["M", "4"], "-", 
          RowBox[{"2", " ", "M", " ", "\[Alpha]"}], "-", 
          SuperscriptBox["\[Alpha]", "2"], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["M", "3"], " ", 
           RowBox[{"(", 
            RowBox[{"2", "+", "\[Alpha]"}], ")"}]}], "+", 
          RowBox[{
           SuperscriptBox["M", "2"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", 
             SuperscriptBox["\[Alpha]", "2"]}], ")"}]}]}], 
         RowBox[{"8", " ", "f1", " ", 
          SuperscriptBox["M", "3"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"M", "+", 
            SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
            RowBox[{
             SuperscriptBox["M", "2"], " ", "\[Alpha]"}]}], ")"}], " ", 
          "\[Delta]"}], 
         RowBox[{"4", " ", "f1", " ", 
          SuperscriptBox["M", "3"]}]], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
            RowBox[{
             SuperscriptBox["M", "2"], " ", 
             RowBox[{"(", 
              RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], ")"}], " ", 
          SuperscriptBox["\[Delta]", "2"]}], 
         RowBox[{"8", " ", "f1", " ", 
          SuperscriptBox["M", "3"]}]]}]}], ";", "\n", 
      RowBox[{"a11", "=", 
       FractionBox[
        RowBox[{"4", "-", 
         RowBox[{"3", " ", "Ni"}], "-", 
         RowBox[{"3", " ", 
          SuperscriptBox["Ni", "2"]}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["Ni", "3"]}]}], 
        RowBox[{"8", " ", "Ni"}]]}], ";", "\n", 
      RowBox[{"a21", "=", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", "Ni", "+", 
         SuperscriptBox["Ni", "2"], "-", 
         SuperscriptBox["Ni", "3"]}], 
        RowBox[{"4", " ", "Ni"}]]}], ";", "\n", 
      RowBox[{"D1", "=", 
       RowBox[{
        FractionBox["1", "8"], "-", 
        FractionBox["1", 
         RowBox[{"4", " ", "Ni"}]], "+", 
        FractionBox["Ni", "8"], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["Ni", "2"]}], ")"}], " ", "ra3", " ", "f1", " ", 
          "A"}], 
         RowBox[{"2", " ", "Ni", " ", "B"}]]}]}], ";", "\n", 
      RowBox[{"D2", "=", 
       RowBox[{
        FractionBox[
         RowBox[{"2", "Ni"}], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["Ni", "2"], "-", "1"}], ")"}]], "B", "*", 
        SuperscriptBox["ra3", "2"], 
        SuperscriptBox["f1", "2"]}]}], ";", "\n", 
      RowBox[{"\[CapitalDelta]", "=", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"a11", "+", "a21", "+", "D1"}], ")"}], "2"], "-", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{"a11", "+", "a21"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"D1", "+", 
           RowBox[{"a11", " ", "D2"}]}], ")"}]}]}]}], ";", "\n", "\n", 
      RowBox[{"\[CapitalDelta]1", "=", 
       RowBox[{"Numerator", "[", 
        RowBox[{"Simplify", "[", "\[CapitalDelta]", "]"}], "]"}]}], ";", "\n",
       "\n", 
      RowBox[{"sr", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"\[CapitalDelta]1", "\[Equal]", "0"}], ",", "ra3"}], "]"}],
          "//", "Sort"}], "]"}]}], ";", "\n", "\n", 
      RowBox[{
       RowBox[{"rd", "[", "2", "]"}], "=", 
       RowBox[{"0.99", 
        RowBox[{"sr", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", " ", 
       RowBox[{"Second", " ", "solution"}], " ", "*)"}], "\n", 
      RowBox[{"r1", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "f1"}], " ", "ra3", 
         FractionBox[
          RowBox[{"2", " ", "a11", " ", 
           RowBox[{"(", 
            RowBox[{"a11", "+", "a21"}], ")"}]}], 
          RowBox[{
           RowBox[{"a11", " ", 
            RowBox[{"(", 
             RowBox[{"a21", "-", 
              RowBox[{"2", " ", "D1"}]}], ")"}]}], "+", 
           RowBox[{"a21", " ", 
            RowBox[{"(", 
             RowBox[{"a21", "-", "D1", "+", 
              SqrtBox["\[CapitalDelta]"]}], ")"}]}]}]]}], "/.", 
        RowBox[{"ra3", "\[Rule]", 
         RowBox[{"rd", "[", "2", "]"}]}]}]}], ";", "\n", 
      RowBox[{"r2", "=", 
       RowBox[{
        RowBox[{"f1", " ", "ra3", " ", 
         FractionBox[
          RowBox[{"2", " ", 
           RowBox[{"(", 
            RowBox[{"a11", "+", "a21"}], ")"}]}], 
          RowBox[{"a11", "+", "a21", "+", "D1", "+", 
           SqrtBox["\[CapitalDelta]"]}]]}], "/.", 
        RowBox[{"ra3", "\[Rule]", " ", 
         RowBox[{"rd", "[", "2", "]"}]}]}]}], ";", "\n", 
      RowBox[{"r3d", "=", 
       RowBox[{"f1", " ", 
        RowBox[{"rd", "[", "2", "]"}]}]}], ";", "\n", 
