 InterpretationBox[
  RowBox[{"\<\"Astigmatism coefficient = \"\>", "\[InvisibleSpace]", "0"}],
  SequenceForm["Astigmatism coefficient = ", 0],
  Editable->False]], "Print",
 CellChangeTimes->{3.979120502568363*^9, 3.9791205656444664`*^9},
