         RowBox[{"[", "4", "]"}], "]"}], "/", "f1"}]}], ";", "\n", 
      RowBox[{"M", "=", 
       RowBox[{"ft", "/", " ", "f1"}]}], ";", "\n", 
      RowBox[{"\[Beta]", "=", 
       FractionBox[
        RowBox[{"M", "-", "\[Alpha]"}], 
        RowBox[{"M", "+", "1"}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Gamma]", "=", 
