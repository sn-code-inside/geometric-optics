Cell[CellGroupData[{

Cell["Summary", "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.750011],ExpressionUUID->"e71b6d9f-eac9-a147-9fc9-f78a00a6304b"],

Cell[TextData[{
 "Symmetric doublet \n\n\n",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["R", "1"], "=", 
    RowBox[{"f", 
     FractionBox[
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"2", "-", "\[Delta]"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Ni", "+", "1"}], ")"}], "+", 
       RowBox[{"Ni", 
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "-", "\[Delta]"}], ")"}], "3"]}]}]]}]}], ",", 
   "          ", "\n", 
   RowBox[{
    SubscriptBox["R", "2"], "=", 
    RowBox[{
     RowBox[{"-", "f"}], 
     FractionBox[
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"2", "-", "\[Delta]"}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Ni", "+", "1"}], ")"}], "-", 
       RowBox[{"Ni", 
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "-", "\[Delta]"}], ")"}], "3"]}]}]]}]}], ","}]],
  ExpressionUUID->"9d80a8a4-4f16-054c-925c-42fed5d05c08"],
 "\n\n\[Delta] \[Epsilon] [0.75, 1]. This is a good combination for speed \
less than F/3.5\n\n\nDoublet with different radii (no control on astigmatism)\
\n \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["r", "1"], "=", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["r", "3"]}], 
      FractionBox[
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["a", "1"], "(", 
         RowBox[{
          SubscriptBox["a", "1"], "+", 
          SubscriptBox["a", "2"]}], ")"}]}], 
