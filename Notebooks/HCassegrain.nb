Cell[CellGroupData[{

Cell["\<\
Houghton-Cassegrain
Telescope\
\>", "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.750011],ExpressionUUID->"3aa9fdfa-18a7-b744-a2c7-9bc1d0eda088"],

Cell[TextData[{
 "The Houghton-Cassegrain telescope is formed by an afocal doublet ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "561cdd21-de6d-9e43-a195-99be444243af"],
 " of two thin lenses of the ",
 StyleBox["same",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 " glass, having the task to eliminate the spherical aberration and coma of \
the primary and secondary mirrors, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "68e44ed9-803c-0149-813f-a60d7ab5d496"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "6b0c445f-8bae-3943-bd79-92cf82c4622e"],
 ", of a Cassegrain combination. Since ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "205ec4b2-b206-8b4e-9bbc-4dceedfc17b9"],
 " has no astigmatism, ",
 StyleBox["there is no possibility",
  FontWeight->"Bold"],
 " to control the astigmatism of  the Cassegrain scheme by the \
characteristics of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "07365450-1235-6940-851d-15d0551582a3"],
 ". Therefore, this aberration depends only on the distance \[Delta]",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "6e396a4a-b2ba-604c-889d-f83058f1b619"],
 " of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "bfaaeed1-aeb2-284c-abe0-3b46f4d7f533"],
 " from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    FormBox["S",
     TraditionalForm], "1"], TraditionalForm]],ExpressionUUID->
  "3eb501a7-a1ce-cd42-bdfb-c945215ab71b"],
 ". \nWe recall that the Cassegrain design starts with the following data \
(see Chapter 4 and Chapter 6, Section 1):\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"em", " ", "=", " ", 
     RowBox[{"back", " ", "distance"}]}], ",", "\n", 
    RowBox[{
     SubscriptBox["f", "t"], " ", "=", " ", 
     RowBox[{
     "focal", " ", "length", " ", "of", " ", "Cassegrain", " ", 
      "combination"}]}], ",", "\n", 
    RowBox[{
     SubscriptBox["f", "1"], " ", "=", " ", 
     RowBox[{"focal", " ", "length", " ", "of", " ", 
      RowBox[{
       SubscriptBox["S", "1"], "."}]}]}]}], TraditionalForm]],ExpressionUUID->
  "758f12fe-aa4f-ea49-8d55-22f6a71a514f"],
 "\n\nThen the following nondimensional constants are evaluated\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Alpha]", " ", "=", " ", 
     FractionBox["em", 
      SubscriptBox["f", "1"]]}], ",", "\n", 
    RowBox[{"M", " ", "=", " ", 
     FractionBox[
      SubscriptBox["f", "t"], 
      SubscriptBox["f", "1"]]}], ",", "\n", 
    RowBox[{"\[Beta]", " ", "=", " ", 
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]]}], ",", "\n", 
    RowBox[{"\[Gamma]", " ", "=", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"2", 
        RowBox[{"M", "(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]], "."}]}]}], TraditionalForm]],
  ExpressionUUID->"d0870a13-ca43-3a42-9a45-0ade0392ec37"],
 "\n\nwhich allow us to determine the remaining characteristics of the \
Cassegrain scheme:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["s", "12"], " ", "=", " ", 
    RowBox[{
     RowBox[{"-", "\[Beta]"}], " ", 
     SubscriptBox["f", "1"]}]}], TraditionalForm]],ExpressionUUID->
  "1c663a60-5609-db4d-9343-e8451801d459"],
 " (distance between ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "12f30662-62b6-384f-a29b-9b52aa728a91"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "8e8e32a7-7dd6-1045-ac29-f9691028c19a"],
 "),\n\[Gamma] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "1"], TraditionalForm]],ExpressionUUID->
  "48809d33-d211-7343-8275-a6940b758844"],
 " = radius of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "0b02bb64-b5f2-da44-bc98-191a45d28742"],
 ".\n \nAs usual (see Chapter 4), when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", " "}], TraditionalForm]],ExpressionUUID->
  "56282e3c-6515-1842-bd7f-07ca22f7a649"],
 "is afocal, the total aberration coefficients are obtained adding the \
coefficients of the mirrors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "63477672-fde6-e74f-81c3-a08442c56137"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "68c4b2d6-ee03-0f4d-8b62-8e708bd0f04e"],
 ", taking into account that the aperture stop ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "a560d7b2-4fa5-ce4b-870d-a542c70cb216"],
 " at a distance \[Delta]",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "9d6104cc-411f-7e46-9f72-a0f3ccbd4402"],
 " from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "777d506e-4726-b144-9c30-64b1929630c6"],
 ", and the coefficients of the doublet located at ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "026c4da1-3424-4848-b57b-69a4daeaf0ad"],
 ". For spherical ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "09e2397e-f274-ed49-83ea-05bb84c97fd6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "43f0cd63-e3b8-8c46-8106-cd1ce811be9d"],
 ", we have the following input data:"
}], "Text",
 CellChangeTimes->{{3.414240279484375*^9, 3.414240280125*^9}, {
  3.43286998009375*^9, 3.432870012078125*^9}},
 FontSize->18,ExpressionUUID->"6b44060c-ddb8-f94a-8880-cb394ab8810a"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Beta]", "=", 
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "=", 
     FractionBox[
      RowBox[{"2", "M", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
      RowBox[{"1", "-", 
       SuperscriptBox["M", "2"]}]]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rad", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], "f1"}], ",", " ", 
       RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"thick", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", "f1"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "1"}], "}"}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"costasf", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"TotalAberrations", "[", 
     RowBox[{
     "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
      RowBox[{
       RowBox[{"-", "\[Delta]"}], " ", "f1"}], ",", 
      RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
      RowBox[{"{", "\[Lambda]", "}"}], ",", "2"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.414223283296875*^9, 3.414223299859375*^9}, {
   3.41422334371875*^9, 3.41422339153125*^9}, 3.41423873840625*^9, {
   3.414238825734375*^9, 3.41423883003125*^9}, {3.414239363296875*^9, 
   3.41423940703125*^9}, 3.414240298578125*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"6d55d5a6-079d-034b-9fc2-89bb4f0a8a40"],

Cell[TextData[{
 "and the spherical aberration and coma coefficients of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "abba0a95-d172-8846-8421-5ea472a77809"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "ce4c4e3e-0fe3-4649-ac0a-d7a043b47555"],
 " write:"
}], "Text",
 CellChangeTimes->{{3.41423832775*^9, 3.41423834521875*^9}, 3.414238385125*^9},
 FontSize->18,ExpressionUUID->"059becad-cd09-734a-a838-28895f224fb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"DS1", "=", 
   RowBox[{
    RowBox[{"Seidsphe", "[", "1", "]"}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DS2", "=", 
   RowBox[{
    RowBox[{"Seidcoma", "[", "1", "]"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.414238392109375*^9, 3.414238417796875*^9}, {
  3.414238448046875*^9, 3.41423847234375*^9}, {3.41423878753125*^9, 
  3.414238836671875*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"cb89c6d9-63fa-554e-bdd3-d3db67b1072b"],

Cell[TextData[{
 "To evaluate the aberrations of Hougthon's corrector ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "1471c289-fbb9-6b46-9bcb-ff55011e9b31"],
 ", two possibilities can be analyzed. \n\n1) The two thin lenses of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "08002267-bc8c-0448-b0d4-fbe75ddec4d8"],
 " have curvature radii ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "/", 
     SubscriptBox["c", "1"]}], ",", " ", 
    RowBox[{"1", "/", 
     SubscriptBox["c", "2"]}], ",", " ", 
    RowBox[{
     RowBox[{"-", "1"}], "/", 
     SubscriptBox["c", "1"]}], ",", " ", 
    RowBox[{"1", "/", 
     SubscriptBox["c", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "1d07ba28-6756-f94f-999d-67959476c06c"],
 " (it is plain to verify that this system is afocal, when the thickness is \
zero);\n\n2) the curature radii are different and verify the condition\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["c", "1"], "-", 
     SubscriptBox["c", "2"], "+", 
     SubscriptBox["c", "3"], "-", 
     SubscriptBox["c", "4"]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "b303c331-d599-434f-9260-31024c9f1dba"],
 ",\n\nin order to have an afocal corrector ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "df7e7e9b-18d1-8546-b253-3c9a4956e2a5"],
 " (see Chapter 4).\nWith respect to the first possibility, the following \
system has to be considered:"
}], "Text",
 CellChangeTimes->{{3.41423818628125*^9, 3.41423818628125*^9}, {
   3.41423831315625*^9, 3.41423831959375*^9}, 3.41423837996875*^9, {
   3.414238504078125*^9, 3.414238504953125*^9}},
 FontSize->18,ExpressionUUID->"1c61c113-4dab-e948-89e3-cfd621f2abcd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rad", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "c1"}], ",", 
      RowBox[{"1", "/", "c2"}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "c1"}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", "c2"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ind", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "Ni", ",", "1", ",", "Ni", ",", "1"}], "}"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
   "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
   RowBox[{"{", "\[Lambda]", "}"}], ",", "0"}], "]"}], "\n", "Null"}], "Input",
 CellChangeTimes->{{3.414238199375*^9, 3.414238252390625*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"57025834-5b2d-e040-a260-b75d986dd7cf"],

Cell[CellGroupData[{

Cell[BoxData["\<\"Spherical coefficient\"\>"], "Print",
 CellChangeTimes->{3.9791205023521843`*^9, 3.9791205651119175`*^9},
 CellLabel->
  "During evaluation of \
In[20]:=",ExpressionUUID->"f315b202-5b73-0247-b693-c6c6a9a7ddc0"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"c1", "-", "c2"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"c1", "+", "c2"}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "Ni"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "Ni"}], ")"}]}], 
  RowBox[{"4", " ", "Ni"}]]], "Print",
 CellChangeTimes->{3.9791205023521843`*^9, 3.9791205651275406`*^9},
 CellLabel->
