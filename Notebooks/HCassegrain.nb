Cell[TextData[{
 "The above plots show that the best values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "1d9b120b-6747-394f-93c2-03930180d32b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "d69c28ba-d6d9-644f-abde-d9ef4adc8050"],
 ", i. e. the greatest absolute values which reduce higher order aberrations, \
are obtained for \[Delta] \[Epsilon] [0.7, 1] . Moreover, to obtain a lower \
obstruction, we must increase the magnification ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "."}], TraditionalForm]],ExpressionUUID->
  "94bb9fb7-8c25-984a-80a8-e2eaaab7340a"],
 " As a consequence, the radii ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "e3f1faac-830e-cd44-8841-fe4c267c921c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "dc643007-7144-f041-acd7-b83b3ef56202"],
 " reduce and the higher-order aberrations increase.\nThese results are valid \
provided that the thickness of lenses can be neglected. \n\n"
}], "Text",
 CellChangeTimes->{{3.41424054584375*^9, 3.4142405471875*^9}, {
   3.414240599578125*^9, 3.41424060015625*^9}, {3.414240633*^9, 
   3.41424063353125*^9}, 3.424760175984375*^9},
 FontSize->18,ExpressionUUID->"feee72df-185d-b34b-96ce-9601462d13f0"],

