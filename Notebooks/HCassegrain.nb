Cell[TextData[{
 "The above plots show that the best values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "16b3000c-ffa5-1a4e-84d6-b6a029d809e1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "2b3dab6e-c4ee-dd44-b42a-134891772fd1"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "3"], TraditionalForm]],ExpressionUUID->
  "1cb59bb5-7046-a54c-aa9d-68d146b5ea46"],
 ", i. e. the greatest absolute values which reduce higher-order aberrations, \
are given by the ",
 StyleBox["second",
  FontWeight->"Bold"],
 " solution and for \[Delta] \[Epsilon] [0.7, 0.9] . Moreover, to reduce the \
obstruction, we must increase the magnification ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", "."}], TraditionalForm]],ExpressionUUID->
  "a45e383e-5475-2d42-8a27-e94ade4e984f"],
 " As a consequence, the radii ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "3dc00565-0a60-c041-b51c-b72cf1ef8d36"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "4092212f-d818-d444-9a8d-aebc0549334c"],
 " reduce and the higher-order aberrations increase.\nThese results are valid \
provided that the thickness of lenses can be neglected. \n"
}], "Text",
 CellChangeTimes->{{3.42476040759375*^9, 3.42476042153125*^9}},
 FontSize->18,ExpressionUUID->"962c5587-5a27-5a45-838a-bf7bd45882f3"],

Cell["\<\
************************************************

************************************************\
\>", "Text",
 FontSize->18,ExpressionUUID->"97e0f06e-1068-3a46-9ac8-235c144eb8fa"],

Cell[TextData[{
 "If we wish to control the astigmatism in a Houghton's combination, a \
secondary mirror ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "0fe1afe7-ced9-db43-b030-8a8d6241573b"],
 ", with a conic constant ",
 Cell[BoxData[
  FormBox["K", TraditionalForm]],ExpressionUUID->
  "21013dd7-7fc5-c247-b144-2c09a310e7c4"],
 ", has to be used. In fact, to evaluate the aberrations of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["S", "1"], ",", " ", 
    SubscriptBox["S", "2"]}], TraditionalForm]],ExpressionUUID->
  "318fd212-034e-744b-bdf7-dc2f7b01a7e6"],
 ", with the aperture stop ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "2ae3b78f-40c7-5847-af12-9523b10fcfd3"],
 " at a distance \[Delta] in front of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "7b5b4f5a-0b61-9e4f-8ea4-68a4e2a09273"],
 ", we consider the system"
}], "Text",
 FontSize->18,ExpressionUUID->"5f631d5a-2bcf-8b41-9e31-57e886036871"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rad", "=", 
    RowBox[{"{", 
     RowBox[{"Infinity", ",", "Infinity", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "f1"}], ",", 
      RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"\[Delta]", " ", "f1"}], ",", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ind", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "K1", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{"NTAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", 
   "\[Theta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DS1p", "=", 
  RowBox[{"Simplify", "[", "Absfer", "]"}]}], "\n", 
 RowBox[{"DS2p", "=", 
  RowBox[{"Simplify", "[", "Comatot", "]"}]}], "\n", 
 RowBox[{"DS3p", "=", 
  RowBox[{"Simplify", "[", "Asttot", "]"}]}], "\n", "Null"}], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"d9e1e1ca-8911-294a-8fc4-bbb697b8a7a9"],

Cell[BoxData[
 RowBox[{"NTAberrations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Infinity]", ",", "\[Infinity]", ",", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "f1"}], ",", 
     FractionBox[
      RowBox[{"2", " ", "f1", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
      RowBox[{"1", "-", 
       SuperscriptBox["M", "2"]}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"f1", " ", "\[Delta]"}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"f1", " ", 
        RowBox[{"(", 
         RowBox[{"M", "-", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "+", "M"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "K1", ",", "0"}], "}"}], ",", "r", ",", 
   "\[Theta]"}], "]"}]], "Output",
 CellChangeTimes->{3.979120503655428*^9, 3.979120567163582*^9},
 CellLabel->"Out[64]=",ExpressionUUID->"8dc19e36-96b5-c84c-b85b-0b79266d5dac"],

Cell[BoxData["Absfer"], "Output",
 CellChangeTimes->{3.979120503655428*^9, 3.9791205671737385`*^9},
 CellLabel->"Out[65]=",ExpressionUUID->"cf5885aa-b560-8440-994e-8ae3e7249cf7"],

Cell[BoxData["Comatot"], "Output",
 CellChangeTimes->{3.979120503655428*^9, 3.9791205671737385`*^9},
 CellLabel->"Out[66]=",ExpressionUUID->"ab3bef57-72f0-da47-aae4-8a1827043fa3"],

Cell[BoxData["Asttot"], "Output",
 CellChangeTimes->{3.979120503655428*^9, 3.9791205671737385`*^9},
 CellLabel->"Out[67]=",ExpressionUUID->"21f13653-f2b4-7341-8d94-b92db0ea38c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rad", "=", 
    RowBox[{"{", 
     RowBox[{"Infinity", ",", "Infinity", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "f1"}], ",", 
      RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"\[Delta]", " ", "f1"}], ",", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ind", "=", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "K2"}], "}"}]}], ";"}], "\n", 
 RowBox[{"NTAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", 
   "\[Theta]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DS1s", "=", 
  RowBox[{"Simplify", "[", "Absfer", "]"}]}], "\n", 
 RowBox[{"DS2s", "=", 
  RowBox[{"Simplify", "[", "Comatot", "]"}]}], "\n", 
 RowBox[{"DS3s", "=", 
  RowBox[{"Simplify", "[", "Asttot", "]"}]}], "\n", "Null"}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"1574762d-da6c-614c-b07c-5f8e4929c8c4"],

Cell[BoxData[
 RowBox[{"NTAberrations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Infinity]", ",", "\[Infinity]", ",", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "f1"}], ",", 
     FractionBox[
      RowBox[{"2", " ", "f1", " ", "M", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
      RowBox[{"1", "-", 
       SuperscriptBox["M", "2"]}]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"f1", " ", "\[Delta]"}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"f1", " ", 
        RowBox[{"(", 
         RowBox[{"M", "-", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "+", "M"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1", ",", "1", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "K2"}], "}"}], ",", "r", ",", 
