Cell["Substituting these expressions into (*), one obtains:", "Text",
 FontSize->18,ExpressionUUID->"ca72874d-b30f-1b4d-93d9-5da7bfc136da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"R1p", "=", 
   RowBox[{"-", 
    RowBox[{"Simplify", "[", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1pf", " ", 
       "DS2pf"}], 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["DS1pf", "2"], 
        RowBox[{"(", 
         RowBox[{"Ni", "+", "1"}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["DS2pf", "3"], " ", "Ni", 
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R2p", "=", 
    RowBox[{"Simplify", "[", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1pf", " ", 
       "DS2pf"}], 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["DS1pf", "2"], 
        RowBox[{"(", 
         RowBox[{"Ni", "+", "1"}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["DS2pf", "3"], " ", "Ni", 
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"R1s", "=", 
   RowBox[{"-", 
    RowBox[{"Simplify", "[", 
     FractionBox[
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1sf", " ", 
       "DS2sf"}], 
      RowBox[{
       RowBox[{"2", 
        SuperscriptBox["DS1sf", "2"], 
        RowBox[{"(", 
         RowBox[{"Ni", "+", "1"}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["DS2sf", "3"], " ", "Ni", 
        RowBox[{"(", 
         RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R2s", "=", 
   RowBox[{"Simplify", "[", 
    FractionBox[
     RowBox[{"2", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "DS1sf", " ", "DS2sf"}], 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["DS1sf", "2"], 
       RowBox[{"(", 
        RowBox[{"Ni", "+", "1"}], ")"}]}], "-", 
      RowBox[{
       SuperscriptBox["DS2sf", "3"], " ", "Ni", 
       RowBox[{"(", 
        RowBox[{"Ni", "-", "1"}], ")"}]}]}]], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"e09efbe0-7fa2-604a-8bcc-a29f62c7f1c8"],

