Cell["\<\
If the curvature radii are different, the following system has to be \
considered:\
\>", "Text",
 FontSize->18,ExpressionUUID->"8702dd42-1b36-f540-97fc-99ca55feb567"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rad", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "c1"}], ",", 
      RowBox[{"1", "/", "c2"}], ",", 
      RowBox[{"1", "/", "c3"}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"c1", "-", "c2", "+", "c3"}], ")"}]}]}], "}"}]}], ";"}], 
  " "}], "\n", 
 RowBox[{
  RowBox[{"thick", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ind", "=", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "Ni", ",", "1", ",", "Ni", ",", "1"}], "}"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"costasf", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
  "rad", ",", "thick", ",", "ind", ",", "costasf", ",", "r", ",", "0", ",", 
   "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
   RowBox[{"{", "\[Lambda]", "}"}], ",", "0"}], "]"}], "\n", "Null"}], "Input",
 CellChangeTimes->{{3.414240652609375*^9, 3.414240718515625*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"2c3381d6-4038-694a-ba9e-00a0be8a9932"],

Cell[CellGroupData[{

Cell[BoxData["\<\"Spherical coefficient\"\>"], "Print",
 CellChangeTimes->{3.979120502568363*^9, 3.9791205656132183`*^9},
 CellLabel->
  "During evaluation of \
In[34]:=",ExpressionUUID->"577c6ce7-8609-8d4e-80bb-72482cb69286"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"c1", "-", "c2"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"c2", "-", "c3"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "c3"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", "Ni"}], ")"}]}], "-", 
     RowBox[{"2", " ", "c2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["Ni", "2"]}], ")"}]}], "+", 
     RowBox[{"c1", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "4"}], "-", "Ni", "+", 
        RowBox[{"2", " ", 
         SuperscriptBox["Ni", "2"]}]}], ")"}]}]}], ")"}]}], 
  RowBox[{"8", " ", "Ni"}]]], "Print",
 CellChangeTimes->{3.979120502568363*^9, 3.9791205656288414`*^9},
 CellLabel->
  "During evaluation of \
In[34]:=",ExpressionUUID->"7ca15733-611f-ab45-a665-ee242a587919"],

Cell[BoxData["\<\"Coma coefficient \"\>"], "Print",
 CellChangeTimes->{3.979120502568363*^9, 3.9791205656444664`*^9},
 CellLabel->
  "During evaluation of \
In[34]:=",ExpressionUUID->"292faeb1-ca86-f646-acd6-ca8be74cf748"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"c1", "-", "c2"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"c2", "-", "c3"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["Ni", "2"]}], ")"}]}], 
   RowBox[{"2", " ", "Ni"}]]}]], "Print",
 CellChangeTimes->{3.979120502568363*^9, 3.9791205656444664`*^9},
 CellLabel->
  "During evaluation of \
In[34]:=",ExpressionUUID->"a61be35c-2781-d34f-a3cc-1cbe5d6b92fc"],

