   3.431928376546875*^9, 3.431928424609375*^9}, {3.431928618015625*^9, 
   3.431928621875*^9}, {3.431928832609375*^9, 3.43192895421875*^9}, {
   3.43192956021875*^9, 3.43192957721875*^9}, {3.431929732265625*^9, 
   3.431929733265625*^9}, {3.431938834390625*^9, 3.431938841609375*^9}, {
