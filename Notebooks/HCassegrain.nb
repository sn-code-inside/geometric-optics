Cell["\<\
Input data:
f1      = primary focal;
ft     = total focal;
spes = thickness list of corrector and its distance from primary mirror;
em   = back focal;
diam = diameter of corrector;
angle      = field angle;
waves = wave lengths considered;
sf = to balance spherical aberration
co = to balance coma
cr = to balance chromatism;
\
\>", "Text",
 CellChangeTimes->{{3.432977806984375*^9, 3.432977845890625*^9}, {
  3.9802100701429863`*^9, 3.9802101851568203`*^9}},
 FontSize->18,ExpressionUUID->"224242a7-e763-ae4c-8d82-f4424c867f0d"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{"HCassegrain1", "[", 
    RowBox[{
    "f1_", ",", "ft_", ",", "spes_", ",", "em_", ",", "diam_", ",", "ind_", 
     ",", "angle_", ",", "waves_", ",", "sf_", ",", "co_", ",", "cr_"}], 
    "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Alpha]", ",", "M", ",", "\[Beta]", ",", "\[Gamma]", ",", "A", ",", 
       "B", ",", "AS", ",", "r11", ",", "r12", ",", "sol1", ",", "ra1", ",", 
       "pl"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"Ni", "=", 
       RowBox[{"ind", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"em", "/", "f1"}]}], ";", "\n", 
      RowBox[{"\[Delta]", "=", 
