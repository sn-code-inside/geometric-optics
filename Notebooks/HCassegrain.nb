Cell[BoxData[{
 RowBox[{
  RowBox[{"DC1", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Seidsphe", "[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DC2", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Seidcoma", "[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.41424072715625*^9, 3.414240739296875*^9}, {
  3.424760189625*^9, 3.4247601925625*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"f2b898ea-f6cd-ac4f-86de-3291c4abf1af"],

Cell[TextData[{
 "To put DC1 in a more convenient form, we note that the factor\n\n",
 Cell[BoxData[
  RowBox[{
   FractionBox["1", 
    RowBox[{"8", " ", "Ni"}]], 
   StyleBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "c3"}], " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "Ni"}], ")"}]}], "-", 
        RowBox[{"2", " ", "c2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["Ni", "2"]}], ")"}]}], "+", 
        RowBox[{"c1", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "4"}], "-", "Ni", "+", 
           RowBox[{"2", " ", 
            SuperscriptBox["Ni", "2"]}]}], ")"}]}]}], ")"}]}], ")"}],
    FontSize->14]}]],ExpressionUUID->"9b7b4c06-880c-3843-aa4a-68b09d04a683"],
 "\n\nbecomes"
}], "Text",
 FontSize->18,ExpressionUUID->"67df414d-39b2-754d-af50-fcc946476a09"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Apart", "[", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Expand", "[", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"8", " ", "Ni"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "c3"}], " ", 
          RowBox[{"(", 
           RowBox[{"2", "+", "Ni"}], ")"}]}], "-", 
         RowBox[{"2", " ", "c2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["Ni", "2"]}], ")"}]}], "+", 
         RowBox[{"c1", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "4"}], "-", "Ni", "+", 
            RowBox[{"2", " ", 
             SuperscriptBox["Ni", "2"]}]}], ")"}]}]}], ")"}]}], ")"}]}], 
    "]"}], "]"}], "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"171a91b5-9abd-1143-a20e-5dbd31dec4ab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "8"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], " ", "c1"}], "+", 
     RowBox[{"2", " ", "c2"}], "-", "c3"}], ")"}]}], "+", 
  FractionBox[
   RowBox[{
    RowBox[{"2", " ", "c1"}], "-", "c2", "+", "c3"}], 
   RowBox[{"4", " ", "Ni"}]], "-", 
  RowBox[{
   FractionBox["1", "8"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"3", " ", "c1"}], "-", 
     RowBox[{"2", " ", "c2"}], "+", "c3"}], ")"}], " ", "Ni"}], "+", 
  RowBox[{
   FractionBox["1", "4"], " ", 
   RowBox[{"(", 
    RowBox[{"c1", "-", "c2"}], ")"}], " ", 
   SuperscriptBox["Ni", "2"]}]}]], "Output",
 CellChangeTimes->{3.9791205026152363`*^9, 3.9791205657134933`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"79b4cfa7-3522-1947-be85-b9379cf20919"]
}, Open  ]],

Cell[TextData[{
 "Spherical aberration and coma coefficients of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "e45aa615-8e3e-914e-98b4-ebd86ece7f0c"],
 " write:\n\nD1C = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "2"], "-", 
       SubscriptBox["c", "3"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "1"], "-", 
       SubscriptBox["c", "2"]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{"(", 
           RowBox[{"Ni", "+", "1"}], ")"}], "8"]}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3", 
           SubscriptBox["c", "1"]}], "-", 
          RowBox[{"2", 
           SubscriptBox["c", "2"]}], "+", 
          SubscriptBox["c", "3"]}], ")"}]}], "+", "\n", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"4", "Ni"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           SubscriptBox["c", "1"]}], "-", 
          SubscriptBox["c", "2"], "+", 
          SubscriptBox["c", "3"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox[
         SuperscriptBox["Ni", "2"], "4"], 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["c", "1"], "-", 
          SubscriptBox["c", "2"]}], ")"}]}]}], ")"}]}], ","}], 
   TraditionalForm]],ExpressionUUID->"a426d17b-7ac3-1647-9feb-ce47c0316e22"],
 "\n\nD2C = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       SuperscriptBox["Ni", "2"], "-", "1"}], 
      RowBox[{"2", "Ni"}]]}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["c", "1"], "-", 
      SubscriptBox["c", "2"]}], ")"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["c", "2"], "-", 
       SubscriptBox["c", "3"]}], ")"}], "."}]}], TraditionalForm]],
  ExpressionUUID->"ed2df331-3886-5445-a465-39e583528bc4"],
 "\n\nThe curvature radii\n\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["R", "1"], "=", 
     RowBox[{"1", "/", 
      SubscriptBox["c", "1"]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["R", "2"], "=", 
     RowBox[{"1", "/", 
      SubscriptBox["c", "2"]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["R", "3"], "=", 
     RowBox[{"1", "/", 
      SubscriptBox["c", "3"]}]}], ",", " ", 
    RowBox[{
     SubscriptBox["R", "4"], "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["c", "1"], "-", 
        SubscriptBox["c", "2"], "+", 
        SubscriptBox["c", "3"]}], ")"}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c5dbc966-9895-6c4f-b13d-e2192b317199"],
 " \n\nof the two lenses of ",
 Cell[BoxData[
  FormBox["C", TraditionalForm]],ExpressionUUID->
  "0cb24cbc-857f-304a-8ac9-bbbe32363371"],
 ", which eliminate spherical aberration and coma verify the system\n\nD1S + \
D1C = 0,\nD2S + D2C = 0.\n\nIn Chapter 4 it is proved that this system is \
equivalent to the following second degree system\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["a", "1"], "x"}], "+", 
      RowBox[{
       SubscriptBox["a", "2"], "y"}]}], "=", 
     SubscriptBox["d", "1"]}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "y"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"y", "-", "1"}], ")"}]}], "=", 
     SubscriptBox["d", "2"]}], ","}], TraditionalForm]],ExpressionUUID->
  "d67fc131-a7db-2e4b-87a7-1c2c34c937b7"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], "/", 
       SubscriptBox["c", "3"]}], "=", 
      RowBox[{
       SubscriptBox["R", "3"], "/", 
       SubscriptBox["R", "1"]}]}]}], ",", " ", 
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "2"], "/", 
       SubscriptBox["c", "3"]}], "=", 
      RowBox[{
       SubscriptBox["R", "3"], "/", 
       SubscriptBox["R", "2"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "70678a57-5da1-9840-b222-a855a30780b5"],
 " and \n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["a", "1"], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"8", "Ni"}]], 
      RowBox[{"(", 
       RowBox[{"4", "-", 
        RowBox[{"3", "Ni"}], "-", 
        RowBox[{"3", 
         SuperscriptBox["Ni", "2"]}], "+", 
        RowBox[{"2", 
         SuperscriptBox["Ni", "3"]}]}], ")"}]}]}], ",", "\n", 
    RowBox[{
     SubscriptBox["a", "2"], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"4", "Ni"}]], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "Ni", "+", 
        SuperscriptBox["Ni", "2"], "-", 
        SuperscriptBox["Ni", "3"]}], ")"}]}]}], ",", "\n", 
    RowBox[{
     SubscriptBox["d", "1"], "=", 
     RowBox[{
      FractionBox["1", "8"], "-", 
      FractionBox["1", 
       RowBox[{"4", "Ni"}]], "+", 
      FractionBox["Ni", "8"], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], 
        SubscriptBox["R", "3"], "DS1"}], 
       RowBox[{"2", "Ni", " ", "DS2"}]]}]}], ",", "         ", 
    RowBox[{"(", "2", ")"}]}], TraditionalForm], "\n", 
  FormBox[
   RowBox[{
    SubscriptBox["d", "2"], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"2", 
       SuperscriptBox[
        SubscriptBox["NiR", "3"], "2"], "DS2"}], 
      RowBox[{
       SuperscriptBox["Ni", "2"], "-", "1"}]], "."}]}], TraditionalForm]}],
  ExpressionUUID->"0e2e141e-8b8e-fc47-ab78-91c59f6103f9"],
 Cell[BoxData[
  FormBox["\n", TraditionalForm]],ExpressionUUID->
  "9c67a8e6-9ac9-a34c-8126-9b2d99c783c1"],
 "\n\nThe solutions of the above system write:"
}], "Text",
 CellChangeTimes->{{3.4142407553125*^9, 3.41424075665625*^9}},
 FontSize->18,ExpressionUUID->"c5528cf2-bea0-b646-831c-db8c52ff1f80"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"eq1", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"a1", " ", "x"}], "+", 
     RowBox[{"a2", " ", "y"}]}], "\[Equal]", "d1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eq2", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "y"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"y", "-", "1"}], ")"}]}], "\[Equal]", "d2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"eq1", ",", "eq2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}], "//", 
  "Simplify"}], "\n", "Null"}], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"b9e2e00e-5821-f640-90e6-c24338f2d6a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "a1"}], " ", "a2"}], "-", 
        SuperscriptBox["a2", "2"], "+", 
        RowBox[{"2", " ", "a1", " ", "d1"}], "+", 
        RowBox[{"a2", " ", "d1"}], "+", 
        RowBox[{"a2", " ", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"a1", "+", "a2", "+", "d1"}], ")"}], "2"], "-", 
           RowBox[{"4", " ", 
            RowBox[{"(", 
             RowBox[{"a1", "+", "a2"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"d1", "+", 
              RowBox[{"a1", " ", "d2"}]}], ")"}]}]}]]}]}], 
       RowBox[{"2", " ", "a1", " ", 
        RowBox[{"(", 
         RowBox[{"a1", "+", "a2"}], ")"}]}]]}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox[
       RowBox[{"a1", "+", "a2", "+", "d1", "-", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"a1", "+", "a2", "+", "d1"}], ")"}], "2"], "-", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"a1", "+", "a2"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"d1", "+", 
             RowBox[{"a1", " ", "d2"}]}], ")"}]}]}]]}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"a1", "+", "a2"}], ")"}]}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"a1", " ", "a2"}], "+", 
         SuperscriptBox["a2", "2"], "-", 
         RowBox[{"2", " ", "a1", " ", "d1"}], "-", 
         RowBox[{"a2", " ", "d1"}], "+", 
         RowBox[{"a2", " ", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"a1", "+", "a2", "+", "d1"}], ")"}], "2"], "-", 
            RowBox[{"4", " ", 
             RowBox[{"(", 
              RowBox[{"a1", "+", "a2"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"d1", "+", 
               RowBox[{"a1", " ", "d2"}]}], ")"}]}]}]]}]}], 
        RowBox[{"2", " ", "a1", " ", 
         RowBox[{"(", 
          RowBox[{"a1", "+", "a2"}], ")"}]}]]}]}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox[
       RowBox[{"a1", "+", "a2", "+", "d1", "+", 
        SqrtBox[
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"a1", "+", "a2", "+", "d1"}], ")"}], "2"], "-", 
          RowBox[{"4", " ", 
           RowBox[{"(", 
            RowBox[{"a1", "+", "a2"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"d1", "+", 
             RowBox[{"a1", " ", "d2"}]}], ")"}]}]}]]}], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"a1", "+", "a2"}], ")"}]}]]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9791205027688847`*^9, 3.9791205658984127`*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"582eccc5-5dcf-c64a-9b9e-15347b9a72bd"]
}, Open  ]],

Cell[TextData[{
 "Finally, recalling that\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "1"], "/", 
       SubscriptBox["c", "3"]}], "=", 
      RowBox[{
       SubscriptBox["R", "3"], "/", 
       SubscriptBox["R", "1"]}]}]}], ",", " ", 
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["c", "2"], "/", 
       SubscriptBox["c", "3"]}], "=", 
      RowBox[{
       SubscriptBox["R", "3"], "/", 
       SubscriptBox["R", "2"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "12980b69-3132-8e4e-b53d-a3fc5b3c7f04"],
 "\n\nand introducing the nondimensional radii\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["r", "1"], "=", 
     RowBox[{
      SubscriptBox["R", "1"], "/", "f"}]}], ",", "  ", 
    RowBox[{
     SubscriptBox["r", "2"], "=", 
     RowBox[{
      SubscriptBox["R", "2"], "/", "f"}]}], ",", "  ", 
    RowBox[{
     SubscriptBox["r", "3"], "=", 
     RowBox[{
      SubscriptBox["R", "3"], "/", "f"}]}], ",", "  ", 
    RowBox[{
     SubscriptBox["r", "4"], "=", 
     RowBox[{
      SubscriptBox["R", "4"], "/", "f"}]}], ","}], TraditionalForm]],
  ExpressionUUID->"a72c0434-62de-4343-990b-f1d8bb34f9ee"],
 "\n\nthe following two solutions are obtained:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["r", "1"], "=", 
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["r", "3"]}], 
      FractionBox[
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["a", "1"], "(", 
         RowBox[{
          SubscriptBox["a", "1"], "+", 
          SubscriptBox["a", "2"]}], ")"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["a", "1"], "(", 
         RowBox[{
          SubscriptBox["a", "2"], "-", 
          RowBox[{"2", 
           SubscriptBox["d", "1"]}]}], ")"}], "+", 
        RowBox[{
         SubscriptBox["a", "2"], "(", 
         RowBox[{
          SubscriptBox["a", "2"], "-", 
          SubscriptBox["d", "1"], "+", 
          SqrtBox["\[CapitalDelta]"]}], ")"}]}]]}]}], ",", "\n", 
    RowBox[{
     SubscriptBox["r", "2"], "=", "    ", 
     RowBox[{
      SubscriptBox["r", "3"], 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox["a", "1"], "+", 
          SubscriptBox["a", "2"]}], ")"}]}], 
       RowBox[{
        SubscriptBox["a", "1"], "+", 
        SubscriptBox["a", "2"], "+", 
        SubscriptBox["d", "1"], "+", 
        SqrtBox["\[CapitalDelta]"]}]]}]}], ",", 
    "                                   ", 
    RowBox[{"(", "3", ")"}]}], TraditionalForm]],ExpressionUUID->
  "c7e490bb-2bf2-7e46-adb4-a63369ec3851"],
 "\n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    SubscriptBox["r", "1"], "=", " ", 
    RowBox[{
     SubscriptBox["r", "3"], 
     FractionBox[
      RowBox[{"2", 
       RowBox[{
        SubscriptBox["a", "1"], "(", 
        RowBox[{
         SubscriptBox["a", "1"], "+", 
         SubscriptBox["a", "2"]}], ")"}]}], 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["a", "1"], "(", 
         RowBox[{
          SubscriptBox["a", "2"], "-", 
          RowBox[{"2", 
           SubscriptBox["d", "1"]}]}], ")"}]}], "+", 
       RowBox[{
        SubscriptBox["a", "2"], "(", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["a", "2"]}], "+", 
         SubscriptBox["d", "1"], "+", 
         SqrtBox["\[CapitalDelta]"]}], ")"}]}]]}]}], TraditionalForm], "\n", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["r", "2"], "=", " ", 
      RowBox[{
       SubscriptBox["r", "3"], 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["a", "1"], "+", 
           SubscriptBox["a", "2"]}], ")"}]}], 
        RowBox[{
         SubscriptBox["a", "1"], "+", 
         SubscriptBox["a", "2"], "+", 
         SubscriptBox["d", "1"], "-", 
         SqrtBox["\[CapitalDelta]"]}]]}]}], ",", 
     "                                       ", 
     RowBox[{"(", "4", ")"}]}], "  "}], TraditionalForm]}],ExpressionUUID->
  "12ce6448-187b-7747-8112-5763d76377b9"],
 "\n\nwhere\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", " ", "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "1"], "+", 
        SubscriptBox["a", "2"], "+", 
        SubscriptBox["d", "1"]}], ")"}], "2"], "-", 
     RowBox[{"4", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "1"], "+", 
        SubscriptBox["a", "2"]}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["d", "1"], "+", 
         RowBox[{
          SubscriptBox["a", "1"], 
          SubscriptBox["d", "2"]}]}], ")"}], ".", "        ", 
       RowBox[{"(", "5", ")"}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "bced18ba-445b-a64d-837b-fee011c75c9e"],
 "\n\nThese solutions are real if \[CapitalDelta]",
 Cell[BoxData[
  FormBox[
   RowBox[{">", "0"}], TraditionalForm]],ExpressionUUID->
  "531963b1-3c3e-f449-af63-c729a5eaee1d"],
 ". Owing to (2), the radii (3)-(4) and \[CapitalDelta], are functions of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "3"], "  ", "and", "  ", Cell[
    "\[Delta].",ExpressionUUID->"3f6a05b6-8226-f847-aab3-cdf2fa53c022"]}], 
   TraditionalForm]],ExpressionUUID->"83fddd56-ee28-744a-95d8-b3ae47eda692"],
 "To find the region of the plane ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["r", "3"], ",", " ", "\[Delta]"}], ")"}], TraditionalForm]],
  ExpressionUUID->"ab7895b4-a1cd-da47-aa33-44335cb2f897"],
 " in which ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "a36ca660-5322-d048-bb93-76f5cb81a73d"],
 ", for the glass BK7 (Ni = 1.5187228, in green light), it is sufficient to \
resort to the command InequalityGraphics of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "."
}], "Text",
 FontSize->18,ExpressionUUID->"29c8ce8d-445b-bc44-9819-1ee22b71c5e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sost", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a1", "->", 
       FractionBox[
        RowBox[{"4", "-", 
         RowBox[{"3", " ", "Ni"}], "-", 
         RowBox[{"3", " ", 
          SuperscriptBox["Ni", "2"]}], "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["Ni", "3"]}]}], 
        RowBox[{"8", " ", "Ni"}]]}], ",", 
      RowBox[{"a2", "->", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "1"}], "+", "Ni", "+", 
         SuperscriptBox["Ni", "2"], "-", 
         SuperscriptBox["Ni", "3"]}], 
        RowBox[{"4", " ", "Ni"}]]}], ",", 
      RowBox[{"d1", "->", 
       RowBox[{
        FractionBox["1", "8"], "-", 
        FractionBox["1", 
         RowBox[{"4", " ", "Ni"}]], "+", 
        FractionBox["Ni", "8"], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["Ni", "2"], "-", "1"}], ")"}], "f1", " ", "r3", 
          " ", "DS1"}], 
         RowBox[{"2", " ", "Ni", " ", "DS2"}]]}]}], ",", 
      RowBox[{"d2", "->", 
       FractionBox[
        RowBox[{"2", "Ni", " ", 
         SuperscriptBox["r3", "2"], 
         SuperscriptBox["f1", "2"], "DS2"}], 
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}]]}]}], "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Alpha]", "\[Rule]", "0.4"}], ",", 
      RowBox[{"Ni", "->", "1.5187228"}], ",", 
      RowBox[{"M", "\[Rule]", "4"}]}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalDelta]", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"a1", "+", "a2", "+", "d1"}], ")"}], "2"], "-", 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{"a1", "+", "a2"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"d1", "+", 
         RowBox[{"a1", " ", "d2"}]}], ")"}]}]}], ")"}], "/.", "sost"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.424760254359375*^9, 3.424760255234375*^9}},
 CellLabel->"In[47]:=",ExpressionUUID->"ba349634-b415-0148-b10e-ce75e774cec7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{"\[CapitalDelta]", ">", "0"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r3", ",", 
     RowBox[{"-", "3"}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Delta]", ",", "0.7", ",", "1.2"}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "0.4"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<\!\(\*SubscriptBox[\(r\), \(3\)]\)\>\"", ",", "\"\<\[Delta]\>\""}], 
     "}"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.4247602341875*^9, 3.424760235921875*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"755ac854-91be-9b46-a122-c2f1fc68154c"],

