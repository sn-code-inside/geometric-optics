 TextAlignment->Center,
 Background->RGBColor[
  0.803921568627451, 0.803921568627451, 
   0.803921568627451],ExpressionUUID->"7cbe44b8-c780-224b-a662-d67471701b14"],

Cell[CellGroupData[{

Cell["\<\
The meniscus corrector is made by BK7;
The input data are:
Dp = diameter of the principal mirror;
fp = focal of the principal mirror;
ftot = total focal length;
em = back distance;
\[Theta] = view angle;
\
\>", "Subsection",
 CellChangeTimes->{{3.426315967453125*^9, 3.426315977625*^9}, {
  3.981594958194395*^9, 
  3.9815949614033737`*^9}},ExpressionUUID->"3d281981-9317-164a-bf61-\
0f09b3ffba38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"KlevtsovPrg", "[", 
   RowBox[{
   "Dp_", ",", "fp_", ",", "ftot_", ",", "em_", ",", "angle_", ",", "sf_", 
    ",", "co_", ",", "cr_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Designe", " ", "of", " ", "the", " ", "Cassegrain", " ", "combination",
        " ", "with", " ", "a", " ", "back", " ", "distance", " ", "em"}], "+", 
      RowBox[{"40", " ", "mm"}]}], " ", "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"em1", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"em", "+", "40"}], ")"}], "/", "fp"}]}], ";", "\n", 
     RowBox[{"M", "=", 
      RowBox[{"ftot", "/", "fp"}]}], ";", "\n", 
     RowBox[{"\[Beta]", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"M", "-", "em1"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"M", "+", "1"}], ")"}]}]}], ";", "\n", 
     RowBox[{"\[CapitalDelta]", "=", 
      RowBox[{
       RowBox[{"-", "\[Beta]"}], " ", "fp"}]}], ";", "\n", 
     RowBox[{"ott", "=", 
      RowBox[{"1", "-", "\[Beta]"}]}], ";", "\n", 
     RowBox[{"\[Gamma]", "=", 
      FractionBox[
       RowBox[{"2", " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "em1"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]]}], ";", "\n", 
     RowBox[{"R2", "=", 
      RowBox[{"\[Gamma]", " ", "fp"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Corrector", " ", "design"}], " ", "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"First", " ", "step"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"spc", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"100", "<", "Dp", "<=", "150"}], ",", "25", " ", ",", "30"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rad", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], "fp"}], ",", 
        RowBox[{"1", "/", "c4"}], ",", 
        RowBox[{"1", "/", "c3"}], ",", 
        RowBox[{"1", "/", "c2"}], ",", "R2", ",", 
        RowBox[{"1", "/", "c2"}], ",", 
        RowBox[{"1", "/", "c3"}], ",", 
        RowBox[{"1", "/", "c4"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"thick", "=", 
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]", ",", 
        RowBox[{"-", "spc"}], ",", 
        RowBox[{"-", "3"}], ",", "0", ",", "3", ",", "0", ",", "spc"}], 
       "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ind", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.518722"}], ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.518722"}], ",", "1.518722", ",", "1", ",", 
          "1.518722", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.522376"}], ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.522376"}], ",", "1.522376", ",", "1", ",", 
          "1.522376", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.514322"}], ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1.514322"}], ",", "1.514322", ",", "1", ",", 
          "1.514322", ",", "1"}], "}"}]}], "}"}]}], ";", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{"rad", ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
         "0"}], "}"}], ",", 
       RowBox[{"Dp", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y1", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"0.54", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], ",", 
       "2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"s3", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"foc", "[", "1", "]"}], "\[Equal]", "ftot"}], ",", 
          RowBox[{
           RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", "0"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"c2", ",", 
          RowBox[{"1", "/", "R2"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c3", ",", "0.007"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c4", ",", "0.007"}], "}"}], ",", 
        RowBox[{"MaxIterations", "\[Rule]", "300"}]}], "]"}]}], ";", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Second", " ", "step"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"rad", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "c1"}], ",", 
        RowBox[{"1", "/", "c4"}], ",", 
        RowBox[{"1", "/", "c3"}], ",", 
        RowBox[{"1", "/", "c2"}], ",", "R2", ",", 
        RowBox[{"1", "/", "c2"}], ",", 
        RowBox[{"1", "/", "c3"}], ",", 
        RowBox[{"1", "/", "c4"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{"rad", ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
         "0"}], "}"}], ",", 
       RowBox[{"Dp", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y1", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"s5", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"foc", "[", "1", "]"}], "\[Equal]", "ftot"}], ",", 
          RowBox[{
           RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"zog1", "[", 
             RowBox[{"2", ",", "n"}], "]"}], "-", 
            RowBox[{"zog1", "[", 
             RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", "0"}]}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"c1", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "fp"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c2", ",", 
          RowBox[{"s3", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c3", ",", 
          RowBox[{"s3", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"c4", ",", 
          RowBox[{"s3", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
     "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Third", " ", 
       RowBox[{"step", ":", " ", 
        RowBox[{"balance", " ", "of", " ", "aberrations"}]}]}], " ", "*)"}], 
     "\n", 
     RowBox[{"rad", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", "R2", ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"1", "/", 
         RowBox[{"s5", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{"rad", ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
         "0"}], "}"}], ",", 
       RowBox[{"Dp", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y1", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"axcr", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{"rad", ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
         "0"}], "}"}], ",", 
       RowBox[{"Dp", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y1", ",", "angle", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"sf5", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co5", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{"rad", ",", "thick", ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{
        "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
         "0"}], "}"}], ",", 
       RowBox[{"Dp", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y1", ",", "angle", ",", 
       RowBox[{"{", 
