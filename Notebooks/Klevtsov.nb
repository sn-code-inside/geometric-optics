Cell[CellGroupData[{

Cell[TextData[StyleBox["Input data",
 FontFamily->"Times New Roman",
 FontSize->36]], "Title",
 CellChangeTimes->{{3.3954035388125*^9, 3.395403545078125*^9}, 
   3.395453747421875*^9, {3.413775772326984*^9, 3.413775772514484*^9}, {
   3.426330629203125*^9, 3.42633063321875*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.7333333333333333, 0.7333333333333333, 
   0.7333333333333333],ExpressionUUID->"33308cd9-1e18-ac43-b96a-62c39def0682"],

Cell["\<\
The input data of the program TotalAberrations(inf) are:
rad  = list of the radii of the surfaces;
thick = list of the distances between a surface and the next one;
ind = list of the refractive indices;
costasf = list of the constant which characterize the nature of any surface \
(0 for a sphere, K for a conic, {a4,as} for an      aspheric surface)
stoprad = radius of the aperture stop;
nstop = number of the surfaces before the stop;
dis = distance of the aperture stop from the last surface before it;
dobject = distance of the object from the first surface;
hobject = height of the object (only if is a finite distance );
angle = view angle in degrees;
waves = the wave-length corresponding to the chosen refractive indices;
option = 0, 1, 2. If option =0 the program gives the aberration coefficients; \
if option = 1, the program gives the aberrations, if option = 2, the program \
evaluates all the data but does not give output;
\
\>", "Text",
 CellChangeTimes->{{3.426330650796875*^9, 3.4263310476875*^9}, {
   3.426331088984375*^9, 3.426331212078125*^9}, {3.426483483296875*^9, 
   3.4264834881875*^9}, {3.42717974878125*^9, 3.427179816125*^9}, 
   3.427180945671875*^9, {3.427191699921875*^9, 3.427191719546875*^9}, 
   3.427191890953125*^9},
 FontFamily->"Times New Roman",
 FontSize->16,
 FontWeight->"Bold",ExpressionUUID->"bf8067cd-e2fe-e747-b68b-dd5dfd1f17ff"]
}, Closed]],

Cell[CellGroupData[{

Cell["A program to design the Klevtsov combination.", "Title",
 CellChangeTimes->{{3.39618731675*^9, 3.396187631421875*^9}, {
   3.396187661734375*^9, 3.39618768828125*^9}, 3.396187967125*^9, {
   3.396188188828125*^9, 3.3961882119375*^9}, {3.39619000615625*^9, 
   3.396190010203125*^9}, {3.396191169203125*^9, 3.396191215328125*^9}, {
