Cell[TextData[{
 "If f is the focal length of the primary mirror, D its diameter and choose \
\[CapitalDelta]/D=0.1, we have\nx=\[AliasDelimiter]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["\[CapitalDelta]", "D"], 
     FractionBox["D", "f"], 
     FractionBox["f", "r1"]}], "=", "0.1"}], TraditionalForm]],ExpressionUUID->
  "1c8a8524-f740-c942-8362-8635a7533796"],
 "A",
 Cell[BoxData[
  FormBox[
   FractionBox["f", "r1"], TraditionalForm]],ExpressionUUID->
  "4988eed7-01f0-224a-9874-8087151d900a"],
 "= 0.1 A y,\nwhere A is the speed of primary mirror. If A varies from 1/4 to \
1/3 and f/r1 from -1 to -0.5"
}], "Text",
 CellChangeTimes->{{3.9806430533649597`*^9, 3.980643055956852*^9}},
 TextJustification->1,
 FontSize->18,ExpressionUUID->"e84460a7-6304-e244-875a-92438f97ceb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Alpha]", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", 
      RowBox[{"0.1", " ", "A", " ", "y", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Ni", "-", "1"}], ")"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Ni", "2"], "-", "1"}], ")"}]]}]}], 
     RowBox[{"1", "-", 
      RowBox[{"0.1", "A", " ", "y", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Ni", "-", "1"}], ")"}], "2"], 
        SuperscriptBox["Ni", "2"]]}]}]], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Ni", "->", "1.5187228"}], ",", 
      RowBox[{"A", "\[Rule]", "0.33"}]}], "}"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"e38ce947-aae9-bf48-ae34-6e54bb9d9849"],

Cell[CellGroupData[{

