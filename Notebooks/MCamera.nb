Cell[CellGroupData[{

Cell["Maksutov Achromatic Camera", "Title",
 CellChangeTimes->{3.432289569546875*^9},
 TextAlignment->Center,
 Background->RGBColor[
  0.8862745098039215, 0.8862745098039215, 
   0.8862745098039215],ExpressionUUID->"a1a64cd6-fc9c-de4e-8212-83084e4298db"],

Cell[TextData[StyleBox["In front of the main mirror S there is a Maksutov \
meniscus whose surfaces have their centers at the center of S. Moreover, at \
this point there is a convergent lens to make achromatic the combination. \
spess is the thickness of the lens and sfe is the arbitrary value of the \
third-order spherical aberration starting from zero. It is convenient to \
increase the distance between the meniscus and the mirror of a few \
millimetres  to reduce the third-order coma.",
 FontSize->14]], "Text",
 CellChangeTimes->{{3.43228975896875*^9, 3.432289900359375*^9}, {
  3.432289950125*^9, 3.432289998734375*^9}, {3.432302581679594*^9, 
  3.432302632554594*^9}, {3.432380000265625*^9, 3.432380018546875*^9}, {
  3.43238008621875*^9, 3.4323801176875*^9}, {3.9806414486180935`*^9, 
  3.9806414495286407`*^9}},ExpressionUUID->"c3953b4c-874a-ab44-95d5-\
b5c7b8a06702"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Off", "[", 
    RowBox[{"RowReduce", "::", "luc"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MAchromaticCamera", "[", 
   RowBox[{
   "f_", ",", "ind_", ",", "diam_", ",", "\[Alpha]_", ",", "waves_", ",", 
    "spess_", ",", "sf_", ",", "cr_"}], "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", "\n", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"First", ",", " ", 
      RowBox[{
       RowBox[{
       "we", " ", "suppose", " ", "that", " ", "there", " ", "is", " ", "no", 
        " ", "convergent", " ", 
        RowBox[{"lens", ".", " ", "The"}], " ", "spherical", " ", 
        "aberration", " ", "of", " ", "the", " ", "meniscus", " ", "balances",
         " ", "the", " ", "corresponding", " ", "aberration", " ", "of", " ", 
        "the", " ", "mirror", " ", "with", " ", "its", " ", "aperture", " ", 
        "stop", " ", "at", " ", "a", " ", "distance"}], " ", "-", 
       RowBox[{"2", "f"}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Infinity", " ", ",", "Infinity", ",", 
         RowBox[{"-", "\[CapitalDelta]1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[CapitalDelta]1"}], "-", 
          RowBox[{"0.1", "diam"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}]}], " ", "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "\[CapitalDelta]1", ",", 
         RowBox[{"0.1", "diam"}], ",", 
         RowBox[{
          RowBox[{"2", "f"}], "-", 
          RowBox[{"(", 
           RowBox[{"\[CapitalDelta]1", "+", 
            RowBox[{"0.1", " ", "diam"}]}], ")"}]}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"esf", "=", 
      RowBox[{"Numerator", "[", 
       RowBox[{"Together", "[", 
        RowBox[{"Absftot", "[", "1", "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s0", "=", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{"esf", "\[Equal]", "0"}], ",", "\[CapitalDelta]1"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"s00", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"s0", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "s0", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"s000", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"s00", ",", "_Real"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"su", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"s000", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Sign", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"corr", "=", 
      RowBox[{"Max", "[", "su", "]"}]}], ";", "\n", "\n", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "The", " ", "approximate", " ", "value", " ", "of", " ", "the", " ", 
       "radius", " ", "of", " ", "the", " ", "first", " ", "lens", " ", "to", 
       " ", "achromatize", " ", "the", " ", "system"}], " ", "*)"}], "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "cu1"}], " ", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "cu1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[CapitalDelta]2"}], " ", "f"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]2"}], " ", "f"}], "-", 
          RowBox[{"0.1", "diam"}]}], ",", 
         RowBox[{"1", "/", "cu2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"spess", ",", 
         RowBox[{
          RowBox[{"\[CapitalDelta]2", " ", "f"}], "-", 
          RowBox[{"spess", "/", "2"}]}], ",", 
         RowBox[{"0.1", "diam"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "cu2"}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]2", " ", "f"}], "+", 
            RowBox[{"0.1", " ", "diam"}]}], ")"}]}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"abc", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"fff1", "=", 
      RowBox[{"foc", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"zzz1", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", 
     RowBox[{"sol1", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"abc", "\[Equal]", "0"}], ",", 
          RowBox[{"fff1", "\[Equal]", 
           RowBox[{"-", "f"}]}], ",", 
          RowBox[{"zzz1", "\[Equal]", "0"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cu1", ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "5"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalDelta]2", ",", 
          RowBox[{"corr", "/", "f"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cu2", ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", "f"}], ")"}]}]}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "f"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"sol1", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "f"}], "-", 
          RowBox[{"0.1", "diam"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"spess", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "f"}], "-", 
          RowBox[{"spess", "/", "2"}]}], ",", 
         RowBox[{"0.1", "diam"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"sol1", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "f"}], "+", 
            RowBox[{"0.1", " ", "diam"}]}], ")"}]}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"sf5", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co5", "=", "coma5"}], ";", "\n", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "f"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", 
            RowBox[{"sol1", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "f"}], "-", 
          RowBox[{"0.1", "diam"}]}], ",", 
         RowBox[{"1", "/", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"spess", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}], "f"}], "-", 
          RowBox[{"spess", "/", "2"}]}], ",", 
         RowBox[{"0.1", "diam"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", 
           RowBox[{"sol1", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"sol1", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "f"}], "+", 
            RowBox[{"0.1", " ", "diam"}]}], ")"}]}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"margcr", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"znu", "[", "2", "]"}], "-", 
        RowBox[{"znu", "[", "3", "]"}]}], ")"}]}], ";", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{"Final", " ", "calculations"}], " ", "*)"}], "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "bu1"}], ",", 
         RowBox[{
          RowBox[{"-", "1"}], "/", "bu1"}], ",", 
         RowBox[{
          RowBox[{"-", "\[CapitalDelta]3"}], " ", "f"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[CapitalDelta]3"}], " ", "f"}], "-", 
          RowBox[{"0.1", "diam"}]}], ",", 
         RowBox[{"1", "/", "bu2"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"spess", ",", 
         RowBox[{
          RowBox[{"\[CapitalDelta]3", " ", "f"}], "-", 
          RowBox[{"spess", "/", "2"}]}], ",", 
         RowBox[{"0.1", "diam"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "/", "bu2"}], "-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[CapitalDelta]3", " ", "f"}], "+", 
            RowBox[{"0.1", " ", "diam"}]}], ")"}]}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Alpha]", ",", "waves", 
       ",", "2"}], "]"}], ";", "\n", 
     RowBox[{"abc2", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"fff2", "=", 
      RowBox[{"foc", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"zzz2", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", 
     RowBox[{"sol2", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"abc2", "\[Equal]", 
           RowBox[{
            RowBox[{"-", "sf"}], " ", "sf5"}]}], ",", 
          RowBox[{"fff2", "\[Equal]", 
           RowBox[{"-", "f"}]}], ",", 
          RowBox[{"zzz2", "\[Equal]", 
           RowBox[{
            RowBox[{"-", "cr"}], " ", "margcr"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bu1", ",", 
          RowBox[{"sol1", "[", 
           RowBox[{"[", 
