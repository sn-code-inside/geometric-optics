Cell[CellGroupData[{

Cell["MCamera.nb", "Title",
 CellChangeTimes->{3.43200260490625*^9},
 TextAlignment->Center,
 Background->RGBColor[
  0.500008, 0.996109, 
   0.996109],ExpressionUUID->"df3e3e75-4011-d846-829b-a72914d40d30"],

Cell["\<\
The program MCamera.nb is based on the aberration formulae of Chapter 3. \
First, the spherical aberration, coma and axial chromatic aberrations of the \
corrector M are analyzed. We denote with 
r1 the radius of the anterior surface of M; 
r2 the radius of the posterior surface of M;
s = r1-r2;
\[CapitalDelta] = thickness of M;
\[Theta] = field angle.

Now, it is sufficient to use the program TotalAberrations.nb \
\>", "Text",
 CellChangeTimes->{{3.432000972484375*^9, 3.432001062*^9}, {
  3.9806429677448063`*^9, 3.9806429788391304`*^9}},
 FontSize->18,ExpressionUUID->"c7b0eb96-d71a-ff47-936b-ecbb2daca314"],

Cell[BoxData[
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"r1", ",", 
     RowBox[{"r1", "-", "s"}]}], "}"}], ",", 
   RowBox[{"{", "\[CapitalDelta]", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "Ni", ",", "1"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}], ",", "r", ",", "0", ",", "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
   RowBox[{"{", "\[Lambda]", "}"}], ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.432001078234375*^9, 3.432001091296875*^9}, {
  3.432001122515625*^9, 3.432001162203125*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"bf7aa68d-226a-de49-99e5-9861fef23ab0"],

Cell["\<\
from which the coefficients Dc1 and DC2 of spherical aberrtion and coma are \
derived for a given wave length:\
\>", "Text",
 FontSize->18,ExpressionUUID->"c9984592-cc2d-b442-9457-fe5cf9fec89d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"DC1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Absftot", "[", "1", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"DC2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Comatot", "[", "1", "]"}], "]"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.432001183421875*^9, 3.432001193390625*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"98ffa533-bbd8-1f48-82d6-0de13c208509"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["r", "3"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["Ni", "5"], " ", 
         RowBox[{"(", 
          RowBox[{"r1", "-", "\[CapitalDelta]"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "3"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1", "-", "s"}], ")"}], " ", "\[CapitalDelta]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r1", "-", "s", "+", "\[CapitalDelta]"}], ")"}], "2"]}], 
        "+", 
        RowBox[{
         SuperscriptBox["Ni", "4"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            SuperscriptBox["r1", "2"]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", "s"}], "-", 
              RowBox[{"4", " ", "\[CapitalDelta]"}]}], ")"}], " ", 
            "\[CapitalDelta]"}], "+", 
           RowBox[{"r1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", "s"}], "+", "\[CapitalDelta]"}], 
             ")"}]}]}], ")"}]}], "+", 
        RowBox[{"Ni", " ", "\[CapitalDelta]", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r1", "3"], "+", 
           RowBox[{
            SuperscriptBox["r1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"s", "-", 
              RowBox[{"2", " ", "\[CapitalDelta]"}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", " ", "s"}], "+", "\[CapitalDelta]"}], ")"}]}], "-", 
           RowBox[{"r1", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"5", " ", 
               SuperscriptBox["s", "2"]}], "-", 
              RowBox[{"7", " ", "s", " ", "\[CapitalDelta]"}], "+", 
              SuperscriptBox["\[CapitalDelta]", "2"]}], ")"}]}]}], ")"}]}], 
        "+", 
        RowBox[{
         SuperscriptBox["Ni", "3"], " ", 
         RowBox[{"(", 
          RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r1", "3"], "-", 
           RowBox[{
            SuperscriptBox["r1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"s", "-", 
              RowBox[{"2", " ", "\[CapitalDelta]"}]}], ")"}]}], "-", 
           RowBox[{"2", " ", "r1", " ", 
            SuperscriptBox["\[CapitalDelta]", "2"]}], "-", 
           RowBox[{"2", " ", "\[CapitalDelta]", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["s", "2"], "-", 
              RowBox[{"4", " ", "s", " ", "\[CapitalDelta]"}], "+", 
              RowBox[{"3", " ", 
               SuperscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}]}], ")"}]}],
         "+", 
        RowBox[{
         SuperscriptBox["Ni", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["r1", "3"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "s"}], "-", "\[CapitalDelta]"}], ")"}]}], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
            "\[CapitalDelta]", " ", 
            RowBox[{"(", 
             RowBox[{"s", "+", 
              RowBox[{"2", " ", "\[CapitalDelta]"}]}], ")"}]}], "+", 
           RowBox[{
            SuperscriptBox["r1", "2"], " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], " ", "s"}], "+", 
              RowBox[{"3", " ", "\[CapitalDelta]"}]}], ")"}]}], "+", 
           RowBox[{"2", " ", "r1", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["s", "3"], "-", 
              SuperscriptBox["\[CapitalDelta]", "3"]}], ")"}]}]}], ")"}]}]}], 
       ")"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", 
      SuperscriptBox["Ni", "2"], " ", 
      SuperscriptBox["r1", "3"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r1", "-", "s"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Ni", " ", 
         RowBox[{"(", 
          RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
        "\[CapitalDelta]"}], ")"}]}], ")"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.4320011965625*^9, 3.979120730302738*^9, 
  3.980642993317999*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"8f600cde-9eb5-004f-80bb-a7e030906ed2"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Pi]", " ", 
      SuperscriptBox["r", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["Ni", "4"], " ", 
         RowBox[{"(", 
          RowBox[{"r1", "-", "\[CapitalDelta]"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{"r1", "-", "s", "+", "\[CapitalDelta]"}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r1", "-", "s"}], ")"}], " ", "\[CapitalDelta]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"r1", "-", "s", "+", "\[CapitalDelta]"}], ")"}], "2"]}], 
        "+", 
        RowBox[{"Ni", " ", "\[CapitalDelta]", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r1", "3"], "-", 
           RowBox[{
            SuperscriptBox["r1", "2"], " ", "\[CapitalDelta]"}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", " ", "s"}], "+", "\[CapitalDelta]"}], ")"}]}], "+", 
           RowBox[{"r1", " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "3"}], " ", "s"}], "+", 
              RowBox[{"4", " ", "\[CapitalDelta]"}]}], ")"}]}]}], ")"}]}], 
        "+", 
        RowBox[{
         SuperscriptBox["Ni", "3"], " ", 
         RowBox[{"(", 
          RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["r1", "3"], "-", 
           RowBox[{"2", " ", 
            SuperscriptBox["r1", "2"], " ", 
            RowBox[{"(", 
             RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
           RowBox[{"\[CapitalDelta]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", 
               SuperscriptBox["s", "2"]}], "+", 
              RowBox[{"5", " ", "s", " ", "\[CapitalDelta]"}], "-", 
              RowBox[{"3", " ", 
               SuperscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}], "+", 
           RowBox[{"r1", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["s", "2"], "-", 
              RowBox[{"2", " ", 
               SuperscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}]}], ")"}]}],
         "+", 
        RowBox[{
         SuperscriptBox["Ni", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox["r1", "3"], " ", "s"}], "-", 
           RowBox[{"3", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
            SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
           RowBox[{
            SuperscriptBox["r1", "2"], " ", "s", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "2"}], " ", "s"}], "+", "\[CapitalDelta]"}], 
             ")"}]}], "+", 
           RowBox[{"r1", " ", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["s", "3"], "-", 
              RowBox[{
               SuperscriptBox["s", "2"], " ", "\[CapitalDelta]"}], "+", 
              RowBox[{"3", " ", "s", " ", 
               SuperscriptBox["\[CapitalDelta]", "2"]}], "-", 
              RowBox[{"3", " ", 
               SuperscriptBox["\[CapitalDelta]", "3"]}]}], ")"}]}]}], 
          ")"}]}]}], ")"}], " ", "\[Theta]"}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"360", " ", 
      SuperscriptBox["Ni", "2"], " ", 
      SuperscriptBox["r1", "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"r1", "-", "s"}], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Ni", " ", 
         RowBox[{"(", 
          RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
        "\[CapitalDelta]"}], ")"}]}], ")"}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.4320011965625*^9, 3.979120730302738*^9, 
  3.980642993402647*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"e948ecdd-21fe-df46-b602-d20ede235f79"]
}, Open  ]],

Cell["\<\
In order to make achromatic M, we require that the Gaussian distance from the \
second surface of an object located at infinity is independent on \[Lambda]. \
But, for any wave length this distance is\
\>", "Text",
 CellChangeTimes->{{3.4320012213125*^9, 3.4320012478125*^9}},
 FontSize->18,ExpressionUUID->"84f38b3a-426d-3348-9cac-60cc58f921b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"zog1", "[", 
  RowBox[{"1", ",", "2"}], "]"}]], "Input",
 CellChangeTimes->{{3.432001275484375*^9, 3.432001275921875*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"bda8f5a9-e196-884d-bd8b-daeb382cde00"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"r1", "-", "s"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Ni", " ", 
       RowBox[{"(", 
        RowBox[{"r1", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
      "\[CapitalDelta]"}], ")"}]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Ni", " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
      "\[CapitalDelta]"}], ")"}]}]]}]], "Output",
 CellChangeTimes->{{3.43200127246875*^9, 3.43200128028125*^9}, 
   3.979120730425129*^9, 3.9806429995504*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"269a96bf-c450-2f43-8024-e76ea58c041e"]
}, Open  ]],

Cell["Then, the achromatism condition writes:", "Text",
 FontSize->18,ExpressionUUID->"face141e-e6f2-3b44-a7ce-c9982635eb4b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"cacr", "=", 
  RowBox[{"Numerator", "[", 
   RowBox[{"Together", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"zog1", "[", 
       RowBox[{"1", ",", "2"}], "]"}], ",", "Ni"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.432001284765625*^9, 3.4320012853125*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"bf325e7d-103b-bf40-8b12-4b5920ca298f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"r1", "-", "s"}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     SuperscriptBox["Ni", "2"], " ", "r1", " ", "s"}], "+", 
    RowBox[{"r1", " ", "\[CapitalDelta]"}], "-", 
    RowBox[{
