Cell["\<\
In other words, \[Alpha] is very next to 1. Instead of the above expression \
of \[Alpha], we use the following other \
\>", "Text",
 CellChangeTimes->{{3.43200131421875*^9, 3.432001331953125*^9}},
 FontSize->18,ExpressionUUID->"3f9db7a6-b635-cf46-a7ac-ae1669d78ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[Alpha]", "=", 
  RowBox[{"\[CapitalDelta]", 
   FractionBox[
    RowBox[{
     SuperscriptBox["Ni", "2"], "-", "1"}], 
    RowBox[{"\[Alpha]", " ", 
     SuperscriptBox["Ni", "2"]}]]}]}]], "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"85b8d779-a601-e94b-a97d-82acf9008c16"],

Cell[BoxData[
 FractionBox[
  RowBox[{"0.5664462228108322`", " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"2.7755575615628914`*^-17", "+", 
        RowBox[{"0.17200162487416792`", " ", "r3"}]}], ")"}], "2"], "+", 
     RowBox[{"0.600913393556691`", " ", 
      RowBox[{"(", 
       RowBox[{"0.1502283483891728`", "\[VeryThinSpace]", "+", 
        RowBox[{"0.17200162487416792`", " ", "r3"}], "-", 
        RowBox[{"0.004720086143061531`", " ", 
         SuperscriptBox["r3", "2"]}]}], ")"}]}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     RowBox[{"1.1196765115770271`*^-12", " ", "y"}]}], ")"}]}], 
  RowBox[{"1", "+", 
   RowBox[{"1.976668687136694`*^-12", " ", "y"}]}]]], "Output",
 CellChangeTimes->{3.97912073075716*^9},
 CellLabel->
  "Out[149]=",ExpressionUUID->"226eac2d-efb1-dd4a-97a3-44db501de5a2"]
}, Open  ]],

Cell["\<\
where \[Alpha] varies from 0.95 to 1. It is possible to verify that for \
\[Alpha]=0.975 the rays of different colors intercepting the corrector at 0.7 \
D arrive at the same point on the axis. Finally, if \[Alpha]=0.95 that \
happens to the maarginal rays.\
\>", "Text",
 FontSize->18,ExpressionUUID->"7a6f7780-9ca3-b946-8eae-a78c84b4198b"]
}, Closed]],

Cell[CellGroupData[{

Cell["The program", "Title",
 CellChangeTimes->{{3.43200256534375*^9, 3.43200257171875*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.8941176470588236, 0.8941176470588236, 
   0.8941176470588236],ExpressionUUID->"7b646a77-c2b9-5741-a205-5617d7fed5b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MCamera", "[", 
   RowBox[{
   "f_", ",", "ind_", ",", "diam_", ",", "\[Alpha]_", ",", "waves_", ",", 
    "sf_", ",", "co_", ",", "cr_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\n", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Spherical", " ", "aberration", " ", "of", " ", "the", " ", "mirror"}], 
     " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{"DS1", "=", 
      RowBox[{"-", 
       FractionBox["1", 
        RowBox[{"32", " ", 
         SuperscriptBox["f", "3"]}]]}]}], ";", "\n", "\n", 
     RowBox[{"(*", "Meniscus", "*)"}], "\n", 
     RowBox[{"sost0", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ni", "\[Rule]", 
         RowBox[{"ind", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"\[CapitalDelta]", "\[Rule]", 
         RowBox[{"0.1", "diam"}]}]}], "}"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Difference", " ", "of", " ", "radii", " ", "and", " ", "spherical", 
       " ", "aberration", " ", "and", " ", "coma"}], " ", "*)"}], "\n", 
     RowBox[{"s", "=", " ", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", 
        FractionBox[
         RowBox[{
          SuperscriptBox["Ni", "2"], "-", "1"}], 
         RowBox[{" ", 
          SuperscriptBox["Ni", "2"]}]]}], "//.", "sost0"}]}], ";", "\n", 
     RowBox[{"DC1", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"Ni", "-", "1", " "}], 
         RowBox[{"8", " ", 
          SuperscriptBox["Ni", "2"], " ", 
          SuperscriptBox["r1", "4"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "r1"}], "+", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"Ni", " ", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"r1", "-", "s"}], ")"}], "3"]}]], 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"r1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
                RowBox[{"(", 
                 RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}]}], ")"}], 
             "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Ni", " ", 
               RowBox[{"(", 
                RowBox[{"r1", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
              "\[CapitalDelta]"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"r1", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
               RowBox[{"(", 
                RowBox[{"s", "+", 
                 RowBox[{"Ni", " ", "s"}], "-", 
                 RowBox[{"Ni", " ", "\[CapitalDelta]"}]}], ")"}]}]}], 
             ")"}]}]}]}], ")"}]}], "//.", "sost0"}]}], ";", "\n", "\n", 
     RowBox[{"eq0", "=", 
      RowBox[{
       RowBox[{"Together", "[", 
