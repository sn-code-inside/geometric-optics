          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "3"}], " ", "s"}], "+", 
            RowBox[{"4", " ", "\[CapitalDelta]"}]}], ")"}]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["Ni", "3"], " ", 
       RowBox[{"(", 
        RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["R1", "3"], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["R1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}], "+", 
         RowBox[{"\[CapitalDelta]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             SuperscriptBox["s", "2"]}], "+", 
            RowBox[{"5", " ", "s", " ", "\[CapitalDelta]"}], "-", 
            RowBox[{"3", " ", 
             SuperscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}], "+", 
         RowBox[{"R1", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["s", "2"], "-", 
            RowBox[{"2", " ", 
             SuperscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}]}], ")"}]}], 
      "+", 
      RowBox[{
       SuperscriptBox["Ni", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["R1", "3"], " ", "s"}], "-", 
         RowBox[{"3", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
          SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["R1", "2"], " ", "s", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2"}], " ", "s"}], "+", "\[CapitalDelta]"}], 
           ")"}]}], "+", 
         RowBox[{"R1", " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["s", "3"], "-", 
            RowBox[{
             SuperscriptBox["s", "2"], " ", "\[CapitalDelta]"}], "+", 
            RowBox[{"3", " ", "s", " ", 
             SuperscriptBox["\[CapitalDelta]", "2"]}], "-", 
            RowBox[{"3", " ", 
             SuperscriptBox["\[CapitalDelta]", "3"]}]}], ")"}]}]}], ")"}]}]}],
      ")"}], " ", "\[Theta]"}]}]}]], "Output",
 CellChangeTimes->{{3.432544637515625*^9, 
  3.4325446473125*^9}},ExpressionUUID->"8cf4b1db-914c-cb42-812d-806041fc5dc9"]
}, Open  ]],

Cell[TextData[{
 "where the difference ",
 Cell[BoxData[
  FormBox[
   RowBox[{"s", "=", 
    RowBox[{
     SubscriptBox["R", "1"], "-", 
     SubscriptBox["R", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "ec5a1144-7180-9140-afea-f9006c552d98"],
 " is defined by the relation:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"\[CapitalDelta]", " ", 
      FractionBox[
       RowBox[{
        SuperscriptBox["N", "2"], "-", "1"}], 
       RowBox[{"0.97", 
        SuperscriptBox["N", "2"]}]]}]}], ","}], TraditionalForm]],
  ExpressionUUID->"fb0ac2c8-cc23-0c46-bac8-554508c4986b"],
 "\n\nwhich Maksutov derived by imposing the elimination of axial chromatism \
(see the notebook HCamera(t).nb and Chapter 5).\nIt is convenient to rewrite \
the relations, which approximatively express the absence of spherical \
aberration and coma\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["DM", "1"], "+", 
      SubscriptBox["DS", "1"]}], "=", "0"}], ",", "\n", 
    RowBox[{
     RowBox[{
      SubscriptBox["DM", "2"], "+", 
      SubscriptBox["DS", "2"]}], "=", "0"}], ","}], TraditionalForm]],
  ExpressionUUID->"4c7546d1-337b-1d48-a668-2ecffe34840d"],
 "\n\nin a nondimensional form. To this end, it is sufficient to measure ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "2259e298-60f3-db47-9240-102197ed99e9"],
 " in focal length units ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["f", "1"], " "}], TraditionalForm]],ExpressionUUID->
  "c0593ba5-8400-ac4a-8989-1450af4f85f1"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "d5ae1bc3-5864-9044-8e76-83a438c2c891"],
 " and denote by \[CapitalDelta] the ratio between the thickness of corrector \
and its diameter ",
 Cell[BoxData[
  FormBox["D", TraditionalForm]],ExpressionUUID->
  "9a12d5d4-763d-c64f-b871-6565da9466a3"],
 " . In terms of this quantities, the first of the above relations writes:\n\n\
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       FractionBox[
        RowBox[{"Ni", "-", "1"}], 
        RowBox[{"8", 
         SuperscriptBox["Ni", "2"], 
         SuperscriptBox[
          SubscriptBox["R", "1"], "4"]}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["R", "1"]}], "+", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              SubscriptBox["R", "1"], "+", 
              RowBox[{
               RowBox[{"A", "(", 
                RowBox[{"Ni", "-", "1"}], ")"}], 
               RowBox[{"(", 
                RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}]}]}], ")"}], "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Ni", "(", 
              RowBox[{"Ni", "-", "A\[CapitalDelta]"}], ")"}], "+", 
             "A\[CapitalDelta]"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             SubscriptBox["R", "1"], "+", 
             RowBox[{
              RowBox[{"A", "(", 
               RowBox[{"Ni", "-", "1"}], ")"}], 
              RowBox[{"(", 
               RowBox[{"s", "+", "sNi", "-", "AN"}], ")"}]}]}], ")"}]}], 
          SuperscriptBox[
           RowBox[{"Ni", "(", 
            RowBox[{
             SubscriptBox["R", "1"], "-", "As"}], ")"}], "3"]]}], ")"}]}], 
      "+", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "M"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
          RowBox[{
           SuperscriptBox["M", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], ")"}]}], 
       RowBox[{"32", "  ", 
        SuperscriptBox["M", "3"], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "M"}], ")"}]}]]}], "=", "0"}], ","}], 
   TraditionalForm]],ExpressionUUID->"0b93aa7b-0de1-7b4f-9e29-8a4410547f30"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{"D", "/", "f"}]}], TraditionalForm]],ExpressionUUID->
  "17e62b8c-43d4-604b-94e0-0f9ef084020a"],
 " denotes the speed of the combination. Evaluating the numerator of the \
right hand side and assuming\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"M", "=", "4"}], ",", "   ", 
    RowBox[{"\[Alpha]", "=", "0.4"}], ","}], TraditionalForm]],ExpressionUUID->
  "2444ca64-a05f-1b4a-9200-95747ed8462b"],
 "     ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalDelta]", "=", "0.1"}], ",", "    ", 
    RowBox[{"Ni", "="}]}], TraditionalForm]],ExpressionUUID->
  "9c90ba22-0b01-a345-9ae8-fc1ff46b795e"],
 "1.5187228 (BK7)\n\none has:"
}], "Text",
 CellChangeTimes->{{3.43254466703125*^9, 3.432544760171875*^9}},
 FontSize->18,ExpressionUUID->"a90dc822-508a-8446-8498-b552e8f41285"],

