   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"DM1", "+", "DS1"}], ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f1", "\[Rule]", "1"}], ",", 
        RowBox[{"M", "\[Rule]", "4"}], ",", 
        RowBox[{"\[Alpha]", "\[Rule]", "0.4"}], ",", 
        RowBox[{"\[CapitalDelta]", "\[Rule]", 
         RowBox[{"0.1", "A"}]}], ",", 
        RowBox[{"s", "\[Rule]", 
         RowBox[{"0.1", "A", 
          FractionBox[
           RowBox[{
            SuperscriptBox["Ni", "2"], "-", "1"}], 
           RowBox[{"0.97", 
            SuperscriptBox["Ni", "2"]}]]}]}]}], "}"}]}], ")"}], "/.", 
    RowBox[{"Ni", "\[Rule]", "1.5187228"}]}]}], ";"}], "\n", 
 RowBox[{"eq1", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Numerator", "[", 
      RowBox[{"Together", "[", "sfr", "]"}], "]"}], "//", "N"}], ")"}], 
   "\[Equal]", "0"}]}]}], "Input",ExpressionUUID->"4a7d1201-5405-1944-a650-\
4223dcb91309"],

