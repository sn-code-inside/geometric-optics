      RowBox[{"R1", "-", "s"}], ")"}], "2"], " ", 
    RowBox[{"(", 
     RowBox[{"R1", "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"R1", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "Ni"}], ")"}], " ", 
            RowBox[{"(", 
