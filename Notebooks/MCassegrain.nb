  FormBox[
   RowBox[{"A", "=", "3"}], TraditionalForm]],ExpressionUUID->
  "e14d5c6b-213b-0242-b703-5ef99dbc44ad"],
 ", we respectively have:"
}], "Text",
 FontSize->18,ExpressionUUID->"fdb92c00-d8b1-a946-a982-ce4642db0868"],

