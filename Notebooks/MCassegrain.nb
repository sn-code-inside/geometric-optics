         RowBox[{"s", "-", "\[CapitalDelta]"}], ")"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"R1", "-", "s", "+", "\[CapitalDelta]"}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"R1", "-", "s"}], ")"}], " ", "\[CapitalDelta]", " ", 
       SuperscriptBox[
        RowBox[{"(", 
