Cell[BoxData[
 RowBox[{"-", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"360", " ", 
     SuperscriptBox["Ni", "2"], " ", 
     SuperscriptBox["R1", "2"], " ", 
