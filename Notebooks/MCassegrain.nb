Cell["\<\
In the following program MCassegrain, the negative root is chosen. The \
coefficient \[Mu] among the input parameter varies from 0.5 to 0.8.\
\>", "Text",
 CellChangeTimes->{{3.4325661308125*^9, 3.432566171890625*^9}, {
  3.43256627340625*^9, 3.432566277078125*^9}},
 FontSize->18,ExpressionUUID->"4c7f4de5-163a-2a47-b4ae-137e1dcb921b"]
}, Closed]],

Cell[CellGroupData[{

Cell["The program MCassegrain", "Title",
 CellChangeTimes->{{3.424844837546875*^9, 3.424844841796875*^9}},
 TextAlignment->Center,
 Background->GrayLevel[
  0.752941],ExpressionUUID->"2b3c8600-9382-b64c-8e42-3c7160434dd0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MCassegrain", "[", 
   RowBox[{
   "f_", ",", "ft_", ",", "ind_", ",", "em_", ",", "diam_", ",", "dis_", ",", 
    "angle_", ",", "waves_", ",", "sf_", ",", "cr_"}], "]"}], ":=", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{
      "M", ",", "\[Beta]", ",", "r", ",", "\[Gamma]", ",", "\[CapitalDelta]", 
       ",", "Ni", ",", "s", ",", "rad1", ",", "thick1", ",", "ind", ",", 
       "sol0", ",", "sol1", ",", "sol2", ",", "r1", ",", "R1"}], "*)"}], 
     "}"}], ",", "\n", "\n", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"em", "/", "f"}]}], ";", "\n", 
     RowBox[{"M", "=", 
      RowBox[{"ft", "/", " ", "f"}]}], ";", "\n", 
     RowBox[{"\[Beta]", "=", 
      FractionBox[
       RowBox[{"M", "-", "\[Alpha]"}], 
       RowBox[{"M", "+", "1"}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Gamma]", "=", 
      FractionBox[
       RowBox[{"2", "M", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]]}], ";", "\n", 
     RowBox[{"\[CapitalDelta]", "=", 
      RowBox[{"0.1", "diam"}]}], ";", "\n", 
     RowBox[{"Ni", "=", 
      RowBox[{"ind", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"s", "=", 
      RowBox[{"\[CapitalDelta]", 
       FractionBox[
        RowBox[{
         SuperscriptBox["Ni", "2"], "-", "1"}], 
        RowBox[{"0.97", " ", 
         SuperscriptBox["Ni", "2"]}]]}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Correction", " ", "of", " ", "curvature", " ", "radii", " ", "due", 
       " ", "to", " ", "the", " ", "finite", " ", "focal", " ", "of", " ", 
       "corrector"}], " ", "*)"}], "\[IndentingNewLine]", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R1", ",", 
         RowBox[{"R1", "-", "s"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"sol0", "=", 
      RowBox[{
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Numerator", "[", 
           RowBox[{"Together", "[", 
            RowBox[{"Seidsphe", "[", "1", "]"}], "]"}], "]"}], "\[Equal]", 
          "0"}], ",", "R1"}], "]"}], "//", "Flatten"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol1", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"sol0", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"Length", "[", "sol0", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sol2", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"sol1", ",", "_Real"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r1", "=", 
      RowBox[{"Min", "[", "sol2", "]"}]}], ";", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r1", ",", 
         RowBox[{"r1", "-", "s"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"axcr", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r1", ",", 
         RowBox[{"r1", "-", "s"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"sf51", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co51", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r1", ",", 
         RowBox[{"r1", "-", "s"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "f"}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"margcr1", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"R1", ",", 
         RowBox[{"R1", "-", "s1"}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], "fo1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"sol3", "=", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", 
           RowBox[{
            RowBox[{"-", "sf"}], " ", "sf51"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"zog1", "[", 
             RowBox[{"2", ",", "n"}], "]"}], "-", 
            RowBox[{"zog1", "[", 
             RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", 
           RowBox[{"cr", " ", "axcr"}]}], ",", 
          RowBox[{
           RowBox[{"foc", "[", "1", "]"}], "\[Equal]", "ft"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R1", ",", "r1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s1", ",", "s"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"fo1", ",", "f"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sol3", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"axcr2", "=", 
      RowBox[{
       RowBox[{"zog1", "[", 
        RowBox[{"2", ",", "n"}], "]"}], "-", 
       RowBox[{"zog1", "[", 
        RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", 
     RowBox[{"HOrdAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sol3", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"sf52", "=", "sfer5"}], ";", "\n", 
     RowBox[{"co52", "=", "coma5"}], ";", "\n", 
     RowBox[{"MarginalRayTracing", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sol3", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"-", "2"}], 
          RowBox[{"sol3", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{"\[Gamma]", " ", "f"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalDelta]", ",", "dis", ",", 
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f"}]}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "angle", ",", "waves", ",", 
       "2"}], "]"}], ";", "\n", 
     RowBox[{"margcr2", "=", 
      RowBox[{
       RowBox[{"znu", "[", "2", "]"}], "-", 
       RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Anterior curvature radius of corrector = \>\"", ",", 
       RowBox[{"sol3", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Posterior curvature radius of corrector = \>\"", ",", 
       RowBox[{
        RowBox[{"sol3", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
        RowBox[{"sol3", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance between the corrector and mirror = \>\"", ",", "dis"}], 
      "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<Distance between the primary and secondary mirror = \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"-", "\[Beta]"}], " ", "f"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of the primary mirror = \>\"", ",", 
       RowBox[{
        RowBox[{"-", "2"}], 
        RowBox[{"sol3", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Radius of the secondary mirror = \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"\[Gamma]", " ", "f"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Focal length = \>\"", ",", 
       RowBox[{"foc", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Image height = \>\"", ",", 
       RowBox[{"hobj1", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Obstruction factor = \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"1", "-", "\[Beta]"}], "]"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{"Evaluation", " ", "of", " ", "aberrations"}], " ", "*)"}], 
     "\n", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order spherical aberration = \>\"", ",", 
       RowBox[{"Absftot", "[", "1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fifth-order spherical aberration = \>\"", ",", "sf52"}], 
      "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order coma = \>\"", ",", 
       RowBox[{"Comatot", "[", "1", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Fifth-order coma = \>\"", ",", "co52"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Third-order astigmatism = \>\"", ",", 
       RowBox[{"Asttot", "[", "1", "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Axial chromatism = \>\"", ",", "axcr2"}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Marginal chromatism = \>\"", ",", "margcr2"}], "]"}], 
     ";"}]}], "\n", "\[IndentingNewLine]", "\n", "]"}]}]], "Input",
