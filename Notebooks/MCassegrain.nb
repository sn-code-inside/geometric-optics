Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "=", "700"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ft", "=", "2400"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ind", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1.5187228", ",", "1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
