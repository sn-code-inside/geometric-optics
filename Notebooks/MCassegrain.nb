Cell[CellGroupData[{

Cell["Maksutov Cassegrain", "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.750011],ExpressionUUID->"2049e87d-c923-774d-b01d-30d0f5e17170"],

Cell[TextData[{
 "A Maksutov Cassegrain is formed by a meniscus ",
 Cell[BoxData[
  FormBox[
   RowBox[{"M", " "}], TraditionalForm]],ExpressionUUID->
  "036934e0-ac5d-1f46-94f0-8774c459cdb6"],
 "in front of a Cassegrain combination of two mirrors ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "d872a834-96b1-e74f-ac36-0e78c51a939a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "2"], TraditionalForm]],ExpressionUUID->
  "23befb9e-a807-844a-b24b-37e4f238ca91"],
 ".  \nThe starting data are the same of all Cassegrain schemes, i. e.\n\n\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"f1", " ", "=", " ", 
     RowBox[{"primary", " ", "focal", " ", "lenght"}]}], ";"}], " "}], "\n", 
  RowBox[{
   RowBox[{"ft", " ", "=", " ", 
    RowBox[{"total", " ", "focal", " ", "length"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"em", " ", "=", 
     RowBox[{"back", " ", "distance"}]}], ";"}], 
   "\n"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"From", " ", "them"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "the", " ", "following", " ", "quantities", "  ", "can", " ", "be", " ",
        "determined", 
       RowBox[{"(", 
        RowBox[{"see", " ", "Chapter", " ", "3"}], ")"}]}], ":", 
      "\[IndentingNewLine]", "\n", "\[Alpha]"}], "=", 
     RowBox[{"em", "/", "f1"}]}], ";"}]}], "\n", 
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{"ft", "/", "f1"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Beta]", 
    StyleBox["=",
     FontSize->18], 
    StyleBox[
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]],
     FontSize->18]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"co", "=", 
    RowBox[{"1", "-", "\[Beta]"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Gamma]", 
    StyleBox["=",
     FontSize->18], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"2", " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]],
      FontSize->18], 
     StyleBox[".",
      FontSize->18], 
     StyleBox["\[IndentingNewLine]",
      FontSize->18], "\n", "Then"}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "\[Alpha]", "  ", "and", " ", "M", " ", "are", " ", "taken", " ", "as", 
      " ", "fundamental", "  ", "variables", " ", "and", " ", "the", " ", 
      "following", " ", "quantities", " ", "are", " ", 
      RowBox[{"introduced", ":", "\n", "\n", "R1"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "f1"}], " ", "=", " ", 
      RowBox[{"primary", " ", "radius"}]}]}], ";"}]}], "\n", 
  RowBox[{
   RowBox[{"R2", " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", "f1"}], " ", "=", " ", 
     RowBox[{"secondary", " ", "radius", " ", 
      RowBox[{"(", 
       RowBox[{"\[Gamma]", "<", "0"}], ")"}]}]}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"s12", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", "f1"}], " ", "=", " ", 
     RowBox[{
     "distance", " ", "of", " ", "the", " ", "secondary", " ", "from", " ", 
      "primary", " ", 
      RowBox[{"(", 
       RowBox[{"\[Beta]", ">", "0"}], ")"}]}]}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"K", "  ", "=", " ", 
    RowBox[{"conic", " ", "constant", " ", "of", " ", 
     RowBox[{"secondary", ".", "\n", "\n", "Inserting"}], " ", "these", " ", 
     "quantities", " ", "as", " ", "input", " ", "data", " ", "of", " ", 
     "the", " ", "program", " ", 
     StyleBox["TotalAberrations",
      FontWeight->"Bold"]}]}], 
   StyleBox[",",
    FontWeight->"Bold"], 
   StyleBox[" ",
    FontVariations->{"CompatibilityType"->0}], 
   StyleBox[
    RowBox[{
    "all", " ", "the", " ", "characteristics", " ", "of", " ", "the", " ", 
     "combination", " ", "can", " ", "be", " ", 
     RowBox[{"derived", "."}]}],
    FontVariations->{"CompatibilityType"->0}]}]}],
  PageWidth->WindowWidth,
  TextAlignment->Left,
  TextJustification->1,
  FontFamily->"Times New Roman",
  FontSize->18,
  FontVariations->{"CompatibilityType"->0},ExpressionUUID->
  "2c177729-aaaf-0040-850c-99f1c7f859cb"],
 "\nThe aperture stop ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],ExpressionUUID->
  "aac93825-6361-674d-8e3e-a8d9fe7b599b"],
 " is situated in the corrector position at a distance  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Delta]", " ", "\[ScriptF]"}], TraditionalForm]],ExpressionUUID->
  "fa0969e3-7428-d64c-86ee-838b67691a79"],
 " from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "1"], TraditionalForm]],ExpressionUUID->
  "6e59d41f-8edf-de45-9309-24ea0d55d20c"],
 ". The input data of the Cassegrain combination are:\n"
}], "Text",
 CellChangeTimes->{{3.4325443685625*^9, 3.4325444721875*^9}},
 FontSize->18,ExpressionUUID->"a2fce703-b27d-a848-aa66-b7b2694dbae3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Beta]", "=", 
   FractionBox[
    RowBox[{"M", "-", "\[Alpha]"}], 
    RowBox[{"M", "+", "1"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Gamma]", "=", 
   FractionBox[
    RowBox[{"2", "M", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
    RowBox[{"1", "-", 
     SuperscriptBox["M", "2"]}]]}], ";"}], "\n", 
 RowBox[{"TotalAberrations", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Infinity", ",", "Infinity", ",", 
     RowBox[{
      RowBox[{"-", "2"}], "f1"}], ",", 
     RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"\[Delta]", " ", "f1"}], ",", 
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", "r", ",", "0", 
   ",", "0", ",", 
   RowBox[{"-", "Infinity"}], ",", "y", ",", "\[Theta]", ",", 
   RowBox[{"{", "\[Lambda]", "}"}], ",", "2"}], "]"}], "\n", 
 RowBox[{"DS1", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Absftot", "[", "1", "]"}], "]"}]}], "\n", 
 RowBox[{"DS2", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Comatot", "[", "1", "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.432544479875*^9, 
  3.432544581640625*^9}},ExpressionUUID->"4c5a7945-0105-5346-b06b-\
4984a9af0d6a"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["r", "3"], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
      RowBox[{
       SuperscriptBox["M", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], ")"}]}], 
   RowBox[{"8", " ", 
    SuperscriptBox["f1", "2"], " ", 
    SuperscriptBox["M", "2"]}]]}]], "Output",
 CellChangeTimes->{{3.432544570046875*^9, 
  3.4325445853125*^9}},ExpressionUUID->"6531bdd1-bad2-0f41-8353-1ab58941e8a0"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[Pi]", " ", 
   SuperscriptBox["r", "2"], " ", 
   RowBox[{"(", 
    RowBox[{"M", "+", "\[Alpha]", "-", 
     RowBox[{
      SuperscriptBox["M", "3"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "-", "\[Delta]", "-", 
     RowBox[{"\[Alpha]", " ", "\[Delta]"}], "+", 
     RowBox[{
      SuperscriptBox["M", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[Alpha]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", "\[Delta]"}], 
       ")"}]}]}], ")"}], " ", "\[Theta]"}], 
  RowBox[{"1440", " ", "f1", " ", 
   SuperscriptBox["M", "2"]}]]], "Output",
 CellChangeTimes->{{3.432544570046875*^9, 
  3.432544585375*^9}},ExpressionUUID->"ffa4de44-0425-6e4e-a0bc-e1c39aeab182"]
}, Open  ]],

Cell["Similarly, for the meniscus we have:", "Text",
 FontSize->18,ExpressionUUID->"f3b0c0d2-d452-1243-9129-9009011518f4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TotalAberrations", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"R1", ",", 
      RowBox[{"R1", "-", "s"}]}], "}"}], ",", 
    RowBox[{"{", "\[CapitalDelta]", "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "Ni", ",", "1"}], "}"}], "}"}], ",", 
    RowBox[{"{", 
