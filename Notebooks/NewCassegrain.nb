Cell[BoxData[{
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"Solve", "::", "ratnz"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NSCass", "[", 
   RowBox[{"f1_", ",", "ft_", ",", "em_", ",", "diam_", ",", "\[Theta]_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"\[Alpha]", ",", "M", ",", "\[Beta]", ",", "\[Gamma]"}], "*)"}],
      "}"}], ",", "\n", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"em", "/", "f1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{"ft", "/", "f1"}]}], ";", "\[IndentingNewLine]", " ", 
     RowBox[{"\[Beta]", "=", 
      FractionBox[
       RowBox[{"M", "-", "\[Alpha]"}], 
       RowBox[{"M", "+", "1"}]]}], ";", "\n", 
     RowBox[{"\[Gamma]", "=", 
      FractionBox[
       RowBox[{"2", " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Elimination", " ", "of", " ", "spherical", " ", "aberration"}], ",", 
       " ", "coma", ",", " ", "astigmatism", ",", " ", 
       RowBox[{"and", " ", "chromatism"}]}], "*)"}], "\[IndentingNewLine]", 
     "\n", 
     RowBox[{"ind", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1", ",", "1.518722", ",", "1"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1", ",", "1.522376", ",", "1"}], "}"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1", ",", "1.514322", ",", "1"}], "}"}]}], 
       "}"}]}], ";", "\n", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}], ",", 
         RowBox[{"10", "^", "11"}], ",", "Rc"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}], ",", 
         RowBox[{"\[Beta]", " ", "f1"}], ",", "5"}], "}"}], ",", "ind", ",", 
       RowBox[{"{", 
        RowBox[{"K1", ",", "K2", ",", "0", ",", 
         RowBox[{"{", 
          RowBox[{"a4", ",", "as"}], "}"}]}], "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
       RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Theta]", ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"s3", "=", 
      RowBox[{"Sort", "[", 
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Simplify", "[", 
              RowBox[{"Seidsphe", "[", "1", "]"}], "]"}], "\[Equal]", "0"}], 
            ",", 
            RowBox[{
             RowBox[{"Simplify", "[", 
              RowBox[{"Comatot", "[", "1", "]"}], "]"}], "\[Equal]", "0"}], 
            ",", 
            RowBox[{
             RowBox[{"Simplify", "[", 
              RowBox[{"Seidast", "[", "1", "]"}], "]"}], "\[Equal]", "0"}], 
            ",", 
            RowBox[{
             RowBox[{"Simplify", "[", 
              RowBox[{
               RowBox[{"zog1", "[", 
                RowBox[{"2", ",", "n"}], "]"}], "-", 
               RowBox[{"zog1", "[", 
                RowBox[{"3", ",", "n"}], "]"}]}], "]"}], "\[Equal]", "0"}]}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"a4", ",", "K1", ",", "K2", ",", "Rc"}], "}"}]}], "]"}], "//",
         "Flatten"}], "]"}]}], ";", "\n", "\n", 
     RowBox[{"TotalAberrations", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "f1"}], ",", 
         RowBox[{"\[Gamma]", " ", "f1"}], ",", "Infinity", ",", 
         RowBox[{"s3", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Beta]"}], " ", "f1"}], ",", 
