        RowBox[{"\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3"}], "}"}], 
       ",", "2"}], "]"}], ";", "\n", "\n", 
     RowBox[{"sf3", "=", 
      RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"co3", "=", 
      RowBox[{"Comatot", "[", "1", "]"}]}], ";", "\n", 
     RowBox[{"axcr", "=", 
