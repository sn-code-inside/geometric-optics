       RowBox[{"{", 
        RowBox[{
         RowBox[{"s3", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"s3", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"10", "^", "11"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s3", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}]}], 
        "}"}], ",", 
       RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
