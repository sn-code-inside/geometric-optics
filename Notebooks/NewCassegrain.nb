      RowBox[{"\"\<Primary radius = \>\"", ",", 
       RowBox[{"-", 
        RowBox[{"N", "[", 
         RowBox[{"2", "f1"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Secondary radius = \>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{"\[Gamma]", " ", "f1"}], "]"}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Distance between primary and secondary = \>\"", ",", 
       RowBox[{"-", 
        RowBox[{"N", "[", 
         RowBox[{"\[Beta]", " ", "f1"}], "]"}]}]}], "]"}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{
