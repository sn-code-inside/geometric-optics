Cell[CellGroupData[{

Cell["Houghton-Cassegrain with corrector at the prime focus", "Title",
 CellChangeTimes->{
  3.4601651768125*^9, {3.46016522934375*^9, 3.46016524503125*^9}, {
   3.46016550365625*^9, 3.460165507703125*^9}},
 TextAlignment->Center,
 Background->GrayLevel[
  0.858824],ExpressionUUID->"218fddab-7247-3046-a31e-47cf7af7906f"],

Cell["\<\
ft = total focal;
f1 = primary focal;
em = emersion distance;
diam = diameter of primary;
angle = field semi-angle;
\[Sigma] = fraction of the distance between the secondary mirror and the \
first surface of the corrector ;
dc1=thickness of the first lens of corrector;
dc=distance between the two lenses of corrector;
dc2= thickness of the second lens of corrector;

This program supplies a starting project to which apply an optimization \
program.

\
\>", "Text",
 CellChangeTimes->{{3.46215391553125*^9, 3.462154028703125*^9}, {
  3.46215410446875*^9, 3.46215416971875*^9}, {3.46215421421875*^9, 
  3.46215424903125*^9}, {3.462155088484375*^9, 3.462155089984375*^9}, {
  3.507551620171875*^9, 3.507551642203125*^9}, {3.50762051603125*^9, 
  3.507620555515625*^9}, {3.652066188237817*^9, 3.652066244768897*^9}, {
  3.652066280636947*^9, 3.652066307391985*^9}, {3.652066349840045*^9, 
  3.652066365524067*^9}, {3.6521517043771915`*^9, 3.652151716649209*^9}, {
  3.652152016360632*^9, 3.652152109999764*^9}, {3.6521820865*^9, 
  3.652182112359375*^9}, {3.65218217275*^9, 3.652182174671875*^9}, {
  3.981287561513024*^9, 3.981287588840044*^9}, {3.981288959320949*^9, 
  3.981288968905955*^9}, {3.981289360545923*^9, 3.981289374179119*^9}, {
  3.993713679235485*^9, 3.993713704185587*^9}, {3.993724927460598*^9, 
  3.993724983592615*^9}},
 FontSize->16,ExpressionUUID->"f03eeafe-ae04-fb46-a120-5d72fd396a16"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NCassegrain", "[", 
    RowBox[{
    "ft_", ",", "f1_", ",", "em_", ",", "diam_", ",", "angle_", ",", "waves_",
      ",", "\[Sigma]_", ",", "dc1_", ",", "dc_", ",", "dc2_", ",", "cr_", ",",
      "sf_", ",", "co_", ",", " ", "ast_"}], "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"em", "/", "f1"}]}], ";", "\n", 
      RowBox[{"M", "=", 
       RowBox[{"ft", "/", "f1"}]}], ";", "\n", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"M", "-", "\[Alpha]"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"M", "+", "1"}], ")"}]}]}], ";", "\n", 
      RowBox[{"sd", "=", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], ";", "\n", 
      RowBox[{"oc", "=", 
       RowBox[{"1", "-", "\[Beta]"}]}], ";", "\n", 
      RowBox[{"\[Gamma]", "=", 
       FractionBox[
        RowBox[{"2", " ", "M", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
        RowBox[{"1", "-", 
         SuperscriptBox["M", "2"]}]]}], ";", "\n", 
      RowBox[{"R2", "=", 
       RowBox[{"\[Gamma]", " ", "f1"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"waves", "=", 
        RowBox[{"{", 
         RowBox[{"0.5460", ",", "0.4861", ",", "0.6562"}], "}"}]}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "After", " ", "the", " ", "project", " ", "of", " ", "a", " ", 
         "Cassegrain", " ", "with", " ", "spherical", " ", "mirrors"}], ",", 
        " ", 
        RowBox[{
        "we", " ", "eliminate", " ", "the", " ", "spherical", " ", 
         "aberration", " ", "with", " ", "a", " ", "conic", " ", "primary", 
         " ", "mirror", " ", 
         RowBox[{"(", 
          RowBox[{"Dall", "-", "Kirkham"}], ")"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"K0", "=", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
          RowBox[{
           SuperscriptBox["M", "2"], 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], 
         SuperscriptBox["M", "3"]]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Then", " ", "the", " ", "corrector", " ", "is", " ", "added", " ", 
         "supposing", " ", "that", " ", "the", " ", "thicknesses", " ", "of", 
         " ", "the", " ", "two", " ", "lenses", " ", "and", " ", "their", " ",
          "distance", " ", 
         RowBox[{"vanish", ".", " ", "The"}], " ", "distance", " ", "between",
          " ", "the", " ", "secondary", " ", "mirror", " ", "and", " ", "the",
          " ", "first", " ", "surface", " ", "of", " ", "corrector", " ", 
         "is", " ", "given", " ", "by", " ", "\[Sigma]", "*", "\[Beta]", "*", 
         "f1"}], ",", " ", 
        RowBox[{"\[Sigma]", " ", "\[Element]", 
         RowBox[{
          RowBox[{"[", 
           RowBox[{"0.8", ",", "1"}], "]"}], ".", "\[IndentingNewLine]", 
          "Finally"}]}], ",", " ", 
        RowBox[{
        "we", " ", "start", " ", "with", " ", "the", " ", "curvatures", " ", 
         "of", " ", "the", " ", "surfaces", " ", "of", " ", "corrector", " ", 
         "c11"}], ",", " ", "c12", ",", 
        RowBox[{"-", "c11"}], ",", 
        RowBox[{"-", 
         RowBox[{"c12", ".", " ", "\[IndentingNewLine]", "Then"}]}], ",", " ", 
        RowBox[{
        "the", " ", "different", " ", "aberrations", " ", "of", " ", "this", 
         " ", "combination", " ", "are", " ", "evaluated"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"ind", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "1.5187228", ",", "1", ",", 
           "1.5187228", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "1.522376", ",", "1", ",", 
           "1.522376", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}], ",", "1", ",", "1.514324", ",", "1", ",", 
           "1.514324", ",", "1"}], "}"}]}], "}"}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"OSLO", " ", "data"}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "f1"}], ",", 
          RowBox[{"\[Gamma]", " ", "f1"}], ",", 
          RowBox[{"1", "/", "c11"}], ",", 
          RowBox[{"1", "/", "c12"}], ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "c11"}], ",", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "c12"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Beta]"}], " ", "f1"}], ",", 
          RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "f1"}], ",", "0", ",", "0",
           ",", "0"}], "}"}], ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"K0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
         "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
        "2"}], "]"}], ";", "\n", 
      RowBox[{"eq1", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Together", "[", 
           RowBox[{"Absftot", "[", "1", "]"}], "]"}], "//", "Numerator"}], 
         ",", 
         SuperscriptBox["10", 
          RowBox[{"-", "5"}]]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eq2", "=", 
       RowBox[{
        RowBox[{"Together", "[", 
         RowBox[{"Comatot", "[", "1", "]"}], "]"}], "//", "Numerator"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"s1", "=", 
       RowBox[{"NSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"eq1", "\[Equal]", "0"}], ",", 
           RowBox[{"eq2", "\[Equal]", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c11", ",", "c12"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"s11", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"s1", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"s1", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "s1", "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
      RowBox[{"s12", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"s11", ",", 
         RowBox[{"{", 
          RowBox[{"_Real", ",", "_Real"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s13", "=", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{"s12", ",", 
         RowBox[{"{", 
          RowBox[{"0.", ",", "0."}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tt", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"s13", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j"}], "]"}], "]"}], "2"], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "s13", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pos", "=", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"tt", ",", 
           RowBox[{"Min", "[", "tt", "]"}]}], "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"s14", "=", 
       RowBox[{"s13", "[", 
        RowBox[{"[", "pos", "]"}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Two", " ", "lenses", " ", "close", " ", "to", " ", "the", " ", 
         "primary", " ", "mirror"}], ",", "  ", 
        RowBox[{
        "the", " ", "curvature", " ", "and", " ", "conic", " ", "constant", 
         " ", "of", " ", "primary", " ", "mirror", " ", 
         RowBox[{"(", 
          RowBox[{"6", " ", "parameters"}], ")"}], " ", "are", " ", 
         "determined", " ", "to", " ", "obtain", " ", "the", " ", "focal", 
         " ", "ft", " ", "and", " ", "elimate", " ", "the", " ", "spherical", 
         " ", "aberration"}], ",", " ", "coma", ",", " ", "astigmatism", ",", 
        " ", 
        RowBox[{
        "axial", " ", "chromatism", " ", "and", " ", "the", " ", "emersion", 
         " ", "distance", " ", "em"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", "c0"}], ",", 
          RowBox[{"\[Gamma]", " ", "f1"}], ",", 
          RowBox[{"1", "/", "c11"}], ",", 
          RowBox[{"1", "/", "c12"}], ",", 
          RowBox[{"1", "/", "c13"}], ",", 
          RowBox[{"1", "/", "c14"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Beta]"}], " ", "f1"}], ",", 
          RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "f1"}], ",", "dc1", ",", 
          "dc", ",", "dc2"}], "}"}], ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"K1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
         "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
        "2"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sol2", "=", 
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"foc", "[", "1", "]"}], ")"}], "\[Equal]", "ft"}], ",", 
           RowBox[{
            RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"zog1", "[", 
              RowBox[{"2", ",", "n"}], "]"}], "-", 
             RowBox[{"zog1", "[", 
              RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{"Asttot", "[", "1", "]"}], "\[Equal]", "0"}], ",", 
           RowBox[{
            RowBox[{"zog1", "[", 
             RowBox[{"1", ",", "n"}], "]"}], "\[Equal]", 
            RowBox[{"em", "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"\[Beta]", " ", "f1"}], " ", "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"\[Sigma]", "*", "\[Beta]", "*", "f1"}], "+", "dc1", 
                 "+", "dc", "+", "dc2"}], ")"}]}], ")"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c0", ",", 
           RowBox[{
            RowBox[{"-", "1"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "f1"}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"K1", ",", "K0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c11", ",", 
           RowBox[{"s14", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c12", ",", 
           RowBox[{"s14", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           StyleBox["c13",
            FontColor->GrayLevel[0]], 
           StyleBox[",",
            FontColor->GrayLevel[0]], 
           RowBox[{"-", 
            RowBox[{"s14", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"c14", ",", 
           RowBox[{"-", 
            RowBox[{"s14", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"MaxIterations", "->", "1000"}], ",", 
         RowBox[{"AccuracyGoal", "\[Rule]", "Infinity"}], ",", 
         RowBox[{"PrecisionGoal", "\[Rule]", "8"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"HOrdAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"1", "/", 
           RowBox[{"sol2", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"\[Gamma]", " ", "f1"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"sol2", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"sol2", "[", 
            RowBox[{"[", 
             RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"sol2", "[", 
            RowBox[{"[", 
             RowBox[{"5", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"sol2", "[", 
            RowBox[{"[", 
             RowBox[{"6", ",", "2"}], "]"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Beta]"}], " ", "f1"}], ",", 
          RowBox[{"\[Sigma]", "*", "\[Beta]", " ", "f1"}], ",", "dc1", ",", 
          "dc", ",", "dc2"}], "}"}], ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sol2", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], ",", "0", ",", "0", ",", 
          "0", ",", "0", ",", "0"}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves"}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"sf5", "=", "sfer5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"co5", "=", "coma5"}], ";", "\n", 
      RowBox[{"MarginalRayTracing", "[", 
