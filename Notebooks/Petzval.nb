        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"Sp", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{"ind", "[", 
              RowBox[{"[", 
               RowBox[{"h", ",", 
                RowBox[{"n", "+", "1"}]}], "]"}], "]"}], 
             RowBox[{"rad", "[", 
              RowBox[{"[", "i", "]"}], "]"}]], 
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", 
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"h", ",", 
                  RowBox[{"i", "+", "1"}]}], "]"}], "]"}]], "-", 
              FractionBox["1", 
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"h", ",", "i"}], "]"}], "]"}]]}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{"1", "/", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Sp", "[", 
            RowBox[{"h", ",", "i"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ",", "\n", 
       
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"Curvpar", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"zog1", "[", 
                RowBox[{"h", ",", "n"}], "]"}], "-", 
               RowBox[{"zee1", "[", 
                RowBox[{"h", ",", "n"}], "]"}]}], ")"}], 
             SuperscriptBox[
              RowBox[{"ind", "[", 
               RowBox[{"[", 
                RowBox[{"h", ",", 
                 RowBox[{"n", "+", "1"}]}], "]"}], "]"}], "2"]], 
            FractionBox[
             SuperscriptBox[
              RowBox[{"ind", "[", 
               RowBox[{"[", 
                RowBox[{"h", ",", "1"}], "]"}], "]"}], "2"], 
             RowBox[{"Mae", "[", 
              RowBox[{"h", ",", "n"}], "]"}]], 
            FractionBox[
             RowBox[{"Sp", "[", 
              RowBox[{"h", ",", "i"}], "]"}], "2"], " ", 
            SuperscriptBox[
             RowBox[{"theta", "[", "h", "]"}], "2"], 
            RowBox[{"yee", "[", 
             RowBox[{"h", ",", "1"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{
         RowBox[{"Curvtot", "[", "h", "]"}], "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Curvpar", "[", 
            RowBox[{"h", ",", "i"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ",", "\n", 
       
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", "\n", "\n", 
     "\n", 
     RowBox[{"(*", " ", "Distorsion", " ", "*)"}], "\n", 
     RowBox[{"Do", "[", "\n", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Distpar", "[", 
          RowBox[{"h", ",", "1"}], "]"}], "=", 
         RowBox[{
          FractionBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"zog1", "[", 
              RowBox[{"h", ",", "n"}], "]"}], "-", 
             RowBox[{"zee1", "[", 
              RowBox[{"h", ",", "n"}], "]"}]}], ")"}], 
           RowBox[{"ind", "[", 
            RowBox[{"[", 
             RowBox[{"h", ",", 
              RowBox[{"n", "+", "1"}]}], "]"}], "]"}]], 
          FractionBox["1", 
           RowBox[{"Mae", "[", 
            RowBox[{"h", ",", "n"}], "]"}]], 
          RowBox[{"Cd5", "[", 
           RowBox[{"h", ",", "1"}], "]"}], 
          SuperscriptBox[
           RowBox[{"theta", "[", "h", "]"}], "3"]}]}], ";", "\n", 
        RowBox[{"Do", "[", "\n", 
         RowBox[{
          RowBox[{
           RowBox[{"Distpar", "[", 
            RowBox[{"h", ",", "i"}], "]"}], "=", 
           RowBox[{
            FractionBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"zog1", "[", 
                RowBox[{"h", ",", "n"}], "]"}], "-", 
               RowBox[{"zee1", "[", 
                RowBox[{"h", ",", "n"}], "]"}]}], ")"}], 
             RowBox[{"ind", "[", 
              RowBox[{"[", 
               RowBox[{"h", ",", 
                RowBox[{"n", "+", "1"}]}], "]"}], "]"}]], 
            FractionBox["1", 
             RowBox[{"Mae", "[", 
              RowBox[{"h", ",", "n"}], "]"}]], 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"h", ",", "1"}], "]"}], "]"}], 
               RowBox[{"ind", "[", 
                RowBox[{"[", 
                 RowBox[{"h", ",", "i"}], "]"}], "]"}]], ")"}], "3"], 
            RowBox[{"Cd5", "[", 
             RowBox[{"h", ",", "i"}], "]"}], 
            FractionBox["1", 
             SuperscriptBox[
              RowBox[{"Mae", "[", 
               RowBox[{"h", ",", 
                RowBox[{"i", "-", "1"}]}], "]"}], "2"]], 
            SuperscriptBox[
             RowBox[{"theta", "[", "h", "]"}], "3"]}]}], " ", ",", "\n", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{
         RowBox[{"Disttot", "[", "h", "]"}], " ", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Distpar", "[", 
            RowBox[{"h", ",", "i"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ",", "\n", 
       
       RowBox[{"{", 
        RowBox[{"h", ",", "1", ",", "m"}], "}"}]}], "]"}], ";"}]}], "\n", 
   "\n", "\n", "]"}]}]}], "Input",
