Cell[CellGroupData[{

Cell["Schmidt-Cassegrain Telescope", "Title",
 Background->GrayLevel[
  0.855482],ExpressionUUID->"468b9b97-9153-6541-a44d-a021ec0b11b1"],

Cell[TextData[{
 "The Schmidt-Cassegrain telescope is formed by a Schmidt corrector located \
before a Cassegrain combination. This optical scheme permits to eliminate the \
spherical aberration, coma, and astigmatism. The cromatism, which is \
negligible, can also be controlled.\nThe design starts with the paraxial data \
of the Cassegrain combination (see Chapter 4 and the notebook Cassegrain.nb):\
\n\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"f1", " ", "=", " ", 
     RowBox[{"primary", " ", "focal", " ", "lenght"}]}], ";"}], " "}], "\n", 
  RowBox[{
   RowBox[{"ft", " ", "=", " ", 
    RowBox[{"total", " ", "focal", " ", "length"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"em", " ", "=", 
     RowBox[{"back", " ", "distance"}]}], ";"}], "\n"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
    "and", " ", "it", " ", "supplies", " ", "the", " ", "following", " ", 
     RowBox[{"quantities", ":", "\[IndentingNewLine]", "\n", "\[Alpha]"}]}], 
    "=", 
    RowBox[{"em", "/", "f1"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"M", "=", 
    RowBox[{"ft", "/", "f1"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Beta]", 
    StyleBox["=",
     FontSize->18], 
    StyleBox[
     FractionBox[
      RowBox[{"M", "-", "\[Alpha]"}], 
      RowBox[{"M", "+", "1"}]],
     FontSize->18]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"co", "=", 
    RowBox[{"1", "-", "\[Beta]"}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"\[Gamma]", 
    StyleBox["=",
     FontSize->18], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"2", " ", "M", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
       RowBox[{"1", "-", 
        SuperscriptBox["M", "2"]}]],
      FontSize->18], 
     StyleBox[".",
      FontSize->18], 
     StyleBox["\[IndentingNewLine]",
      FontSize->18], "\n", "Then"}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "\[Alpha]", "  ", "and", " ", "M", " ", "are", " ", "taken", " ", "as", 
      " ", "the", " ", "fundamental", "  ", "variables", " ", "and", " ", 
      "the", " ", "following", " ", "quantities", " ", "are", " ", 
      RowBox[{"introduced", ":", "\n", "\n", "R1"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "f1"}], " ", "=", " ", 
      RowBox[{"primary", " ", "radius"}]}]}], ";"}]}], "\n", 
  RowBox[{
   RowBox[{"R2", " ", "=", " ", 
    RowBox[{
     RowBox[{"\[Gamma]", " ", "f1"}], " ", "=", 
     RowBox[{
      StyleBox[
       RowBox[{
        FractionBox[
         RowBox[{"2", " ", "M", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
         RowBox[{"1", "-", 
          SuperscriptBox["M", "2"]}]], "f1"}],
       FontSize->18], 
      StyleBox["=",
       FontSize->18], " ", 
      RowBox[{"secondary", " ", "radius", " ", 
       RowBox[{"(", 
        RowBox[{"\[Gamma]", "<", "0"}], ")"}]}]}]}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"s12", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Beta]"}], " ", "f1"}], " ", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        StyleBox[
         FractionBox[
          RowBox[{"M", "-", "\[Alpha]"}], 
          RowBox[{"M", "+", "1"}]],
         FontSize->18]}], 
       StyleBox["f1",
        FontSize->18]}], 
      StyleBox["=",
       FontSize->18], " ", 
      RowBox[{
      "distance", " ", "of", " ", "the", " ", "secondary", " ", "from", " ", 
       "primary", " ", 
       RowBox[{"(", 
        RowBox[{"\[Beta]", ">", "0"}], ")"}]}]}]}]}], ";"}], "\n", 
  RowBox[{
   RowBox[{"K1", " ", "=", " ", 
    RowBox[{"conic", " ", "constant", " ", "of", " ", "primary"}]}], 
   ";"}], "\n", 
  RowBox[{"K2", "  ", "=", " ", 
   RowBox[{"conic", " ", "constant", " ", "of", " ", 
    RowBox[{"secondary", "."}]}]}]}],
  PageWidth->WindowWidth,
  TextAlignment->Left,
  TextJustification->1,
  FontFamily->"Times New Roman",
  FontSize->18,
  FontVariations->{"CompatibilityType"->0},ExpressionUUID->
  "9964acaa-f3f7-ba43-8813-db684f74fc95"],
 "\n\nThe program SCassegrain, using the formulae of Chapter 6 and the \
following input data: \n\nft       = total focal length;\nf1      = absolute \
value of primary focal;\nem     = emersion coefficient;\n\[CapitalDelta]      \
 = thickness of corrector;\nind     = refractive indices of corrector for \
different wave-lengths;\ndiam1 = primary diameter;\ndis        = distance of \
the primary from the corrector;\nangle        = field angle;\nwaves = the \
considered wave-lengths ;\nsf = {sfer1,sfer2,sfer3} to balance the spherical \
aberrations in three different situations;\nco = {0,co2,co3} to balance coma \
in the second and third case;\ncr = {cr1,cr2,cr3} to balance the chromatic \
aberrations;\n\ndetermines all the characteristics of the combination."
}], "Text",
 CellChangeTimes->{{3.39468220821875*^9, 3.39468232028125*^9}, {
  3.432306884179594*^9, 3.4323069588827195`*^9}, {3.432520499375*^9, 
  3.432520603921875*^9}, {3.9802069140340233`*^9, 3.9802069158704796`*^9}, {
  3.980208127225973*^9, 3.9802083304911785`*^9}},
 FontSize->18,ExpressionUUID->"733eb1d5-56cc-1c49-99e2-24dc1f5ce28e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Program SCassegrain", "Title",
 Background->RGBColor[
  0.500008, 0.996109, 
   0.996109],ExpressionUUID->"57d5b4b7-c318-2148-bdec-9d2e89b206f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SCassegrain", "[", 
    RowBox[{
    "ft_", ",", "f1_", ",", "em_", ",", "\[CapitalDelta]_", ",", "ind_", ",", 
     "diam_", ",", "dist_", ",", "angle_", ",", "waves_", ",", "sf_", ",", 
     "co_", ",", "cr_"}], "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"fact", "=", "0.866"}], ";", "\n", 
      RowBox[{"\[Delta]", "=", 
       RowBox[{"dist", "/", "f1"}]}], ";", "\n", 
      RowBox[{"Ni", "=", 
       RowBox[{"ind", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"em", "/", "f1"}]}], ";", "\n", 
      RowBox[{"M", "=", 
       RowBox[{"ft", "/", "f1"}]}], ";", "\n", 
      RowBox[{"\[Beta]", "=", 
       FractionBox[
        RowBox[{"M", "-", "\[Alpha]"}], 
        RowBox[{"M", "+", "1"}]]}], ";", "\n", 
      RowBox[{"s12", "=", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], ";", "\n", 
      RowBox[{"cob", "=", 
       RowBox[{"1", "-", "\[Beta]"}]}], ";", "\n", 
      RowBox[{"\[Gamma]", "=", 
       FractionBox[
        RowBox[{"2", " ", "M", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
        RowBox[{"1", "-", 
         SuperscriptBox["M", "2"]}]]}], ";", "\n", 
      RowBox[{"R2", "=", 
       RowBox[{"\[Gamma]", " ", "f1"}]}], ";", "\n", "\n", "\n", 
      RowBox[{"D10", "=", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["M", "3"], "+", "\[Alpha]", "-", 
          RowBox[{
           SuperscriptBox["M", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], 
         RowBox[{"32", " ", 
          SuperscriptBox["f1", "3"], " ", 
          SuperscriptBox["M", "3"]}]]}]}], ";", "\n", 
      RowBox[{"D12", "=", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
        RowBox[{"32", " ", 
         SuperscriptBox["f1", "3"], " ", 
         SuperscriptBox["M", "3"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "M"}], ")"}]}]]}], ";", "\n", 
      RowBox[{"D20", "=", 
       FractionBox[
        RowBox[{"M", "+", "\[Alpha]", "-", 
         RowBox[{
          SuperscriptBox["M", "3"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "-", "\[Delta]", 
         "-", 
         RowBox[{"\[Alpha]", " ", "\[Delta]"}], "+", 
         RowBox[{
          SuperscriptBox["M", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
            "\[Delta]"}], ")"}]}]}], 
        RowBox[{"8", " ", 
         SuperscriptBox["f1", "2"], " ", 
         SuperscriptBox["M", "3"]}]]}], ";", "\n", 
      RowBox[{"D22", "=", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
         RowBox[{"(", 
          RowBox[{"M", "+", 
           RowBox[{"\[Alpha]", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
           "\[Delta]"}], ")"}]}], 
        RowBox[{"8", " ", 
         SuperscriptBox["f1", "2"], " ", 
         SuperscriptBox["M", "3"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "M"}], ")"}]}]]}], ";", "\n", 
      RowBox[{"D30", "=", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"8", " ", "f1", " ", 
          SuperscriptBox["M", "3"], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["M", "4"], "+", 
          RowBox[{"2", " ", "M", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
             "\[Delta]"}], ")"}]}], "-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
             "\[Delta]"}], ")"}], "2"], "+", 
          RowBox[{
           SuperscriptBox["M", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
             "\[Delta]"}], ")"}]}], "-", 
          RowBox[{
           SuperscriptBox["M", "3"], " ", 
           RowBox[{"(", 
            RowBox[{"4", "-", 
             RowBox[{"2", " ", "\[Delta]"}], "+", 
             SuperscriptBox["\[Delta]", "2"], "+", 
             RowBox[{"\[Alpha]", " ", 
              RowBox[{"(", 
               RowBox[{"2", "-", 
                RowBox[{"2", " ", "\[Delta]"}], "+", 
                SuperscriptBox["\[Delta]", "2"]}], ")"}]}]}], ")"}]}]}], 
         ")"}]}]}], ";", "\n", 
      RowBox[{"D32", "=", 
       FractionBox[
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "M"}], ")"}], "3"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"M", "+", 
            RowBox[{"\[Alpha]", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "1"}], "+", "\[Delta]"}], ")"}]}], "+", 
            "\[Delta]"}], ")"}], "2"]}], 
        RowBox[{"8", " ", "f1", " ", 
         SuperscriptBox["M", "3"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "M"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}], ";", "\n", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{
      "Print", "[", 
       "\"\<\!\(\*StyleBox[\"Elimination\",FontSize->16]\)\!\(\*StyleBox[\" \
\",FontSize->16]\)\!\(\*StyleBox[\"of\",FontSize->16]\)\!\(\*StyleBox[\" \
\",FontSize->16]\)\!\(\*StyleBox[\"spherical\",FontSize->16]\)\!\(\*StyleBox[\
\" \",FontSize->16]\)\!\(\*StyleBox[\"aberration\",FontSize->16]\)\!\(\*\
StyleBox[\" \
\",FontSize->16]\)\!\(\*StyleBox[\"with\",FontSize->16]\)\!\(\*StyleBox[\" \
\",FontSize->16]\)\!\(\*StyleBox[\"spherical\",FontSize->16]\)\!\(\*StyleBox[\
\" \",FontSize->16]\)\!\(\*StyleBox[\"mirrors\",FontSize->16]\)\>\"", "]"}], 
      ";", "\n", 
      RowBox[{"a41", "=", 
       RowBox[{"-", 
        FractionBox["D10", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "Ni"}]]}]}], ";", "\n", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", "11"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f1"}], ",", 
          RowBox[{"\[Gamma]", " ", "f1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[CapitalDelta]", ",", 
          RowBox[{"\[Delta]", " ", "f1"}], ",", 
          RowBox[{
           RowBox[{"-", "\[Beta]"}], " ", "f1"}]}], "}"}], ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"a41", ",", "as"}], "}"}], ",", "0", ",", "0"}], "}"}], 
        ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "y", ",", "angle", ",", "waves", ",", 
        "2"}], "]"}], ";", "\n", "\n", 
      RowBox[{"HOrdAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", "11"}]}], ",", 
