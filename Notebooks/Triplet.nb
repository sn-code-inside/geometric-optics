Cell["Third-order design of a triplet", "Title",
 CellChangeTimes->{
  3.415509626632677*^9, {3.415509686304552*^9, 3.415509701210802*^9}, {
   3.42505825890625*^9, 3.4250582603125*^9}, {3.425058830515625*^9, 
   3.425058832328125*^9}},
 TextAlignment->Center,
 Background->RGBColor[
  0.7803921568627451, 0.7803921568627451, 
   0.7803921568627451],ExpressionUUID->"f94c9e51-f8e0-9548-b707-db398909b50f"],

Cell["\<\
We consider  a triplet of thin lenses in which the last two lenses are \
cemented . Then, to determine the radii of the five surfaces, we impose the \
following 5 conditions:
- focale length,
-the back focals bfb and bfg, respectively corresponding to blue and green \
light, coincide,
-the back focals bfr and bfg, respectively corresponding to red and green \
light, coincide,
-the spherical aberration vanishes,
-coma vanishes.\
\>", "Text",
 CellChangeTimes->{{3.415509791023302*^9, 3.415509809867052*^9}, {
   3.415509854226427*^9, 3.415509947132677*^9}, 3.424965866171875*^9, {
   3.42496614171875*^9, 3.424966174296875*^9}, {3.42505826603125*^9, 
   3.425058269859375*^9}, {3.42505830115625*^9, 3.425058406890625*^9}, {
   3.425058440515625*^9, 3.42505856753125*^9}, 3.426323961765625*^9, {
   3.426326613265625*^9, 3.4263266156875*^9}, {3.426401870046875*^9, 
   3.426401892265625*^9}, 3.4327073496875*^9},
 FontFamily->"Times New Roman",
 FontSize->18,ExpressionUUID->"4f3baf7a-591f-0e46-881a-b7dde7f6a2bc"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ind", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "N1", ",", "1", ",", "N2", ",", "N3", ",", "1"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "N1b", ",", "1", ",", "N2b", ",", "N3b", ",", "1"}],
         "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "N1r", ",", "1", ",", "N2r", ",", "N3r", ",", "1"}],
         "}"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"waves", "=", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]", ",", "\[Lambda]b", ",", "\[Lambda]r"}], "}"}]}], 
    ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"TotalAberrations", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "c1"}], ",", " ", 
        RowBox[{"1", "/", "c2"}], ",", " ", 
        RowBox[{"1", "/", "c3"}], ",", " ", 
        RowBox[{"1", "/", "c4"}], ",", 
        RowBox[{"1", "/", "c5"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", "0"}], "}"}], ",", " ",
       "ind", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ",
       "r", ",", " ", "0", ",", " ", "0", ",", " ", 
      RowBox[{"-", "Infinity"}], ",", " ", "y1", ",", "\[Theta]", ",", " ", 
      "waves", ",", " ", "2"}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.415509986835802*^9, 3.415510105648302*^9}, {
  3.424966202640625*^9, 3.424966214109375*^9}, {3.42505859071875*^9, 
