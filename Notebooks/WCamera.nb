Cell[CellGroupData[{

Cell["Wright's Camera", "Title",
 TextAlignment->Center,
 Background->GrayLevel[
  0.750011],ExpressionUUID->"fc7e2c27-13cc-3c40-a168-c8ddf4b2df95"],

Cell[TextData[StyleBox["The program WCamera allows to design a Wright camera.\
\nThe input data are:\n \nf     = focal of mirror;\nind   = refractive \
indices of corrector;\nthick = thickness of corrector;\ndiam  = diameter of \
corrector;\n\[Delta]     = distance between corrector and mirror expressed as \
fraction of focal\n\[Alpha]     = field angle;\nsf     = factor to balance \
spherical aberrations \[Beta] in (0.8,1.3}.\n",
 FontSize->16]], "Input",
 CellChangeTimes->{{3.43194637703125*^9, 3.431946464578125*^9}, {
  3.980038286728794*^9, 3.98003834192362*^9}, {3.980129447729813*^9, 
  3.980129448217615*^9}, {3.980129537729948*^9, 3.980129540586815*^9}, {
  3.9933762335897274`*^9, 
  3.993376257694975*^9}},ExpressionUUID->"9f426bd9-936d-5846-ab6e-\
89fe2e37188a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"WCamera", "[", 
    RowBox[{
    "f_", ",", "thick_", ",", "ind_", ",", "diam_", ",", "\[Alpha]_", ",", 
     "waves_", ",", "sf_"}], "]"}], ":=", "\n", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"\[Delta]", "=", 
       RowBox[{
        RowBox[{"thick", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "/", "f"}]}], ";", "\n", 
      RowBox[{"a40", "=", 
       FractionBox["1", 
        RowBox[{"16", " ", 
         SuperscriptBox["f", "3"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"ind", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}], " ", 
         "\[Delta]"}]]}], ";", "\n", 
      RowBox[{"K0", "=", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        FractionBox["2", "\[Delta]"]}]}], ";", "\n", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", "11"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"a40", ",", "as"}], "}"}], ",", "K0"}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"aa", "=", 
       RowBox[{
        RowBox[{"zog1", "[", 
         RowBox[{"2", ",", "n"}], "]"}], "-", 
        RowBox[{"zog1", "[", 
         RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", 
      RowBox[{"HOrdAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", "11"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"a40", ",", "as"}], "}"}], ",", "K0"}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"sf5", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"sosf", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], 
          RowBox[{"x", "^", "5"}]}], ")"}], "/.", 
        RowBox[{"x", "\[Rule]", 
         RowBox[{"diame", "[", "1", "]"}]}]}]}], ";", "\n", 
      RowBox[{"co5", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sco", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", "fact", " ", 
         SuperscriptBox["x", "4"], "\[Theta]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "\[Rule]", 
           RowBox[{"diame", "[", "1", "]"}]}], ",", 
          RowBox[{"\[Theta]", "\[Rule]", 
           RowBox[{"\[Alpha]", 
            FractionBox["\[Pi]", "180"]}]}]}], "}"}]}]}], ";", "\n", 
      RowBox[{"MarginalRayTracing", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"-", 
           RowBox[{"10", "^", "11"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"a40", ",", "as"}], "}"}], ",", "K0"}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"margcr", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"znu", "[", "2", "]"}], "-", 
         RowBox[{"znu", "[", "3", "]"}]}], ")"}]}], ";", "\n", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"1", "/", "c"}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"a4", ",", "as"}], "}"}], ",", "K"}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", "\n", 
      RowBox[{"solf", "=", 
       RowBox[{
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Absftot", "[", "1", "]"}], "\[Equal]", 
             RowBox[{
              RowBox[{"-", "sf"}], " ", "sf5"}]}], ",", 
            RowBox[{
             RowBox[{"Comatot", "[", "1", "]"}], "\[Equal]", 
             RowBox[{"-", "co5"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"zog1", "[", 
               RowBox[{"2", ",", "n"}], "]"}], "-", 
              RowBox[{"zog1", "[", 
               RowBox[{"3", ",", "n"}], "]"}]}], "\[Equal]", 
             RowBox[{
              RowBox[{"-", "0.9"}], "margcr"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"a4", ",", "a40"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"K", ",", "K0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"c", ",", 
            RowBox[{"-", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}]}], "}"}]}], "]"}], "//", "Flatten"}]}], 
      ";", "\n", 
      RowBox[{"TotalAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"solf", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"solf", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
          RowBox[{"solf", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"sf3", "=", 
       RowBox[{"Absftot", "[", "1", "]"}]}], ";", "\n", 
      RowBox[{"co3", "=", 
       RowBox[{"Comatot", "[", "1", "]"}]}], ";", "\n", 
      RowBox[{"crax", "=", 
       RowBox[{
        RowBox[{"zog1", "[", 
         RowBox[{"2", ",", "n"}], "]"}], "-", 
        RowBox[{"zog1", "[", 
         RowBox[{"3", ",", "n"}], "]"}]}]}], ";", "\n", "\n", 
      RowBox[{"HOrdAberrations", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"solf", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"solf", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
          RowBox[{"solf", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"sf5f", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"sosf", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], 
          RowBox[{"x", "^", "5"}]}], ")"}], "/.", 
        RowBox[{"x", "\[Rule]", 
         RowBox[{"diame", "[", "1", "]"}]}]}]}], ";", "\n", 
      RowBox[{"co5f", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sco", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}], " ", "fact", " ", 
         SuperscriptBox["x", "4"], "\[Theta]"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "\[Rule]", 
           RowBox[{"diame", "[", "1", "]"}]}], ",", 
          RowBox[{"\[Theta]", "\[Rule]", 
           RowBox[{"\[Alpha]", 
            FractionBox["\[Pi]", "180"]}]}]}], "}"}]}]}], ";", "\n", "\n", 
      RowBox[{"MarginalRayTracing", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "11"}], ",", 
          RowBox[{"1", "/", 
           RowBox[{"solf", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"-", "2"}], "f"}]}], "}"}], ",", "thick", ",", "ind", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"solf", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", "as"}], "}"}], ",", 
          RowBox[{"solf", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"diam", "/", "2"}], ",", "0", ",", "0", ",", 
        RowBox[{"-", "Infinity"}], ",", "x", ",", "\[Alpha]", ",", "waves", 
        ",", "2"}], "]"}], ";", "\n", 
      RowBox[{"crm", "=", " ", 
       RowBox[{
        RowBox[{"znu", "[", "2", "]"}], "-", 
        RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", 
      RowBox[{"crm", "=", " ", 
       RowBox[{
        RowBox[{"znu", "[", "2", "]"}], "-", 
        RowBox[{"znu", "[", "3", "]"}]}]}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Corrector curvature = \>\"", ",", 
        RowBox[{"1", "/", 
         RowBox[{"solf", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", "2"}], "]"}], "]"}]}]}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Aspheric constant of corrector = \>\"", ",", 
        RowBox[{"solf", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Conic constant of mirror = \>\"", ",", 
        RowBox[{"solf", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Third-order spherical aberration = \>\"", ",", "sf3"}], 
       "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fifth-order spherical aberration = \>\"", ",", "sf5f"}], 
       "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Third-order coma = \>\"", ",", "co3"}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Fifth-order coma = \>\"", ",", "co5f"}], "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Focal difference on the axis = \>\"", ",", "crax"}], 
       "]"}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Focal difference of marginal rays = \>\"", ",", "crm"}], 
       "]"}], ";"}]}], "\n", "\n", "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.431946352875*^9, 3.431946365625*^9}, {
   3.4319464760625*^9, 3.43194674384375*^9}, {3.431946860359375*^9, 
   3.4319468881875*^9}, {3.431947055875*^9, 3.431947057390625*^9}, {
   3.431947160171875*^9, 3.4319471691875*^9}, {3.431947244265625*^9, 
   3.431947368890625*^9}, {3.431947529046875*^9, 3.43194765009375*^9}, {
   3.431947702859375*^9, 3.43194781225*^9}, {3.431947852921875*^9, 
   3.43194788675*^9}, {3.4319480339375*^9, 3.4319480590625*^9}, {
