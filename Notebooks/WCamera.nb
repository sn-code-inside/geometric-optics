   3.43019468746875*^9}, 3.430197097515625*^9, {3.430197454765625*^9, 
   3.430197465015625*^9}, {3.43019751646875*^9, 3.430197549625*^9}, {
   3.430197776296875*^9, 3.43019784115625*^9}, {3.43019788428125*^9, 
   3.430197901578125*^9}, {3.431750167875*^9, 3.431750173375*^9}, {
   3.431750471359375*^9, 3.431750560828125*^9}, {3.431750717921875*^9, 
   3.4317508393125*^9}, {3.431750871171875*^9, 3.43175087178125*^9}, 
   3.431750993*^9, {3.4317511371875*^9, 3.43175120696875*^9}, {
   3.431751316484375*^9, 3.43175133396875*^9}, {3.431751531703125*^9, 
   3.4317516195*^9}, {3.431751668671875*^9, 3.431751721484375*^9}, {
   3.431751871921875*^9, 3.431751883421875*^9}, {3.431751998203125*^9, 
   3.43175204390625*^9}, {3.43175242053125*^9, 3.431752425546875*^9}, {
   3.43175286775*^9, 3.43175287378125*^9}, 3.431753146171875*^9, {
   3.431753180203125*^9, 3.431753201875*^9}, {3.431753514234375*^9, 
   3.431753526625*^9}, {3.431753929140625*^9, 3.431753932640625*^9}, {
   3.4317544224375*^9, 3.431754534*^9}, {3.431754566796875*^9, 
   3.43175475490625*^9}, {3.431754809765625*^9, 3.431754911984375*^9}, {
   3.4317549981875*^9, 3.431755003109375*^9}, {3.4317585675625*^9, 
   3.431758680484375*^9}, {3.431758793984375*^9, 3.4317588016875*^9}, 
   3.431758839890625*^9, 3.431758899640625*^9, {3.431758987859375*^9, 
   3.431759000015625*^9}, {3.43175938396875*^9, 3.431759465890625*^9}, {
   3.4317596253125*^9, 3.43175964071875*^9}, {3.431759672359375*^9, 
   3.431759819203125*^9}, {3.431759857703125*^9, 3.43175994184375*^9}, {
   3.431759989*^9, 3.431760384015625*^9}, {3.431760513*^9, 
   3.431760545234375*^9}, 3.431768373015625*^9, {3.431768411203125*^9, 
   3.43176848459375*^9}, {3.4317685815*^9, 3.431768695015625*^9}, {
   3.431768870453125*^9, 3.43176887609375*^9}, {3.431768945953125*^9, 
